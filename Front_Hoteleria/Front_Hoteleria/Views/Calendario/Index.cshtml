@{
    ViewBag.Title = "Calendario Maestro de Ocupación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.css" />

<style>
    .right_col {
        background: #f4f6f9;
        min-height: calc(100vh - 70px);
    }

    .page-title .title_left h3 {
        font-size: 28px;
        font-weight: 500;
        color: #365d82;
        margin-top: 5px;
        display: inline-block;
    }

    .page-title small {
        color: #6b7280;
        margin-left: 8px;
        font-size: 14px;
    }
</style>

<div class="right_col" role="main">
    <div class="">
        <div class="page-title">
            <div class="title_left">
                <h3>Calendario Maestro de Ocupación <small>Control de Sanitización y Mantenimiento</small></h3>
            </div>
            <div class="title_right">
                <div class="col-md-5 col-sm-5 col-xs-12 form-group pull-right top_search">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Buscar habitación o evento..." id="cal-txt-buscar">
                        <span class="input-group-btn">
                            <button class="btn btn-default" type="button" id="cal-btn-buscar">Go!</button>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>

        <div id="contenedor-dashboard"></div>

        <div id="contenedor-tabla" style="margin-top:20px;"></div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/locales/es.min.js"></script>

    <script>
        $(function () {

            cargarDashboard();
            cargarTabla();

            function cargarDashboard() {
                $.get('@Url.Action("Resumen","Calendario")', function (html) {
                    $('#contenedor-dashboard').html(html);
                });
            }

            function cargarTabla(habitacion, estado) {
                $.get('@Url.Action("Tabla","Calendario")', { habitacion: habitacion, estado: estado }, function (html) {
                    $('#contenedor-tabla').html(html);

                    // al terminar de cargar el parcial, si existe la función de render, la ejecutamos
                    if (window.renderCalendarioMaster) {
                        window.renderCalendarioMaster();
                    }
                });
            }

            // delegación para los botones del dashboard
            // nuevo evento
            $(document).on('click', '#cal-btn-nuevo', function () {
                $.get('@Url.Action("Upsert","Calendario")', function (html) {
                    $('#modalCalendarioContent').html(html);
                    $('#modalCalendario').modal('show');
                });
            });
            $(document).on('click', '#cal-btn-mant', function () {
                $.get('@Url.Action("ProgramarMantenimiento","Calendario")', function (html) {
                    $('#modalCalendarioContent').html(html);
                    $('#modalCalendario').modal('show');
                });
            });

            // bloquear habitación (es lo mismo que upsert, pero le ponemos tipo blocked)
                   $(document).on('click', '#cal-btn-bloquear', function () {
            $.get('@Url.Action("Bloquear","Calendario")', function (html) {
                $('#modalCalendarioContent').html(html);
                $('#modalCalendario').modal('show');
            });
        });


           

            // programar sanitización
            $(document).on('click', '#cal-btn-sanit', function () {
                $.get('@Url.Action("Upsert","Calendario")', { tipo: 'sanitization' }, function (html) {
                    $('#modalCalendarioContent').html(html);
                    $('#modalCalendario').modal('show');
                });
            });

            // filtros
            $(document).on('click', '#cal-fil-aplicar', function () {
                var h = $('#cal-fil-habitacion').val();
                var e = $('#cal-fil-estado').val();
                cargarTabla(h, e);
            });

            $(document).on('click', '#cal-fil-limpiar', function () {
                $('#cal-fil-habitacion').val('');
                $('#cal-fil-estado').val('');
                cargarTabla();
            });

            // buscar arriba
            $('#cal-btn-buscar').on('click', function () {
                // por ahora solo recarga
                cargarTabla();
            });

            // función global para cuando se hace click en un evento del calendario
            window.editarCalendarioEvento = function (id) {
                $.get('@Url.Action("Upsert","Calendario")', { id: id }, function (html) {
                    $('#modalCalendarioContent').html(html);
                    $('#modalCalendario').modal('show');
                });
            };

        });
    </script>

    <!-- modal global -->
    <div class="modal fade" id="modalCalendario" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" id="modalCalendarioContent">
            </div>
        </div>
    </div>
}
