@model Front_Hoteleria.Dto.Calendario.CalendarioBloqueoDto
@{
    Layout = null;
    var habitaciones = ViewBag.Habitaciones as List<string> ?? new List<string>();
}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h4 class="modal-title">Bloquear Habitación</h4>
</div>
<div class="modal-body">
    <form id="frmBloquearHab" autocomplete="off">
        <div class="form-group">
            <label>Habitación *</label>
            <select name="HabitacionId" class="form-control" required>
                <option value="">Seleccionar habitación...</option>
                @foreach (var h in habitaciones)
                {
                    <option value="@h" @(Model.HabitacionId == h ? "selected" : "")>@h</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Fecha de Inicio *</label>
            <input type="date"
                   name="FechaInicio"
                   class="form-control"
                   value="@(Model.FechaInicio.HasValue ? Model.FechaInicio.Value.ToString("yyyy-MM-dd") : "")"
                   required />
        </div>

        <div class="form-group">
            <label>Fecha de Fin *</label>
            <input type="date"
                   name="FechaFin"
                   class="form-control"
                   value="@(Model.FechaFin.HasValue ? Model.FechaFin.Value.ToString("yyyy-MM-dd") : "")"
                   required />
        </div>

        <div class="form-group">
            <label>Motivo del Bloqueo *</label>
            <textarea name="Motivo" class="form-control" rows="3" required placeholder="Motivo del bloqueo...">@Model.Motivo</textarea>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
    <button type="button" class="btn btn-danger" id="btnBloquearHabitacion">Bloquear Habitación</button>
</div>

<script>
    $('#btnBloquearHabitacion').off('click').on('click', function () {
        $.post('@Url.Action("Bloquear","Calendario")', $('#frmBloquearHab').serialize(), function (r) {
            if (r.ok) {
                $('#modalCalendario').modal('hide');

                // recargar la tabla/calendario
                $.get('@Url.Action("Tabla","Calendario")', function (html) {
                    $('#contenedor-tabla').html(html);
                    if (window.renderCalendarioMaster) window.renderCalendarioMaster();
                });
            } else {
                alert(r.msg || 'No se pudo bloquear la habitación.');
            }
        }).fail(function () {
            alert('Error al bloquear la habitación.');
        });
    });
</script>
