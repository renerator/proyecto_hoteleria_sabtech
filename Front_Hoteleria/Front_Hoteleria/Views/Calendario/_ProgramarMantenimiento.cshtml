@model Front_Hoteleria.Dto.Calendario.CalendarioMantenimientoDto
@{
    Layout = null;
    var habitaciones = ViewBag.Habitaciones as List<string> ?? new List<string>();

    var fechaInicioStr = (Model.FechaInicio ?? DateTime.Today).ToString("yyyy-MM-dd");
    var dias = Model.DuracionDias > 0 ? Model.DuracionDias : 1;
}

<style>
    /* solo mientras este modal esté abierto */
    #modalCalendario .cal-mant-modal .modal-body {
        padding: 15px 18px 5px 18px;
    }

    #modalCalendario .cal-mant-modal .form-group {
        margin-bottom: 12px;
    }
</style>

<div class="cal-mant-modal">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title">Programar Mantenimiento</h4>
    </div>
    <div class="modal-body">
        <form id="frmMantenimiento" autocomplete="off">
            <div class="form-group">
                <label>Habitación *</label>
                <select name="HabitacionId" class="form-control" required>
                    <option value="">Seleccionar habitación...</option>
                    @foreach (var h in habitaciones)
                    {
                        <option value="@h" @(Model.HabitacionId == h ? "selected" : "")>@h</option>
                    }
                </select>
            </div>

            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Fecha de Inicio *</label>
                        <input type="date"
                               name="FechaInicio"
                               class="form-control"
                               value="@fechaInicioStr"
                               required />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Duración (días) *</label>
                        <input type="number"
                               name="DuracionDias"
                               class="form-control"
                               min="1"
                               value="@dias"
                               required />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Tipo de Mantenimiento *</label>
                <select name="Tipo" class="form-control" required>
                    <option value="">Seleccionar...</option>
                    <option value="preventive" @(Model.Tipo == "preventive" ? "selected" : "")>Preventivo</option>
                    <option value="corrective" @(Model.Tipo == "corrective" ? "selected" : "")>Correctivo</option>
                    <option value="emergency" @(Model.Tipo == "emergency" ? "selected" : "")>Emergencia</option>
                    <option value="upgrade" @(Model.Tipo == "upgrade" ? "selected" : "")>Mejora / Upgrade</option>
                </select>
            </div>

            <div class="form-group">
                <label>Descripción del Trabajo</label>
                <textarea name="Descripcion"
                          class="form-control"
                          rows="3"
                          placeholder="Descripción del mantenimiento a realizar...">@Model.Descripcion</textarea>
            </div>
        </form>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-warning" id="btnGuardarMantenimiento" style="color:#fff;">
            Programar Mantenimiento
        </button>
    </div>
</div>

<script>
    // ⚠️ tu modal global tiene "modal-lg", lo achicamos aquí
    $('#modalCalendario .modal-dialog')
        .removeClass('modal-lg')
        .css({
            'width': '540px',
            'max-width': '95%'
        });

    $('#btnGuardarMantenimiento').off('click').on('click', function () {
        $.post('@Url.Action("ProgramarMantenimiento","Calendario")',
            $('#frmMantenimiento').serialize(),
            function (r) {
                if (r.ok) {
                    $('#modalCalendario').modal('hide');

                    $.get('@Url.Action("Tabla","Calendario")', function (html) {
                        $('#contenedor-tabla').html(html);
                        if (window.renderCalendarioMaster) window.renderCalendarioMaster();
                    });
                } else {
                    alert(r.msg || 'No se pudo programar el mantenimiento.');
                }
            }
        ).fail(function (xhr) {
            alert('Error al programar el mantenimiento: ' + xhr.status);
        });
    });
</script>
