
@model Front_Hoteleria.Dto.Reserva.ReservaTrabajadorDto
@using System.Web.Mvc

@{
    // Catálogos desde el GET Upsert()
    var habitaciones = ViewBag.Habitaciones as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var tipos = ViewBag.TiposReserva as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var idTrabajador = (ViewBag.IdTrabajador as int?) ?? 0;

    // Defaults SOLO para la UI (sin tocar Dto)
    var fechaDesde = Model?.FechaDesde ?? DateTime.Today;
    var fechaHasta = Model?.FechaHasta ?? DateTime.Today.AddDays(1);
    var fechaDesdeStr = fechaDesde.ToString("yyyy-MM-dd");
    var fechaHastaStr = fechaHasta.ToString("yyyy-MM-dd");

    // 1 = Ingresada si viene vacío/0
    var idEstadoEfectivo = (Model?.IdEstadoReserva ?? 0) == 0 ? 1 : Model.IdEstadoReserva;
}

@using (Html.BeginForm("CrearReserva", "Reservas", FormMethod.Post,
                      new { id = "formCrearReserva", @class = "form-horizontal", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()

    <input type="hidden" name="IdEstadoReserva" value="@idEstadoEfectivo" />
    <input type="hidden" name="IdTrabajador" value="@idTrabajador" />

    <div class="row">

        <div class="col-sm-6">
            <div class="form-group">
                <label>Rut *</label>
                @Html.TextBoxFor(m => m.dniTrabajador, new { @class = "form-control", required = "required", placeholder = "Rut" })
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label>Nombre *</label>
                @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control", required = "required", placeholder = "Nombre" })
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label>Telefono *</label>
                @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", required = "required", placeholder = "Telefono" })
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label>Email *</label>
                @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", required = "required", placeholder = "Email" })
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label>Apellido *</label>
                @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control", required = "required", placeholder = "Apellido" })
            </div>
        </div>

        <div class="col-sm-6">
            <div class="form-group">
                <label>Habitación *</label>
                @Html.DropDownListFor(m => m.IdHabitacion,
                    Enumerable.Empty<SelectListItem>(),
                    "Seleccionar habitación...",
                    new { @class = "form-control", required = "required", id = "ddlHabitaciones" })
            </div>
        </div>

        <div class="col-sm-6">
            <div class="form-group">
                <label>Tipo Habitación *</label>
                @Html.DropDownListFor(m => m.IdTipoHabitacion,
                    Enumerable.Empty<SelectListItem>(),
                    "Seleccionar Tipo habitación...",
                    new { @class = "form-control", required = "required", id = "ddlTipoHabitaciones" })
            </div>
        </div>

        <div class="col-sm-6">
            <div class="form-group">
                <label>Fecha Check In *</label>
                <input class="form-control" type="date" name="FechaDesde" value="@fechaDesdeStr" required />
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label>Fecha Check Out *</label>
                <input class="form-control" type="date" name="FechaHasta" value="@fechaHastaStr" required />
            </div>
        </div>

        <div class="col-sm-6">
            <div class="form-group">
                <label>Monto Total *</label>
                @Html.TextBoxFor(m => m.Totales, new { @class = "form-control", type = "number", min = "0", step = "1", required = "required" })
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label>Solicitudes Especiales</label>
                @Html.TextAreaFor(m => m.MotivoReserva, 3, 40, new { @class = "form-control", placeholder = "Cama extra, cuna, etc." })
            </div>
        </div>
    </div>

    <div class="text-right">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-success">Crear Reserva</button>
    </div>
}
<script>
$(document).ready(function () {
    // Llama al endpoint al abrir el modal
    cargarHabitaciones();
    cargarTipoHabitaciones();
    function cargarHabitaciones() {
        $.ajax({
            url: '@Url.Action("HabitacionesCombo", "Reservas")',
            type: 'GET',
            dataType: 'json',
            success: function (res) {
                if (res.ok && res.data) {
                    const ddl = $('#ddlHabitaciones');
                    ddl.empty();
                    ddl.append('<option value="">Seleccionar habitación...</option>');
                    $.each(res.data, function (i, item) {
                        ddl.append(`<option value="${item.id}">${item.text}</option>`);
                    });
                } else {
                    console.warn('No se encontraron habitaciones.');
                }
            },
            error: function (xhr) {
                console.error('Error cargando habitaciones:', xhr.responseText);
            }
        });
    }

     function cargarTipoHabitaciones() {
        $.ajax({
            url: '@Url.Action("TipoHabitacionesCombo", "Reservas")',
            type: 'GET',
            dataType: 'json',
            success: function (res) {
                if (res.ok && res.data) {
                    const ddl = $('#ddlTipoHabitaciones');
                    ddl.empty();
                    ddl.append('<option value="">Seleccionar Tipo habitación...</option>');
                    $.each(res.data, function (i, item) {
                        ddl.append(`<option value="${item.id}">${item.text}</option>`);
                    });
                } else {
                    console.warn('No se encontraron Tipohabitaciones.');
                }
            },
            error: function (xhr) {
                console.error('Error cargando tipo habitaciones:', xhr.responseText);
            }
        });
 }
});
</script>
