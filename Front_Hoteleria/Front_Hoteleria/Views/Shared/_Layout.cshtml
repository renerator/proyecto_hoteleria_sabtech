@{
    var token = Session["Token"] as string;
    var isLogged = !string.IsNullOrEmpty(token);
}
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Mi aplicación ASP.NET</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="nav-md @(isLogged ? "" : "auth-only")">
    <!-- jQuery (si tu bundle ya lo trae, elimina esta línea) -->
    <script src="~/vendors/jquery/dist/jquery.min.js"></script>

    <!-- Otros scripts globales -->
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/highcharts-3d.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>

    <!-- Contenedor principal: oculto si NO hay login -->
    <div class="container body @(isLogged ? "" : "d-none")">
        <div class="main_container">
            @if (isLogged)
            {
                <div class="col-md-3 left_col">
                    <div class="left_col scroll-view">

                        <!-- Título del sitio (arriba de la barra lateral) -->
                        <div class="navbar nav_title" style="border:0;">
                            <a href="@Url.Action("Index","Home")" class="site_title">
                                <i class="fa fa-building"></i> <span>Hoteleria</span>
                            </a>
                        </div>

                        <div class="clearfix"></div>

                        <!-- profile -->
                        <div class="profile clearfix">
                            <div class="profile_pic">
                                <img src="~/images/img.jpg" alt="..." class="img-circle profile_img">
                            </div>
                            <div class="profile_info">

                                <span>Bienvenido,</span>
                                <h2>@(Session["Usuario"] ?? "Invitado")</h2>
                            </div>
                        </div>
                        <br />
                        <!-- sidebar menu -->
                        @Html.Action("CargarMenu", "Menu")
                        <!-- /sidebar menu -->
                    </div>
                </div>

                <!-- top navigation -->
                <div class="top_nav">
                    <div class="nav_menu">
                        <nav>
                            <div class="nav toggle">
                                <a id="menu_toggle"><i class="fa fa-bars"></i></a>
                            </div>
                            <ul class="nav navbar-nav navbar-right">
                                <li class="">
                                    <a href="javascript:;" class="user-profile dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                                        <img src="~/images/img.jpg" alt="">@(Session["Usuario"] ?? "Invitado")
                                        <span class=" fa fa-angle-down"></span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-usermenu pull-right">
                                        <li>@Html.ActionLink("Perfil", "Index", "Home")</li>
                                        <li><a href="#">Ayuda</a></li>
                                        <li>
                                            <a href="@Url.Action("Logout","Account")" class="fa fa-sign-out pull-right">Cerrar Sesión</a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
                <!-- /top navigation -->
            }

            <!-- page content -->
            @RenderBody()
            <!-- /page content -->

            @if (isLogged)
            {
                <!-- footer -->
                <footer>
                    <div class="pull-right">
                        Sabtech Group | Sistema Hotelero para la Minería <a href="https://sabtechgroup.com/">conocer más</a>
                    </div>
                    <div class="clearfix"></div>
                </footer>
                <!-- /footer -->
            }
        </div>
    </div>

    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    @* Mostrar login si no hay token en sesión *@
    @if (!isLogged)
    {
        <style>
            body.auth-only {
                background: #0f172a;
                overflow: hidden;
            }
        </style>
        <script>
        (function () {
          // 1) Carga del parcial del modal (sin layout)
          fetch('@Url.Action("LoginModal","Account")', { headers: { "X-Requested-With": "XMLHttpRequest" } })
            .then(function (r) { return r.text(); })
            .then(function (html) {
              var wrap = document.createElement('div');
              wrap.innerHTML = html;
              document.body.appendChild(wrap);

              var modalEl = document.getElementById('loginModal');
              if (!modalEl) { console.error('No se encontró #loginModal'); return; }

              // 2) Mostrar modal (BS5 o BS3/4)
              try {
                if (window.bootstrap && bootstrap.Modal) {
                  bootstrap.Modal.getOrCreateInstance(modalEl, { backdrop:'static', keyboard:false }).show();
                } else if (window.jQuery && typeof jQuery.fn.modal === 'function') {
                  jQuery(modalEl).modal({ backdrop:'static', keyboard:false }).modal('show');
                } else { // fallback
                  modalEl.style.display = 'block';
                  modalEl.classList.add('in','show');
                  document.body.classList.add('modal-open');
                }
              } catch (e) { console.error('Error mostrando modal:', e); }

              // 3) Enlazar eventos del botón ahora que el HTML ya está en el DOM
              wireLoginHandlers();
            })
            .catch(function (e) { console.error('No se pudo cargar el modal de login', e); });

          function wireLoginHandlers() {
            var btn = document.getElementById('btnLogin');
            var u   = document.getElementById('txtUsuario');
            var p   = document.getElementById('txtPassword');
            var msg = document.getElementById('loginMsg');
            var chk = document.getElementById('chkRecordar');

            if (!btn || !u || !p || !msg) {
              console.warn('[Login] DOM incompleto, no se engancharon handlers');
              return;
            }

            function setBusy(b){ btn.disabled = b; btn.innerText = b ? 'Ingresando…' : 'Iniciar Sesión'; }
            function showErr(t){ msg.textContent = t || 'No se pudo iniciar sesión.'; msg.classList.remove('d-none'); }
            function hideErr(){ msg.textContent = ''; msg.classList.add('d-none'); }

            // Prefill usuario recordado
            try {
              var saved = localStorage.getItem('app.u');
              if (saved) { u.value = saved; if (chk) chk.checked = true; }
            } catch(e){}

            async function doLogin() {
              hideErr(); setBusy(true);
              try {
                var usuario = (u.value || '').trim();
                var password = p.value || '';
                if (!usuario || !password) { showErr('Ingrese usuario y contraseña.'); return; }

                // Recordar usuario (opcional)
                try {
                  if (chk && chk.checked) localStorage.setItem('app.u', usuario);
                  else localStorage.removeItem('app.u');
                } catch(e){}

                var body = new URLSearchParams({ usuario: usuario, password: password }).toString();
                var resp = await fetch('@Url.Action("DoLogin","Account")', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'X-Requested-With': 'XMLHttpRequest'
                    // Si usas AntiForgery:
                    // 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                  },
                  body: body
                });

                var data = null;
                try { data = await resp.json(); } catch {}

                if (!resp.ok || !data || !data.ok) {
                  showErr((data && data.message) || 'Credenciales inválidas o API no disponible.');
                  return;
                }

                // éxito => Session["JWT"] ya está seteado
                window.location.reload();
              } catch (err) {
                console.error('[Login] Error:', err);
                showErr('Error de red. Intente nuevamente.');
              } finally {
                setBusy(false);
              }
            }

            btn.addEventListener('click', doLogin);
            [u, p].forEach(function (el) {
              el.addEventListener('keydown', function (e) { if (e.key === 'Enter') doLogin(); });
            });
            console.log('[Login] Handlers conectados');
          }
        })();
        </script>
    }
</body>
</html>
