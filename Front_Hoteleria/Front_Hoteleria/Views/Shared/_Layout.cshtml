<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Mi aplicación ASP.NET</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="nav-md">
    <!-- jQuery (usar https en lugar de http para evitar bloqueos) -->
    <script src="https://code.jquery.com/jquery-2.2.1.min.js"></script>

    <script src="https://maps.google.com/maps?file=api&amp;v=2&amp;sensor=false&amp;key=AIzaSyDszu0zZXaPKl_66jV2EJN7UIX-OaL-VoM"></script>
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/highcharts-3d.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>

    <div class="container body">
        <div class="main_container">
            <div class="col-md-3 left_col">
                <div class="left_col scroll-view">
                    <!-- profile -->
                    <div class="profile clearfix">
                        <div class="profile_pic">
                            <img src="~/images/img.jpg" alt="..." class="img-circle profile_img">
                        </div>
                        <div class="profile_info">
                            <span>Bienvenido,</span>
                            <h2>@(Session["Usuario"] ?? "Invitado")</h2>
                        </div>
                    </div>
                    <!-- /profile -->

                    <br />

                    <!-- sidebar menu -->
                    @Html.Action("CargarMenu", "Menu")
                    <!-- /sidebar menu -->
                </div>
            </div>

            <!-- top navigation -->
            <div class="top_nav">
                <div class="nav_menu">
                    <nav>
                        <div class="nav toggle">
                            <a id="menu_toggle"><i class="fa fa-bars"></i></a>
                        </div>

                        <ul class="nav navbar-nav navbar-right">
                            <li class="">
                                <a href="javascript:;" class="user-profile dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                                    <img src="~/images/img.jpg" alt="">@(Session["Usuario"] ?? "Invitado")
                                    <span class=" fa fa-angle-down"></span>
                                </a>
                                <ul class="dropdown-menu dropdown-usermenu pull-right">
                                    <li>@Html.ActionLink("Perfil", "Index", "Home")</li>
                                    <li><a href="#">Ayuda</a></li>
                                    <li>
                                        <a href="@Url.Action("Logout","Account")" class="fa fa-sign-out pull-right">Cerrar Sesión</a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
            <!-- /top navigation -->
            <!-- page content -->
            @RenderBody()
            <!-- /page content -->
            <!-- footer -->
            <footer>
                <div class="pull-right">
                    Sabtech Group | Sistema Hotelero para la Minería <a href="https://sabtechgroup.com/">conocer más</a>
                </div>
                <div class="clearfix"></div>
            </footer>
            <!-- /footer -->
        </div>

    </div>

    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    @* Mostrar login si no hay token en sesión *@
    @{
        var token = Session["JWT"] as string;
    }
    @if (string.IsNullOrEmpty(token))
    {
        <script>
        (function () {
            // Handler del botón ingresar
            document.addEventListener('click', async function (e) {
                if (e.target && e.target.id === 'btnLogin') {
                    const usuario = document.getElementById('txtUsuario').value.trim();
                    const password = document.getElementById('txtPassword').value;
                    const msg = document.getElementById('loginMsg');
                    msg.classList.add('d-none'); msg.textContent = '';

                    if (!usuario || !password) {
                        msg.textContent = 'Ingrese usuario y contraseña.';
                        msg.classList.remove('d-none');
                        return;
                    }

                    try {
                        const resp = await fetch('@Url.Action("DoLogin","Account")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ usuario, password })
                        });
                        const data = await resp.json();
                        if (!data.ok) {
                            msg.textContent = data.message || 'No se pudo iniciar sesión.';
                            msg.classList.remove('d-none');
                            return;
                        }
                        if (data.token) localStorage.setItem("JWT", data.token); // opcional
                        window.location.reload();
                    } catch (err) {
                        msg.textContent = 'Error de red. Intente nuevamente.';
                        msg.classList.remove('d-none');
                    }
                }
            });

            // Cargar e insertar el modal dinámicamente
            fetch('@Url.Action("LoginModal","Account")')
                .then(r => r.text())
                .then(html => {
                    var wrap = document.createElement('div');
                    wrap.innerHTML = html;
                    document.body.appendChild(wrap);
                    $('#loginModal').modal({ backdrop: 'static', keyboard: false });
                    $('#loginModal').modal('show');
                })
                .catch(e => console.error('No se pudo cargar el modal de login', e));
        })();
        </script>
    }
</body>
</html>

