@using System.Linq
@model List<Front_Hoteleria.Dto.MenuDTO>

@{
    var menuModel = Model ?? new List<Front_Hoteleria.Dto.MenuDTO>();

    // Normaliza texto: minúsculas, sin espacios y sin tildes
    System.Func<string, string> Norm = s =>
    {
        s = (s ?? "").Trim().ToLowerInvariant();
        s = s.Replace("á", "a").Replace("à", "a").Replace("ä", "a")
             .Replace("é", "e").Replace("è", "e").Replace("ë", "e")
             .Replace("í", "i").Replace("ì", "i").Replace("ï", "i")
             .Replace("ó", "o").Replace("ò", "o").Replace("ö", "o")
             .Replace("ú", "u").Replace("ù", "u").Replace("ü", "u");
        s = s.Replace(" ", "");
        return s;
    };

    // Nombre de perfil si lo mandas desde el layout
    string nombrePerfilViewBag = ViewBag.NombrePerfil as string ?? "";
    string perfilNorm = Norm(nombrePerfilViewBag);

    // ¿Es huésped?
    bool esHuespedFlag = false;
    if (ViewBag.EsHuesped != null)
    {
        bool.TryParse(ViewBag.EsHuesped.ToString(), out esHuespedFlag);
    }

    bool esHuespedPorNombre = perfilNorm.Contains("huesped");
    bool esHuespedPorMenu = menuModel.Any(m => Norm(m.Titulo).Contains("huesped"));

    bool esHuesped = esHuespedFlag || esHuespedPorNombre || esHuespedPorMenu;

    // Otros perfiles según los menús raíz
    bool hayAdmin = menuModel.Any(m => Norm(m.Titulo) == "administracion");
    bool hayPlataforma = menuModel.Any(m => Norm(m.Titulo) == "plataforma");
    bool hayServicioRaiz = menuModel.Any(m =>
        Norm(m.Titulo) == "servicio" || Norm(m.Titulo) == "servicios");

    string tituloMenu;
    if (esHuesped)
    {
        tituloMenu = "MENÚ HUÉSPED";
    }
    else if (hayAdmin)
    {
        tituloMenu = "MENÚ ADMINISTRADOR";
    }
    else if (hayPlataforma)
    {
        tituloMenu = "MENÚ PLATAFORMA";
    }
    else if (hayServicioRaiz)
    {
        tituloMenu = "MENÚ PERSONAL";
    }
    else
    {
        tituloMenu = "MENÚ USUARIO";
    }

    // Menú raíz para huésped (si existe)
    var menuHuesped = menuModel.FirstOrDefault(m => Norm(m.Titulo).Contains("huesped"));
}

@if (esHuesped)
{
    /* ============================
       MENÚ ESTILO HUÉSPED
       ============================ */
    <style>
        #sidebar-menu .menu-user-custom {
            margin: 0;
            padding: 0;
        }

            #sidebar-menu .menu-user-custom h3 {
                margin: 0;
                padding: 12px 18px 0 18px;
                font-weight: 600;
                color: #fff;
            }

            /* “2 renglones” de aire debajo del título */
            #sidebar-menu .menu-user-custom .menu-title-gap {
                height: 16px;
            }

            #sidebar-menu .menu-user-custom ul.nav.side-menu {
                margin: 0;
                padding: 0;
            }

                #sidebar-menu .menu-user-custom ul.nav.side-menu > li {
                    list-style: none;
                    background: #3d5162;
                    margin: 0 0 8px 0;
                    position: relative;
                    width: 100%;
                }

                    #sidebar-menu .menu-user-custom ul.nav.side-menu > li > a {
                        display: flex;
                        align-items: center;
                        gap: 14px;
                        padding: 14px 18px 14px 28px;
                        color: #fff;
                        text-decoration: none;
                        width: 100%;
                        margin: 0 !important;
                        box-sizing: border-box;
                    }

            /* icono normal */
            #sidebar-menu .menu-user-custom .menu-icon {
                width: 26px;
                text-align: center;
                font-size: 20px;
            }

            /* franja a la izquierda */
            #sidebar-menu .menu-user-custom ul.nav.side-menu > li::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 6px;
                height: 100%;
                background: transparent;
            }

            /* colores por opción */
            #sidebar-menu .menu-user-custom ul.nav.side-menu > li.menu-reservas::before,
            #sidebar-menu .menu-user-custom ul.nav.side-menu > li.menu-servicios::before {
                background: #12c2a5;
            }

            #sidebar-menu .menu-user-custom ul.nav.side-menu > li.menu-reclamos::before {
                background: #f39c12;
            }

            /* iconos del mismo color */
            #sidebar-menu .menu-user-custom ul.nav.side-menu > li.menu-reservas .menu-icon,
            #sidebar-menu .menu-user-custom ul.nav.side-menu > li.menu-servicios .menu-icon {
                color: #12c2a5;
            }

            #sidebar-menu .menu-user-custom ul.nav.side-menu > li.menu-reclamos .menu-icon {
                color: #f39c12;
            }

            #sidebar-menu .menu-user-custom ul.nav.side-menu > li > a:hover {
                background: #435c6e;
            }
    </style>

    <div id="sidebar-menu" class="main_menu_side hidden-print main_menu">
        <div class="menu_section menu-user-custom">
            <h3>@tituloMenu</h3>
            <div class="menu-title-gap"></div>

            @{
                // Orden: Reservas, Servicios, Reclamos
                var submenus = (menuHuesped?.SubMenu ??
                                Enumerable.Empty<Front_Hoteleria.Dto.MenuDTO>())
                               .OrderBy(h =>
                               {
                                   var key = Norm(h.Titulo);
                                   if (key.Contains("reserva")) return 0;
                                   if (key.Contains("servicio")) return 1;
                                   if (key.Contains("reclamo")) return 2;
                                   return 999;
                               })
                               .ToList();
            }

            <ul class="nav side-menu">
                @foreach (var sub in submenus)
                {
                    var key = Norm(sub.Titulo);
                    var liClass = "";
                    var iconClass = "fa fa-angle-right";

                    if (key.Contains("reserva"))
                    {
                        liClass = "menu-reservas";
                        iconClass = "fa fa-calendar";
                    }
                    else if (key.Contains("servicio"))
                    {
                        liClass = "menu-servicios";
                        iconClass = "fa fa-cogs";
                    }
                    else if (key.Contains("reclamo"))
                    {
                        liClass = "menu-reclamos";
                        iconClass = "fa fa-comments";
                    }

                    <li class="@liClass">
                        <a href="@(sub.Url ?? "#")" title="@(sub.Url ?? "")">
                            <i class="menu-icon @iconClass"></i>
                            <span>@sub.Titulo</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
}
else
{
    /* ============================
       MENÚ NORMAL (ADMIN / PERSONAL / PLATAFORMA)
       ============================ */
    <div id="sidebar-menu" class="main_menu_side hidden-print main_menu">
        <div class="menu_section">
            <h3>@tituloMenu</h3>

            @{
                // Primer menú raíz que tenga hijos -> se mostrará desplegado
                var primerRaizConHijos = menuModel
                    .FirstOrDefault(m => (m.SubMenu ??
                        Enumerable.Empty<Front_Hoteleria.Dto.MenuDTO>())
                        .Any());
            }

            <ul class="nav side-menu">
                @foreach (var item in menuModel)
                {
                    var hijos = (item.SubMenu ??
                                Enumerable.Empty<Front_Hoteleria.Dto.MenuDTO>())
                                .ToList();

                    // ==== ORDEN PARA ADMINISTRADOR ====
                    if (Norm(item.Titulo) == "administracion")
                    {
                        hijos = hijos
                            .OrderBy(h =>
                            {
                                var key = Norm(h.Titulo);
                                if (key.Contains("reserva")) return 0;
                                if (key.Contains("servicio")) return 1;
                                if (key.Contains("checkin")) return 2;
                                if (key.Contains("reporte")) return 3;
                                return 999;
                            })
                            .ToList();
                    }

                    // ==== ORDEN PARA PLATAFORMA ====
                    if (Norm(item.Titulo) == "plataforma")
                    {
                        hijos = hijos
                            .OrderBy(h =>
                            {
                                var key = Norm(h.Titulo);

                                if (key.Contains("habitacion")) return 0; // Habitaciones
                                if (key.Contains("serviciosdisponibles") ||
                                    (key.Contains("servicio") && key.Contains("disponible"))) return 1; // Servicios Disponibles
                                if (key.Contains("inventario")) return 2;
                                if (key.Contains("campamento")) return 3;
                                if (key.Contains("contrato")) return 4;
                                if (key.Contains("dotacion")) return 5;
                                if (key.Contains("rol")) return 6;
                                if (key.Contains("calendario")) return 7;

                                return 999;
                            })
                            .ToList();
                    }

                    var tituloItem = item.Titulo ?? "";
                    var iconoItem = "fa fa-check"; // item.Icono ?? "";

                    // Ajuste de "Servicio" -> "Servicios" para perfil Personal
                    if (Norm(tituloItem) == "servicio")
                    {
                        tituloItem = "Servicios";

                        //if (string.IsNullOrWhiteSpace(iconoItem) || iconoItem == "fa fa-folder")
                        //{
                        iconoItem = "fa fa-cogs";
                        //}
                    }

                var tieneHijos = hijos.Any();
                // ¿Es este el menú raíz que queremos dejar desplegado?
                bool esRaizActiva = primerRaizConHijos != null && item == primerRaizConHijos;

                    <li class="@(tieneHijos ? "has-children" : null) @(esRaizActiva ? "active" : "")">
                        <a href="@(tieneHijos ? "javascript:;" : (item.Url ?? "#"))"
                           title="@(item.Url ?? "")">
                            <i class="@iconoItem"></i> @tituloItem
                            @if (tieneHijos)
                            {
                                <span class="fa fa-chevron-down"></span>
                            }
                        </a>

                        @if (tieneHijos)
                        {
                            <ul class="nav child_menu" style="@(esRaizActiva ? "display:block;" : "display:none;")">
                                @foreach (var sub in hijos)
                                {
                                    <li>
                                        <a href="@(sub.Url ?? "#")" title="@(sub.Url ?? "")">
                                            @(sub.Titulo ?? "")
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
}

