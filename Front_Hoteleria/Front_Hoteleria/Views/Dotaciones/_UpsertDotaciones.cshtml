@model Front_Hoteleria.Dto.Dotaciones.DotacionDto
@{
    Layout = null;
    var esNuevo = Model == null || Model.IdDotacion == 0;
    var titulo = esNuevo ? "Agregar Trabajador" : "Editar Trabajador";
}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h4 class="modal-title">@titulo</h4>
</div>

<div class="modal-body">
    <form id="frmDotacion" autocomplete="off">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IdDotacion)

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Nombre *</label>
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Ej: Juan", required = "required" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Apellido *</label>
                    @Html.TextBoxFor(m => m.Apellido, new { @class = "form-control", placeholder = "Ej: Pérez", required = "required" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>RUT *</label>
                    @Html.TextBoxFor(m => m.Rut, new { @class = "form-control", placeholder = "Ej: 12.345.678-9", required = "required" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Empresa *</label>
                    @* si tienes un combo real, lo cambias por un select *@
                    @Html.TextBoxFor(m => m.Empresa, new { @class = "form-control", placeholder = "Ej: Constructora ABC", required = "required" })
                    @Html.HiddenFor(m => m.IdEmpresa)  @* por si lo ocupas *@
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Cargo *</label>
                    @Html.TextBoxFor(m => m.Cargo, new { @class = "form-control", placeholder = "Ej: Supervisor", required = "required" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Turno *</label>
                    <select name="Turno" class="form-control" required>
                        <option value="">Seleccionar...</option>
                        <option value="Día" @(Model?.Turno == "Día" ? "selected" : "")>Día</option>
                        <option value="Noche" @(Model?.Turno == "Noche" ? "selected" : "")>Noche</option>
                        <option value="Mantenimiento" @(Model?.Turno == "Mantenimiento" ? "selected" : "")>Mantenimiento</option>
                        <option value="Off" @(Model?.Turno == "Off" ? "selected" : "")>Off</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>Observaciones</label>
            @Html.TextAreaFor(m => m.Observaciones, 3, 50, new { @class = "form-control", placeholder = "Observaciones sobre el trabajador..." })
        </div>
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
    <button type="button" class="btn btn-primary" id="btnGuardarDot">
        @(esNuevo ? "Agregar Trabajador" : "Guardar Cambios")
    </button>
</div>

<script>
    // importante: desenganchar antes por si el modal se abre varias veces
    $('#btnGuardarDot').off('click').on('click', function () {

        // validación simple
        var nombre = $('#frmDotacion input[name="Nombre"]').val();
        var apellido = $('#frmDotacion input[name="Apellido"]').val();
        var rut = $('#frmDotacion input[name="Rut"]').val();
        if (!nombre || !apellido || !rut) {
            alert('Completa los campos obligatorios.');
            return;
        }

        $.post('@Url.Action("Guardar","Dotaciones")',
            $('#frmDotacion').serialize(),
            function (r) {
                if (r && r.ok) {
                    // cerrar modal
                    $('#modalDot').modal('hide');

                    // recargar la tabla de dotaciones
                    // el Index tiene #tablaDotContainer
                    $('#tablaDotContainer').load('@Url.Action("Tabla","Dotaciones")');

                    // recargar dashboard también
                    $('#dashDotContainer').load('@Url.Action("Dashboard","Dotaciones")');
                } else {
                    alert(r.message || 'No se pudo guardar la dotación.');
                }
            }
        ).fail(function () {
            alert('Error al guardar la dotación.');
        });
    });
</script>
