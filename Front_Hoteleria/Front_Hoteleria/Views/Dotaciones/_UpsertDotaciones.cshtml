@model Front_Hoteleria.Dto.Dotaciones.DotacionDto

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
    <h4 class="modal-title">
        @(Model != null && Model.Id > 0 ? "Editar trabajador" : "Nuevo trabajador")
    </h4>
</div>
<div class="modal-body">
    @using (Html.BeginForm("Guardar", "Dotaciones", FormMethod.Post, new { id = "frmDotacion" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(x => x.Id)

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Nombre</label>
                    @Html.TextBoxFor(x => x.Nombre, new { @class = "form-control", required = "required" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Apellido</label>
                    @Html.TextBoxFor(x => x.Apellido, new { @class = "form-control", required = "required" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>RUT</label>
                    @Html.TextBoxFor(x => x.Rut, new { @class = "form-control", required = "required" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Empresa</label>
                    @Html.TextBoxFor(x => x.Empresa, new { @class = "form-control", required = "required" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Cargo</label>
                    @Html.TextBoxFor(x => x.Cargo, new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Turno</label>
                    @Html.DropDownListFor(x => x.Turno,
                        new SelectList(new[] {
                            new { Value = "Día", Text = "Día (06:00 - 18:00)" },
                            new { Value = "Noche", Text = "Noche (18:00 - 06:00)" },
                            new { Value = "Mantenimiento", Text = "Mantenimiento" },
                            new { Value = "Fuera", Text = "Fuera de servicio" }
                        }, "Value", "Text", Model?.Turno),
                        "-- Seleccione --",
                        new { @class = "form-control", required = "required" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>Teléfono</label>
            @Html.TextBoxFor(x => x.Telefono, new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Observaciones</label>
            @Html.TextAreaFor(x => x.Observaciones, 2, 40, new { @class = "form-control" })
        </div>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
    <button type="button" id="btnGuardarDot" class="btn btn-primary">
        <i class="fa fa-save"></i> Guardar
    </button>
</div>

<script>
    $('#btnGuardarDot').on('click', function () {
        var $f = $('#frmDotacion');
        $.post($f.attr('action'), $f.serialize(), function (r) {
            if (r.ok) {
                $('#modalDot').modal('hide');
                $('#tablaDotContainer').load('@Url.Action("Tabla","Dotaciones")');
            } else {
                alert(r.message || 'No se pudo guardar.');
            }
        });
    });
</script>
