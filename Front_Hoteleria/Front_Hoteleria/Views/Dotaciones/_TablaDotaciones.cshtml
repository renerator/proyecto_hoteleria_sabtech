@model IEnumerable<Front_Hoteleria.Dto.Dotaciones.DotacionDto>

<table class="table table-striped table-bordered" id="tblDotaciones">
    <thead>
        <tr>
            <th>ID</th>
            <th>Empresa</th>
            <th>Nombre</th>
            <th>RUT</th>
            <th>Cargo</th>
            <th>Turno</th>
            <th>Teléfono</th>
            <th style="width:90px;">Opciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var d in Model)
            {
                <tr>
                    <td>@d.IdDotacion</td>
                    <td>@d.Empresa</td>
                    <td>@( (d.Nombre + " " + d.Apellido).Trim() )</td>
                    <td>@d.Rut</td>
                    <td>@d.Cargo</td>
                    <td>@d.Turno</td>
                    <td>@d.Telefono</td>
                    <td class="text-center">
                        <button class="btn btn-info btn-xs btn-edit-dot" data-id="@d.IdDotacion"><i class="fa fa-pencil"></i></button>
                        <button class="btn btn-danger btn-xs btn-del-dot" data-id="@d.IdDotacion"><i class="fa fa-times"></i></button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No hay dotaciones.</td>
            </tr>
        }
    </tbody>
</table>
