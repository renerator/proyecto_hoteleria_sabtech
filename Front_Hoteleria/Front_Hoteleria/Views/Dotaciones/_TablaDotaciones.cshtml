@model List<Front_Hoteleria.Dto.Dotaciones.DotacionDto>

@{
    var lista = Model ?? new List<Front_Hoteleria.Dto.Dotaciones.DotacionDto>();

    // agrupamos por empresa
    var grupos = lista
        .GroupBy(x => new
        {
            x.IdEmpresa,
            Empresa = x.Empresa ?? "Sin empresa",
            Rut = x.RutEmpresa ?? ""
        })
        .OrderBy(g => g.Key.Empresa)
        .ToList();
}

<style>
    .dot-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 18px 18px 10px 18px;
        margin-bottom: 18px;
        box-shadow: 0 1px 3px rgba(0,0,0,.02);
    }

        .dot-card h4 {
            margin-top: 0;
            margin-bottom: 3px;
            font-weight: 600;
            color: #34495e;
        }

        .dot-card small {
            color: #7f8c8d;
        }

    .dot-line {
        display: inline-block;
        margin-right: 45px;
        font-size: 13px;
        color: #34495e;
    }

        .dot-line b {
            font-weight: 600;
        }

    .dot-worker-name {
        font-weight: 600;
        color: #34495e;
        margin-bottom: 2px;
    }

    .shift-pill {
        display: inline-block;
        padding: 3px 14px;
        border-radius: 999px;
        color: #fff;
        font-weight: 600;
        font-size: 12px;
        vertical-align: middle;
    }

    /* colores de turno */
    .shift-dia {
        background: #27ae60; /* verde */
    }

    .shift-noche {
        background: #34495e; /* negro/azul oscuro */
    }

    .shift-mant {
        background: #f0ad4e; /* naranja */
    }

    .dot-actions .btn {
        min-width: 110px;
    }
</style>

<div class="x_title">
    <h2>Dotaciones por Empresa</h2>
    <div class="clearfix"></div>
</div>

<div class="x_content">
    @if (grupos.Any())
    {
        foreach (var g in grupos)
        {
            var trabajadores = g.ToList();

            // normalizamos turnos para contar
            var turnoDia = trabajadores.Count(x =>
            {
                var tt = (x.Turno ?? "").ToLower();
                return tt.Contains("día") || tt.Contains("dia") || tt == "day";
            });

            var turnoNoche = trabajadores.Count(x =>
            {
                var tt = (x.Turno ?? "").ToLower();
                return tt.Contains("noche") || tt.Contains("night");
            });

            var mant = trabajadores.Count(x =>
            {
                var tt = (x.Turno ?? "").ToLower();
                return tt.Contains("mantenimiento") || tt.Contains("mant");
            });

            // si en tu dto Estado es bool, esto está bien. Si es int, cambias a x.Estado == 0 o == 1
            var off = trabajadores.Count(x => x.Estado == false);

            <div class="dot-card">
                <div class="row">
                    <div class="col-md-9">
                        <h4>@g.Key.Empresa <small>@g.Key.Rut</small></h4>
                        <p style="margin-bottom:6px;">
                            <b>Total de Trabajadores:</b> @trabajadores.Count
                        </p>
                        <div style="margin-bottom:12px;">
                            <span class="dot-line"><b>Turno Día:</b> @turnoDia</span>
                            <span class="dot-line"><b>Turno Noche:</b> @turnoNoche</span>
                            <span class="dot-line"><b>Mantenimiento:</b> @mant</span>
                            <span class="dot-line"><b>Fuera de Servicio:</b> @off</span>
                        </div>

                        <p style="font-weight:600; margin-bottom:8px;">Trabajadores:</p>
                        <div class="row">
                            @foreach (var t in trabajadores)
                            {
                                var tt = (t.Turno ?? "").Trim().ToLower();

                                // prioridad: mantenimiento → naranja, noche → negro, resto → verde
                                string chipClass;
                                if (tt.Contains("mantenimiento") || tt.Contains("mant"))
                                {
                                    chipClass = "shift-mant";
                                }
                                else if (tt.Contains("noche") || tt.Contains("night"))
                                {
                                    chipClass = "shift-noche";
                                }
                                else
                                {
                                    chipClass = "shift-dia";
                                }

                                <div class="col-md-3 col-sm-4" style="margin-bottom:10px;">
                                    <div class="dot-worker-name">@t.Nombre @t.Apellido</div>
                                    <small>
                                        @t.Cargo
                                        |
                                        <span class="shift-pill @chipClass">@t.Turno</span><br />
                                        RUT: @t.Rut
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-3 text-right dot-actions" style="margin-top:5px;">
                        <button type="button" class="btn btn-info btn-sm btn-ver-dot-empresa" data-id="@g.Key.IdEmpresa">
                            <i class="fa fa-eye"></i> Ver Dotación
                        </button>
                        <button type="button" class="btn btn-warning btn-sm btn-edit-dot-empresa" data-id="@g.Key.IdEmpresa">
                            <i class="fa fa-edit"></i> Editar
                        </button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">No hay dotaciones registradas.</div>
    }
</div>
