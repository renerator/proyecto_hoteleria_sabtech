@model List<Front_Hoteleria.Dto.Dotaciones.DotacionDto>

@{
    var lista = Model ?? new List<Front_Hoteleria.Dto.Dotaciones.DotacionDto>();

    // agrupamos por empresa igual que en la maqueta
    var grupos = lista
        .GroupBy(x => new { x.IdEmpresa, Empresa = x.Empresa ?? "Sin empresa", Rut = x.RutEmpresa ?? "" })
        .OrderBy(g => g.Key.Empresa)
        .ToList();
}

<style>
    .dot-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 18px 18px 10px 18px;
        margin-bottom: 18px;
        box-shadow: 0 1px 3px rgba(0,0,0,.02);
    }

        .dot-card h4 {
            margin-top: 0;
            margin-bottom: 3px;
            font-weight: 600;
            color: #34495e;
        }

        .dot-card small {
            color: #7f8c8d;
        }

    .dot-line {
        display: inline-block;
        margin-right: 45px;
        font-size: 13px;
        color: #34495e;
    }

        .dot-line b {
            font-weight: 600;
        }

    .dot-worker-name {
        font-weight: 600;
        color: #34495e;
        margin-bottom: 2px;
    }

    .shift-pill {
        display: inline-block;
        padding: 3px 14px;
        border-radius: 999px;
        color: #fff;
        font-weight: 600;
        font-size: 12px;
        vertical-align: middle;
    }

    .shift-dia {
        background: #27ae60;
    }

    .shift-noche {
        background: #34495e;
    }

    .shift-mant {
        background: #f0ad4e;
    }

    .dot-actions .btn {
        min-width: 110px;
    }
</style>

<div class="x_title">
    <h2>Dotaciones por Empresa</h2>
    <div class="clearfix"></div>
</div>

<div class="x_content">
    @if (grupos.Any())
    {
        foreach (var g in grupos)
        {
            var trabajadores = g.ToList();
            var turnoDia = trabajadores.Count(x => x.TurnoCodigo == "day" || (x.TurnoNombre ?? "").ToLower().Contains("día"));
            var turnoNoche = trabajadores.Count(x => x.TurnoCodigo == "night" || (x.TurnoNombre ?? "").ToLower().Contains("noche"));
            var mant = trabajadores.Count(x => x.TurnoCodigo == "maintenance" || (x.TurnoNombre ?? "").ToLower().Contains("mantenimiento"));
            var off = trabajadores.Count(x => x.TurnoCodigo == "off" || (x.TurnoNombre ?? "").ToLower().Contains("fuera"));
            <div class="dot-card">
                <div class="row">
                    <div class="col-md-9">
                        <h4>@g.Key.Empresa <small>@g.Key.Rut</small></h4>
                        <p style="margin-bottom:6px;">
                            <b>Total de Trabajadores:</b> @trabajadores.Count
                        </p>
                        <div style="margin-bottom:12px;">
                            <span class="dot-line"><b>Turno Día:</b> @turnoDia</span>
                            <span class="dot-line"><b>Turno Noche:</b> @turnoNoche</span>
                            <span class="dot-line"><b>Mantenimiento:</b> @mant</span>
                            <span class="dot-line"><b>Fuera de Servicio:</b> @off</span>
                        </div>

                        <p style="font-weight:600; margin-bottom:8px;">Trabajadores:</p>
                        <div class="row">
                            @foreach (var t in trabajadores)
                            {
                                // elegimos color del chip
                                var tn = (t.TurnoNombre ?? "").ToLower();
                                var chipClass =
                                    (t.TurnoCodigo == "day" || tn.Contains("día")) ? "shift-dia" :
                                    (t.TurnoCodigo == "night" || tn.Contains("noche")) ? "shift-noche" :
                                    (t.TurnoCodigo == "maintenance" || tn.Contains("mantenimiento")) ? "shift-mant" :
                                    "shift-dia";

                                <div class="col-md-3 col-sm-4" style="margin-bottom:10px;">
                                    <div class="dot-worker-name">@t.Nombre @t.Apellido</div>
                                    <small>
                                        @t.Cargo
                                        |
                                        <span class="shift-pill @chipClass">@t.TurnoNombre</span><br />
                                        RUT: @t.Rut
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-3 text-right dot-actions" style="margin-top:5px;">
                        <button type="button" class="btn btn-info btn-sm btn-ver-dot-empresa" data-id="@g.Key.IdEmpresa">
                            <i class="fa fa-eye"></i> Ver Dotación
                        </button>
                        <button type="button" class="btn btn-warning btn-sm btn-edit-dot-empresa" data-id="@g.Key.IdEmpresa">
                            <i class="fa fa-edit"></i> Editar
                        </button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">No hay dotaciones registradas.</div>
    }
</div>
