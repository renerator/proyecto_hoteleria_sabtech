@model Front_Hoteleria.Dto.Dotaciones.DotacionKPIDto

<div class="col-md-12">
    <div class="staff-stats">
        <div class="row">
            <div class="col-md-3 text-center">
                <h3>@(Model?.TotalTrabajadores ?? 0)</h3>
                <p>Trabajadores Activos</p>
            </div>
            <div class="col-md-3 text-center">
                <h3>@(Model?.TurnoDia ?? 0)</h3>
                <p>Turno Día</p>
            </div>
            <div class="col-md-3 text-center">
                <h3>@(Model?.TurnoNoche ?? 0)</h3>
                <p>Turno Noche</p>
            </div>
            <div class="col-md-3 text-center">
                <h3>@(Model?.FueraServicio ?? 0)</h3>
                <p>Fuera de Servicio</p>
            </div>
        </div>
    </div>
</div>
