@Model Front_Hoteleria.Dto.Reserva.ReservaDashboardDto

@{
    int totalConfirmadas = Convert.ToInt32(Model?.TotalConfirmadas ?? 0);
    int totalRechazadas = Convert.ToInt32(Model?.TotalRechazadas ?? 0);
    int totalServicios = Convert.ToInt32(Model?.TotalServicios ?? 0);

    // Fallback para el nombre de “Nuevas Hoy”
    int nuevasHoy = 0;
    if (Model != null)
    {
        var t = Model.GetType();
        var p = t.GetProperty("NuevasHoy") ?? t.GetProperty("NuevasHoys") ?? t.GetProperty("NuevasReservas");
        var v = p?.GetValue(Model, null);
        nuevasHoy = v != null ? Convert.ToInt32(v) : 0;
    }
}

<div class="row">
    <div class="col-sm-3">
        <div class="well text-center">
            <div style="font-size:28px;font-weight:700">@totalConfirmadas.ToString("N0")</div>
            <div class="text-muted" style="text-transform:uppercase;letter-spacing:.5px">Total Confirmadas</div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="well text-center">
            <div style="font-size:28px;font-weight:700">@totalRechazadas.ToString("N0")</div>
            <div class="text-muted" style="text-transform:uppercase;letter-spacing:.5px">Total Rechazadas</div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="well text-center">
            <div style="font-size:28px;font-weight:700">@totalServicios.ToString("N0")</div>
            <div class="text-muted" style="text-transform:uppercase;letter-spacing:.5px">Total Servicios</div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="well text-center">
            <div style="font-size:28px;font-weight:700">@nuevasHoy.ToString("N0")</div>
            <div class="text-muted" style="text-transform:uppercase;letter-spacing:.5px">Nuevas Hoy</div>
        </div>
    </div>
</div>
