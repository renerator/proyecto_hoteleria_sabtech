@{
    ViewBag.Title = "Gestión de Dotaciones y Turnos | Sabtech Group";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .staff-stats {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: white;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .staff-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 15px;
        background: #fff;
        transition: all .2s;
    }

        .staff-card:hover {
            box-shadow: 0 4px 10px rgba(0,0,0,.08);
            transform: translateY(-2px);
        }

    .shift-status {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
        color: #fff;
    }

    .shift-day {
        background: #5cb85c;
    }

    .shift-night {
        background: #2c3e50;
    }

    .shift-maintenance {
        background: #f0ad4e;
    }

    .shift-off {
        background: #d9534f;
    }

    .upload-area {
        border: 2px dashed #007bff;
        border-radius: 10px;
        padding: 35px;
        text-align: center;
        background: #f8f9fa;
        margin-bottom: 20px;
    }
</style>

<div class="right_col" role="main">
    <div class="">
        <div class="page-title">
            <div class="title_left">
                <h3>Gestión de Dotaciones y Turnos <small>Control de personal y horarios</small></h3>
            </div>
            <div class="title_right">
                <div class="col-md-5 col-sm-5 col-xs-12 form-group pull-right top_search">
                    <div class="input-group">
                        <input id="txtBuscarDot" type="text" class="form-control" placeholder="Buscar trabajador o empresa...">
                        <span class="input-group-btn">
                            <button id="btnBuscarDot" class="btn btn-default" type="button">Go!</button>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>

        <!-- DASHBOARD (cards) -->
        <div id="dashDotContainer" class="row">
            <div class="col-md-12">
                <div class="text-muted">Cargando indicadores…</div>
            </div>
        </div>

        <!-- ACCIONES + TABLA -->
        <div class="row">
            <div class="col-md-12">
                <div class="x_panel">
                    <div class="x_content">
                        <div class="row" style="margin-bottom: 15px;">
                            <div class="col-md-6">
                                <button type="button" id="btnCargaMasivaDot" class="btn btn-primary">
                                    <i class="fa fa-upload"></i> Carga Masiva Excel
                                </button>
                                <button type="button" id="btnNuevoDot" class="btn btn-success">
                                    <i class="fa fa-user-plus"></i> Agregar Trabajador
                                </button>
                                <button type="button" id="btnTurnosDot" class="btn btn-info">
                                    <i class="fa fa-calendar"></i> Gestionar Turnos
                                </button>
                            </div>
                            <div class="col-md-6 text-right">
                                <button type="button" id="btnExportarDot" class="btn btn-warning">
                                    <i class="fa fa-file-excel-o"></i> Exportar Dotación
                                </button>
                                <button type="button" id="btnRefreshDot" class="btn btn-default">
                                    <i class="fa fa-refresh"></i> Actualizar
                                </button>
                            </div>
                        </div>
                        <!-- contenedor tabla -->
                        <div id="tablaDotContainer">
                            <div class="text-muted">Cargando dotaciones…</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- MODAL GENÉRICO -->
<div class="modal fade" id="modalDot" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content"></div>
    </div>
</div>

@section Scripts{
    <script>
        // urls al controlador Dotaciones
        const urlDashDot   = '@Url.Action("Dashboard","Dotaciones")';
        const urlTablaDot  = '@Url.Action("Tabla","Dotaciones")';
        const urlUpsertDot = '@Url.Action("Upsert","Dotaciones")';
        const urlCargaDot  = '@Url.Action("CargaMasiva","Dotaciones")';
        const urlTurnosDot = '@Url.Action("Turnos","Dotaciones")';

        // GET al dashboard
        function cargarDashboardDot() {
            $('#dashDotContainer').load(urlDashDot);
        }

        // IMPORTANTE: aquí lo pasamos por querystring para que sea GET
        function cargarTablaDot(buscar) {
            var qs = '';
            if (buscar && buscar.length > 0) {
                qs = '?criterio=' + encodeURIComponent(buscar);
            }
            $('#tablaDotContainer').load(urlTablaDot + qs, function () {
                var $t = $('#tablaDotaciones');
                if ($t.length && $.fn.DataTable) {
                    $t.DataTable({
                        destroy: true,
                        pageLength: 10,
                        lengthChange: true,
                        language: {
                            url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                        }
                    });
                }
            });
        }

        $(function () {

            // búsqueda
            $('#btnBuscarDot').on('click', function () {
                var txt = $('#txtBuscarDot').val();
                cargarTablaDot(txt);
            });
            $('#txtBuscarDot').on('keyup', function (e) {
                if (e.key === 'Enter') {
                    cargarTablaDot($(this).val());
                }
            });

            // agregar
            $('#btnNuevoDot').on('click', function () {
                $.get(urlUpsertDot, function (html) {
                    $('#modalDot .modal-content').html(html);
                    $('#modalDot').modal('show');
                });
            });

            // carga masiva
            $('#btnCargaMasivaDot').on('click', function () {
                $.get(urlCargaDot, function (html) {
                    $('#modalDot .modal-content').html(html);
                    $('#modalDot').modal('show');
                });
            });

            // turnos
            $('#btnTurnosDot').on('click', function () {
                $.get(urlTurnosDot, function (html) {
                    $('#modalDot .modal-content').html(html);
                    $('#modalDot').modal('show');
                });
            });

            // refrescar vista completa
            $('#btnRefreshDot').on('click', function () {
                location.reload();
            });

            // carga inicial
            cargarDashboardDot();
            cargarTablaDot('');
        });
    </script>
}
