@model List<Front_Hoteleria.Dto.Roles.AsignacionRolDto>

<style>
    .assign-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 15px;
        background: #fff;
        margin-bottom: 15px;
    }

    .worker-role-item {
        background: #f8f9fa;
        border-left: 4px solid #007bff;
        padding: 10px;
        margin: 5px 0;
        border-radius: 4px;
    }

    .role-badge {
        display: inline-block;
        background: #337ab7;
        color: #fff;
        padding: 3px 8px;
        border-radius: 10px;
        font-size: 11px;
    }
</style>

@if (Model == null || !Model.Any())
{
    <p>No hay asignaciones de roles.</p>
}
else
{
    var grupos = Model.GroupBy(m => m.Empresa ?? "Sin empresa");

    foreach (var g in grupos)
    {
        <div class="assign-card">
            <h4>@g.Key</h4>
            <div class="row">
                @foreach (var a in g)
                {
                    <div class="col-md-6">
                        <div class="worker-role-item">
                            <strong>@a.TrabajadorNombre</strong><br />
                            <small>
                                <span class="role-badge">@a.RolNombre</span>
                                | Asignado: @a.FechaAsignacion?.ToString("dd/MM/yyyy") ?? ""

                                | Por: @a.AsignadoPor
                            </small>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}
