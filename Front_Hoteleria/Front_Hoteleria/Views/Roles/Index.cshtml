@{
    ViewBag.Title = "Gestión de Roles y Permisos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .right_col {
        background: #f4f6f9;
        min-height: calc(100vh - 70px);
    }
</style>

<div class="right_col" role="main">
    <div class="">
        <div class="page-title">
            <div class="title_left">
                <h3>Gestión de Roles y Permisos <small>Control de acceso y funcionalidades</small></h3>
            </div>
            <div class="title_right">
                <div class="col-md-5 col-sm-5 col-xs-12 form-group pull-right top_search">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Buscar rol o trabajador..." id="rol-txt-buscar">
                        <span class="input-group-btn">
                            <button class="btn btn-default" type="button" id="rol-btn-buscar">Go!</button>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>

        <div id="contenedor-dashboard"></div>

        <div class="x_panel" style="margin-top:20px;">
            <div class="x_content">
                <div class="row" style="margin-bottom: 20px;">
                    <div class="col-md-6">
                        <button type="button" class="btn btn-primary" id="rol-btn-crear">
                            <i class="fa fa-plus"></i> Crear Rol
                        </button>
                        <button type="button" class="btn btn-success" id="rol-btn-asignar">
                            <i class="fa fa-user-plus"></i> Asignar Rol
                        </button>
                        <button type="button" class="btn btn-info" id="rol-btn-permisos">
                            <i class="fa fa-shield"></i> Gestionar Permisos
                        </button>
                    </div>
                    <div class="col-md-6 text-right">
                        <button type="button" class="btn btn-warning" id="rol-btn-exportar">
                            <i class="fa fa-file-excel-o"></i> Exportar Roles
                        </button>
                        <button type="button" class="btn btn-default" id="rol-btn-refresh">
                            <i class="fa fa-refresh"></i> Actualizar
                        </button>
                    </div>
                </div>

                <div id="contenedor-tabla"></div>

                <div style="margin-top:20px;" id="contenedor-asignaciones"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(function () {

            cargarDashboard();
            cargarTabla();
            cargarAsignaciones();

            function cargarDashboard() {
                $.get('@Url.Action("Resumen","Roles")', function (html) {
                    $('#contenedor-dashboard').html(html);
                });
            }

            function cargarTabla(criterio, estado) {
                $.get('@Url.Action("Tabla","Roles")', { criterio: criterio, estado: estado }, function (html) {
                    $('#contenedor-tabla').html(html);
                });
            }

            function cargarAsignaciones() {
                $.get('@Url.Action("Asignaciones","Roles")', function (html) {
                    $('#contenedor-asignaciones').html(html);
                });
            }

            // refrescar
            $('#rol-btn-refresh').on('click', function () {
                cargarDashboard();
                cargarTabla();
                cargarAsignaciones();
            });
                        $(document).on('click', '#rol-btn-asignar', function () {
                $.get('@Url.Action("Asignar","Roles")', function (html) {
                    $('#modalRolesContent').html(html);
                    $('#modalRoles').modal('show');
                }).fail(function () {
                    alert('No se pudo abrir el formulario de asignación.');
                });
            });

            // buscar
            $('#rol-btn-buscar').on('click', function () {
                var c = $('#rol-txt-buscar').val();
                cargarTabla(c, null);
            });

            // ✅ abrir modal "Crear Rol" (CORREGIDO)
            $(document).on('click', '#rol-btn-crear', function () {
                $.get('@Url.Action("Crear","Roles")', function (html) {
                    $('#modalRolesContent').html(html);
                    $('#modalRoles').modal('show');
                }).fail(function () {
                    alert('No se pudo abrir el formulario de rol.');
                });
            });

            // permisos (esto sí puede ir directo a una vista si quieres)
            $(document).on('click', '#rol-btn-permisos', function () {
                $.get('@Url.Action("MatrizPermisos","Roles")', function (html) {
                    $('#modalRolesContent').html(html);
                    $('#modalRoles').modal('show');
                }).fail(function () {
                    alert('No se pudo cargar la matriz de permisos.');
                });
            });

        });
    </script>

    <!-- modal global -->
    <div class="modal fade" id="modalRoles" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" id="modalRolesContent">
            </div>
        </div>
    </div>
}

