@{
    ViewBag.Title = "Dashboard y Reportes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="right_col" role="main">
    <div class="">
        <div class="page-title">
            <div class="title_left">
                <h3>Dashboard y Reportes</h3>
                <p class="text-muted">Análisis de ocupación y auditoría operativa</p>
            </div>
        </div>
        <div class="clearfix"></div>

        <div id="divDashboardReportes"></div>
        <div id="divReportesOperativos" style="margin-top:15px;"></div>
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            $("#divDashboardReportes").load("@Url.Action("_DashboardReportes", "Reportes")");
            $("#divReportesOperativos").load("@Url.Action("_ReportesOperativos", "Reportes")");
        });
    </script>
}
