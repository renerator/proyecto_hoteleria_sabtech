@model IEnumerable<Front_Hoteleria.Dto.Reserva.ReservaDto>

<style>
    .table-header-reserva {
        padding: 15px 20px;
        border-bottom: 1px solid #e5e5e5;
        background: #fff;
        border-radius: 8px 8px 0 0;
    }

    .status-pill {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: .75rem;
        font-weight: 600;
    }

    /* Pendiente (amarillo tipo ejemplo) */
    .st-pendiente {
        background: #fff3cd;
        color: #856404;
    }

    /* Confirmada (amarillo) */
    .st-confirmada {
        background: #ffeeba;
        color: #8a6d3b;
    }

    /* Rechazada (rojo) */
    .st-rechazada {
        background: #f8d7da;
        color: #721c24;
    }

    /* Realizada (celeste) */
    .st-realizada {
        background: #cce5ff;
        color: #004085;
    }
</style>

<div class="table-header-reserva">
    <h4 style="margin:0;"><i class="fa fa-list"></i> Listado de Todas las Reservas</h4>
</div>

<div class="table-responsive" style="background:#fff; border:1px solid #e5e5e5; border-top:0; border-radius:0 0 8px 8px; padding:15px 20px 20px 20px;">
    <table class="table table-striped table-bordered" id="tablaReservas" style="width:100%;">
        <thead>
            <tr>
                <th>Id Reserva</th>
                <th>Fecha Entrada</th>
                <th>Fecha Salida</th>
                <th>Huésped</th>
                <th>Tipo Habitación</th>
                <th>Huéspedes</th>
                <th>Estado</th>
                <th style="width:140px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var r in Model)
                {
                    // clase según el texto del estado
                    var cls =
                        string.Equals(r.EstadoReserva, "Pendiente", System.StringComparison.OrdinalIgnoreCase) ? "st-pendiente" :
                        string.Equals(r.EstadoReserva, "Rechazada", System.StringComparison.OrdinalIgnoreCase) ? "st-rechazada" :
                        string.Equals(r.EstadoReserva, "Confirmada", System.StringComparison.OrdinalIgnoreCase) ? "st-confirmada" :
                        string.Equals(r.EstadoReserva, "Realizada", System.StringComparison.OrdinalIgnoreCase) ? "st-realizada" :
                        "st-pendiente";

                    // fallback por si algunos campos vienen nulos/vacíos
                    var codigo = !string.IsNullOrWhiteSpace(r.Codigo) ? r.Codigo : r.IdReserva.ToString();
                    var nombreHuesped = !string.IsNullOrWhiteSpace(r.NombreHuesped) ? r.NombreHuesped : r.HuespedNombre;
                    var tipoHab = !string.IsNullOrWhiteSpace(r.TipoHabitacion) ? r.TipoHabitacion : r.TipoHabitacionNombre;

                    <tr>
                        <td><strong>@r.IdReserva</strong></td>
                        <td>@(r.FechaDesde.HasValue ? r.FechaDesde.Value.ToString("dd/MM/yyyy") : "")</td>
                        <td>@(r.FechaHasta.HasValue ? r.FechaHasta.Value.ToString("dd/MM/yyyy") : "")</td>

                        <td>@nombreHuesped</td>
                        <td>@tipoHab</td>
                        <td>@r.Huespedes</td>

                        <td>
                            <span class="status-pill @cls">
                                @r.EstadoReserva
                            </span>
                        </td>

                        <td>
                            <button class="btn btn-success btn-xs btn-asignar-reserva" data-id="@r.IdReserva">
                                <i class="fa fa-check"></i> Asignar
                            </button>
                            <button class="btn btn-danger btn-xs btn-rechazar-reserva" data-id="@r.IdReserva">
                                <i class="fa fa-times"></i> Rechazar
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">No hay reservas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    $(function () {
        $('#tablaReservas').DataTable({
            destroy: true,
            pageLength: 10,
            language: {
                url: '//cdn.datatables.net/plug-ins/1.10.24/i18n/Spanish.json'
            }
        });
    });
</script>
