<table id="tablaReservas" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Fecha Desde</th>
            <th>Fecha Hasta</th>
            <th>Hora llegada</th>
            <th style="width:140px">Opciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var r in Model)
            {
                <tr>
                    <td>@r.Nombre</td>
                    <td>@r.Apellido</td>
                    <td>@r.FechaDesde:yyyy/MM/dd</td>
                    <td>@r.FechaHasta:yyyy/MM/dd</td>
                    <td>@r.HoraLlegada</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-success"
                                title="Aprobar"
                                onclick="new PNotify({title:'Aprobar',text:'Reserva aprobada.',type:'success',styling:'bootstrap3'});">
                            <i class="fa fa-check-square-o"></i>
                        </button>

                        <button type="button" class="btn btn-warning btn-res-editar"
                                title="Editar" data-id="@r.Id">
                            <i class="fa fa-edit"></i>
                        </button>

                        <button type="button" class="btn btn-danger btn-res-eliminar"
                                title="Rechazar" data-id="@r.Id">
                            <i class="fa fa-trash-o"></i>
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Sin datos para mostrar.</td>
            </tr>
        }
    </tbody>
</table>

