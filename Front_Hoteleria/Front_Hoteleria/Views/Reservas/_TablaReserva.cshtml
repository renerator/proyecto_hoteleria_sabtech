@model IEnumerable<Front_Hoteleria.Dto.Reserva.ReservaDto>

<style>
    .table-header-reserva {
        padding: 15px 20px;
        border-bottom: 1px solid #e5e5e5;
        background: #fff;
        border-radius: 8px 8px 0 0;
    }

    .status-pill {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: .75rem;
        font-weight: 600;
    }
    .st-pendiente { background: #fff3cd; color: #856404; }
    .st-confirmada { background: #d4edda; color: #155724; }
    .st-rechazada { background: #f8d7da; color: #721c24; }
</style>

<div class="table-header-reserva">
    <h4 style="margin:0;"><i class="fa fa-list"></i> Listado de Reservas Pendientes</h4>
</div>

<div class="table-responsive" style="background:#fff; border:1px solid #e5e5e5; border-top:0; border-radius:0 0 8px 8px; padding:15px 20px 20px 20px;">
    <table class="table table-striped table-bordered" id="tablaReservas" style="width:100%;">
        <thead>
            <tr>
                <th>ID Reserva</th>
                <th>Fecha Entrada</th>
                <th>Fecha Salida</th>
                <th>Huésped</th>
                <th>Tipo Habitación</th>
                <th>Huéspedes</th>
                <th>Estado</th>
                <th style="width:140px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var r in Model)
                {
                    var cls =
                        string.Equals(r.Estado, "pendiente", System.StringComparison.OrdinalIgnoreCase) ? "st-pendiente" :
                        string.Equals(r.Estado, "rechazada", System.StringComparison.OrdinalIgnoreCase) ? "st-rechazada" :
                        "st-confirmada";

                    <tr>
                        <td><strong>@r.Id</strong></td>
                        <td>@r.FechaEntrada.ToString("dd/MM/yyyy")</td>
                        <td>@r.FechaSalida.ToString("dd/MM/yyyy")</td>
                        <td>@r.HuespedNombre</td>
                        <td>@r.TipoHabitacionNombre</td>
                        <td>@r.CantidadPersonas</td>
                        <td><span class="status-pill @cls">@r.Estado</span></td>
                        <td>
                            <button class="btn btn-success btn-xs btn-asignar-reserva" data-id="@r.Id">
                                <i class="fa fa-check"></i> Asignar
                            </button>
                            <button class="btn btn-danger btn-xs btn-rechazar-reserva" data-id="@r.Id">
                                <i class="fa fa-times"></i> Rechazar
                            </button>

                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">No hay reservas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    $(function () {
        $('#tablaReservas').DataTable({
            destroy: true,
            pageLength: 10,
            language: {
                url: '//cdn.datatables.net/plug-ins/1.10.24/i18n/Spanish.json'
            }
        });
    });
</script>
