@model IEnumerable<Front_Hoteleria.Dto.Reserva.ReservaDto>

<style>
    .table-header-reserva {
        padding: 15px 20px;
        border-bottom: 1px solid #e5e5e5;
        background: #fff;
        border-radius: 8px 8px 0 0;
    }

    .status-pill {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: .75rem;
        font-weight: 600;
    }

    .st-pendiente {
        background: #fff3cd;
        color: #856404;
    }

    .st-confirmada {
        background: #ffeeba;
        color: #8a6d3b;
    }

    .st-rechazada {
        background: #f8d7da;
        color: #721c24;
    }

    .st-realizada {
        background: #cce5ff;
        color: #004085;
    }

    th.col-acciones,
    td.col-acciones {
        width: 200px;
        white-space: nowrap;
    }
</style>

<div class="table-header-reserva">
    <h4 style="margin:0;"><i class="fa fa-list"></i> Listado de Todas las Reservas</h4>
</div>

<div class="table-responsive" style="background:#fff; border:1px solid #e5e5e5; border-top:0; border-radius:0 0 8px 8px; padding:15px 20px 20px 20px;">
    <table class="table table-striped table-bordered" id="tablaReservas" style="width:100%;">
        <thead>
            <tr>
                <th>Id Reserva</th>
                <th>Fecha Entrada</th>
                <th>Fecha Salida</th>
                <th>Huésped</th>
                <th>Tipo Habitación</th>
                <th>Huéspedes</th>
                <th>Estado</th>
                <th class="col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var r in Model)
                {
                    var esPendiente = string.Equals(r.EstadoReserva, "Pendiente", System.StringComparison.OrdinalIgnoreCase);
                    var esRechazada = string.Equals(r.EstadoReserva, "Rechazada", System.StringComparison.OrdinalIgnoreCase);
                    var esConfirmada = string.Equals(r.EstadoReserva, "Confirmada", System.StringComparison.OrdinalIgnoreCase);
                    var esRealizada = string.Equals(r.EstadoReserva, "Realizada", System.StringComparison.OrdinalIgnoreCase);

                    var cls =
                        esPendiente ? "st-pendiente" :
                        esRechazada ? "st-rechazada" :
                        esConfirmada ? "st-confirmada" :
                        esRealizada ? "st-realizada" :
                                       "st-pendiente";

                    var codigo = $"RES-{@r.IdReserva:000}";
                    var nombreHuesped = !string.IsNullOrWhiteSpace(r.NombreHuesped) ? r.NombreHuesped : r.HuespedNombre;
                    var tipoHab = !string.IsNullOrWhiteSpace(r.TipoHabitacion) ? r.TipoHabitacion : r.TipoHabitacionNombre;

                    <tr>
                        <td>@codigo</td>
                        <td>@(r.FechaDesde.HasValue ? r.FechaDesde.Value.ToString("dd/MM/yyyy") : "")</td>
                        <td>@(r.FechaHasta.HasValue ? r.FechaHasta.Value.ToString("dd/MM/yyyy") : "")</td>
                        <td>@nombreHuesped</td>
                        <td>@tipoHab</td>
                        <td>@r.CantidadPersonas</td>

                        <td>
                            <span class="status-pill @cls">
                                @if (esPendiente)
                                {
                                    <i class="fa fa-clock-o" style="margin-right:4px;"></i>
                                }
                                @r.EstadoReserva
                            </span>
                        </td>

                        <td class="col-acciones">
                            @* 1) CONFIRMADA: ambos botones deshabilitados *@
                            @if (esConfirmada)
                            {
                                <button class="btn btn-success btn-xs btn-asignar-reserva" disabled="disabled" title="La reserva ya está confirmada">
                                    <i class="fa fa-check"></i> Asignar
                                </button>
                                <button class="btn btn-danger btn-xs btn-rechazar-reserva" disabled="disabled" title="La reserva ya está confirmada">
                                    <i class="fa fa-ban"></i> Rechazar
                                </button>
                            }
                            @* 2) RECHAZADA: Asignar habilitado, Rechazar deshabilitado *@
                            else if (esRechazada)
                            {
                                <button class="btn btn-success btn-xs btn-asignar-reserva" disabled="disabled" data-id="@r.IdReserva">
                                    <i class="fa fa-check"></i> Asignar
                                </button>
                                <button class="btn btn-danger btn-xs btn-rechazar-reserva" disabled="disabled" title="La reserva ya fue rechazada">
                                    <i class="fa fa-times"></i> Rechazada
                                </button>
                            }
                            @* 3) Cualquier otro estado: ambos habilitados *@
                            else
                            {
                                <button class="btn btn-success btn-xs btn-asignar-reserva" data-id="@r.IdReserva">
                                    <i class="fa fa-check"></i> Asignar
                                </button>
                                <button class="btn btn-danger btn-xs btn-rechazar-reserva" data-id="@r.IdReserva">
                                    <i class="fa fa-times"></i> Rechazar
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">No hay reservas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    $(function () {
        $('#tablaReservas').DataTable({
            destroy: true,
            pageLength: 10,
            language: {
                url: '//cdn.datatables.net/plug-ins/1.10.24/i18n/Spanish.json'
            }
        });
    });
</script>
