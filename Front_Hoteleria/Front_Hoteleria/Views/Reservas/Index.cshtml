    <script>
    // ===== ENDPOINTS =====
    const urlTablaReserva  = '@Url.Action("TablaPartial","Reservas")';
    const urlDashboardView = '@Url.Action("Dashboard","Reservas")';
    const urlUpsertReserva = '@Url.Action("Upsert","Reservas")';
    const urlEliminar      = '@Url.Action("Eliminar","Reservas")';

    function token(){ return $('input[name="__RequestVerificationToken"]').first().val(); }
    if (window.PNotify) { PNotify.prototype.options.styling = "bootstrap3"; }

    // ===== DATE RANGE para la tabla =====
    $('#dateRange').daterangepicker({
      startDate: moment().startOf('month'),
      endDate: moment().endOf('day'),
      locale:{ format:'DD/MM/YYYY', applyLabel:'Aplicar', cancelLabel:'Cancelar' }
    });

    // ===== DASHBOARD (carga del parcial con manejo de error) =====
    function cargarDashboardView(){
      $('#dashContainerReserva').html('<div class="text-muted">Cargando dashboard…</div>');
      $('#dashContainerReserva').load(urlDashboardView, function(responseText, textStatus, xhr){
        if (textStatus === 'error' || (xhr && xhr.status >= 400)) {
          const code = (xhr && xhr.status) ? ` (${xhr.status})` : '';
          const msg  = (xhr && xhr.statusText) ? xhr.statusText : 'Error';
          const body = (xhr && xhr.responseText) ? $('<div>').text(xhr.responseText).html() : '';
          $('#dashContainerReserva').html(
            `<div class="text-danger">
               <strong>No se pudo cargar el dashboard${code}:</strong> ${msg}<br/>
               <small>${body}</small><br/>
               <button type="button" class="btn btn-link p-0" id="retryDashboardBtn">Reintentar</button>
             </div>`
          );
          if (window.PNotify) {
            new PNotify({ title:'Dashboard', text:`Error${code}: ${msg}`, type:'error', styling:'bootstrap3' });
          }
        }
      });
    }
    $(document).on('click', '#retryDashboardBtn', function(){ cargarDashboardView(); });

    // ===== TABLA =====
    function initDataTable(){
      const $t = $('#tablaReservas').length ? $('#tablaReservas') : $('#reservationsTable');
      if(!$t.length) return;
      $t.DataTable({
        destroy:true, responsive:true, pageLength:25, order:[[0,'desc']],
        columnDefs:[{ orderable:false, targets:8 }],
        language:{
          sProcessing:"Procesando...", sLengthMenu:"Mostrar _MENU_ registros", sZeroRecords:"No se encontraron resultados",
          sEmptyTable:"Ningún dato disponible en esta tabla", sInfo:"Mostrando _START_ a _END_ de _TOTAL_",
          sInfoEmpty:"Mostrando 0 a 0 de 0", sInfoFiltered:"(filtrado de _MAX_ registros)", sSearch:"Buscar:",
          oPaginate:{ sFirst:"Primero", sLast:"Último", sNext:"Siguiente", sPrevious:"Anterior" }
        }
      });
    }

    function buildTablaPayload(){
      let fechaDesdeISO=null, fechaHastaISO=null;
      const picker=$('#dateRange').data('daterangepicker');
      if(picker){
        fechaDesdeISO = picker.startDate.clone().startOf('day').toISOString();
        fechaHastaISO = picker.endDate.clone().endOf('day').toISOString();
      }
      return { __RequestVerificationToken: token(), fechaDesde: fechaDesdeISO, fechaHasta: fechaHastaISO };
    }

    function cargarTabla(){
      $('#tablaReservaContainer').html('<div class="text-muted">Cargando reservas…</div>');
      $.ajax({
        url: urlTablaReserva, type:'POST', data: buildTablaPayload(),
        success: function(html){ $('#tablaReservaContainer').html(html); initDataTable(); },
        error: function(xhr){
          const msg = (xhr.status===401) ? 'Sesión expirada. Vuelva a iniciar sesión.' : 'No se pudo cargar el listado.';
          $('#tablaReservaContainer').html('<div class="text-danger">'+msg+'</div>');
        }
      });
    }

    // ===== BOTONES =====
    $('#refreshDataBtn').on('click', function(){
      cargarDashboardView();
      cargarTabla();
      new PNotify({ title:'Datos Actualizados', text:'La información ha sido actualizada correctamente', type:'success' });
    });

    $('#btnNueva').on('click', function(){
      $('#modalUpsertReserva').modal('show');
      $('#upsertReservaBody').html('<div class="text-muted">Cargando…</div>').load(urlUpsertReserva);
    });
        // Manejo del submit del form dentro del modal (delegado)
        $('#upsertReservaBody').on('submit', '#formCrearReserva', function (e) {
            e.preventDefault();
            var $form = $(this);
            var data = $form.serialize();

            $.ajax({
                url: $form.attr('action'),
                type: 'POST',
                data: data
            })
                .done(function (r) {
                    if (r && r.ok) {
                        $('#modalUpsertReserva').modal('hide');
                        // refresca tabla
                        if (typeof cargarTabla === 'function') cargarTabla();
                        if (window.PNotify) new PNotify({ title: 'Reserva', text: 'Reserva creada correctamente', type: 'success', styling: 'bootstrap3' });
                    } else {
                        // si el server devolvió el parcial con validaciones, vuelves a renderizar
                        $('#upsertReservaBody').html(r);
                    }
                })
                .fail(function (xhr) {
                    var msg = xhr.responseText || 'No se pudo crear la reserva';
                    if (window.PNotify) new PNotify({ title: 'Error', text: msg, type: 'error', styling: 'bootstrap3' });
                });
        });
    // ===== INIT =====
    $(function(){
      cargarDashboardView(); // solo el parcial de KPIs
      cargarTabla();         // la tabla con el rango inicial
    });
    </script>
}
