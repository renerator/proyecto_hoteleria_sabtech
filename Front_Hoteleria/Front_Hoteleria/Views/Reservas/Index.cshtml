@{
    ViewData["Title"] = "Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/vendors/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/vendors/font-awesome/css/font-awesome.min.css" />
<link rel="stylesheet" href="~/vendors/datatables.net-bs/css/dataTables.bootstrap.min.css" />
<link rel="stylesheet" href="~/vendors/pnotify/dist/pnotify.css" />
<link rel="stylesheet" href="~/vendors/pnotify/dist/pnotify.buttons.css" />

<style>
    /* KPIs en tiempo real */
    .kpi-box{border-radius:8px;color:#fff;padding:16px 18px;margin-bottom:16px;position:relative;overflow:hidden}
    .kpi-title{font-size:18px;font-weight:600;display:flex;align-items:center;gap:8px;margin-bottom:8px;opacity:.95}
    .kpi-val{font-size:42px;font-weight:800;line-height:1}
    .bg-kpi-pend {background:linear-gradient(135deg,#f8b109,#f5a623)}
    .bg-kpi-conf {background:linear-gradient(135deg,#34c759,#2bb24c)}
    .bg-kpi-hotel{background:linear-gradient(135deg,#1890ff,#1677c5)}
    .bg-kpi-rech {background:linear-gradient(135deg,#f5515f,#d63031)}
    .bg-kpi-comp {background:linear-gradient(135deg,#7349d3,#5d2bbd)}
    .bg-kpi-ocup {background:linear-gradient(135deg,#10b981,#0e9f75)}
    .bg-kpi-dias {background:linear-gradient(135deg,#f59e0b,#f39c12)}
    .bg-kpi-total{background:linear-gradient(135deg,#6b7280,#4b5563)}

    /* Operativo / SLA */
    .ops-card{background:linear-gradient(180deg,#244e6a,#213f55);color:#eaf1f7;border-radius:12px;padding:18px 20px;margin-bottom:18px}
    .ops-badge{background:#ff6b6b;border-radius:999px;font-weight:700;padding:2px 8px;margin-left:8px}
    .ops-row{background:rgba(255,255,255,.08);border-radius:10px;padding:14px;margin-top:12px}
    .ops-progress{height:10px;background:#70879b;border-radius:20px;overflow:hidden}
    .ops-bar{height:100%;background:#22c55e;width:72%}
    .ops-alert{background:rgba(255,255,255,.08);border-left:4px solid #f87171;border-radius:8px;padding:12px 14px;margin-top:12px}

    /* Helpers */
    .panel_toolbox > li > a{cursor:pointer}
    .btn-icon{display:inline-flex;align-items:center;gap:6px}
</style>

<div class="right_col" role="main">
    <div class="">
        <!-- ======= TOP TILES ======= -->
        <div class="row top_tiles">
            <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="tile-stats">
                    <div class="icon"><i class="fa fa-check-square"></i></div>
                    <div id="kpiNuevas" class="count">0</div>
                    <h3>Nuevas Reservas ingresadas</h3>
                    <p>Reservas que requieren atención.</p>
                </div>
            </div>
            <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="tile-stats">
                    <div class="icon"><i class="fa fa-comments-o"></i></div>
                    <div id="kpiServicios" class="count">0</div>
                    <h3>Servicios</h3>
                    <p>Servicios por atender.</p>
                </div>
            </div>
            <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="tile-stats">
                    <div class="icon"><i class="fa fa-sort-amount-desc"></i></div>
                    <div id="kpiCheckIn" class="count">0</div>
                    <h3>New Check In</h3>
                    <p>Reservas confirmadas de llegada.</p>
                </div>
            </div>
            <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="tile-stats">
                    <div class="icon"><i class="fa fa-check-square-o"></i></div>
                    <div id="kpiCheckOut" class="count">0</div>
                    <h3>Check Out</h3>
                    <p>Reservas con salida registrada.</p>
                </div>
            </div>
        </div>

        <!-- ======= RESERVAS X FECHA (DASHBOARD) ======= -->
        <div class="row">
            <div class="col-md-12">
                <div class="x_panel">
                    <div class="x_title">
                        <h2>Reservas x Fecha <small>Progreso Semanal</small></h2>
                        <div class="filter">
                            <!-- Rango de fechas estilo Gentelella -->
                            <div id="reportrange" class="pull-right"
                                 style="background:#fff; cursor:pointer; padding:5px 10px; border:1px solid #ccc">
                                <i class="glyphicon glyphicon-calendar fa fa-calendar"></i>
                                <span id="lblRango">Seleccione un rango</span> <b class="caret"></b>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                    </div>

                    <div class="x_content">
                        <!-- Contenido dinámico del dashboard desde _DashboardReserva -->
                        <div id="dashContainerReserva">
                            <div class="text-muted">Cargando dashboard…</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Acciones superiores -->
        <div class="x_title" style="margin-top:6px">
            <h2>Reservas <small>Listado de Reservas en línea</small></h2>
            <ul class="nav navbar-right panel_toolbox">
                <li><a class="collapse-link"><i class="fa fa-chevron-up"></i></a></li>
                <li><a class="close-link"><i class="fa fa-close"></i></a></li>
            </ul>
            <div class="clearfix"></div>
        </div>

        <div class="row" style="margin-bottom:8px">
            <div class="col-sm-12" style="display:flex;gap:10px;flex-wrap:wrap">
                @Html.AntiForgeryToken()
                <button id="btnNuevaReserva" class="btn btn-primary btn-icon" data-toggle="modal" data-target="#modalUpsertReserva"><i class="fa fa-plus"></i>Crear Nueva Reserva</button>
                <button id="btnFiltros" class="btn btn-info btn-icon"><i class="fa fa-filter"></i>Filtros</button>
                <button id="btnLimpiarFiltros" class="btn btn-default btn-icon"><i class="fa fa-undo"></i>Limpiar Filtros</button>
            </div>
        </div>

        <!-- ====== 1) ESTADÍSTICAS DE RESERVAS EN TIEMPO REAL ====== -->
        <div class="x_panel">
            <div class="x_title">
                <h2><i class="fa fa-line-chart"></i> Estadísticas de Reservas en Tiempo Real</h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li><a class="collapse-link"><i class="fa fa-chevron-up"></i></a></li>
                    <li><a class="close-link"><i class="fa fa-close"></i></a></li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <div class="row">
                    <div class="col-md-3 col-sm-6"><div class="kpi-box bg-kpi-pend"><div class="kpi-title"><i class="fa fa-clock-o"></i> Pendientes</div><div id="kpiPend" class="kpi-val">0</div></div></div>
                    <div class="col-md-3 col-sm-6"><div class="kpi-box bg-kpi-conf"><div class="kpi-title"><i class="fa fa-check-circle"></i> Confirmadas</div><div id="kpiConf" class="kpi-val">0</div></div></div>
                    <div class="col-md-3 col-sm-6"><div class="kpi-box bg-kpi-hotel"><div class="kpi-title"><i class="fa fa-bed"></i> En Hotel</div><div id="kpiHotel" class="kpi-val">0</div></div></div>
                    <div class="col-md-3 col-sm-6"><div class="kpi-box bg-kpi-rech"><div class="kpi-title"><i class="fa fa-times-circle"></i> Rechazadas</div><div id="kpiRech" class="kpi-val">0</div></div></div>
                    <div class="col-md-3 col-sm-6"><div class="kpi-box bg-kpi-comp"><div class="kpi-title"><i class="fa fa-calendar-check-o"></i> Completadas</div><div id="kpiComp" class="kpi-val">0</div></div></div>
                    <div class="col-md-3 col-sm-6"><div class="kpi-box bg-kpi-ocup"><div class="kpi-title"><i class="fa fa-percent"></i> Tasa Ocupación</div><div id="kpiOcup" class="kpi-val">0%</div></div></div>
                    <div class="col-md-3 col-sm-6"><div class="kpi-box bg-kpi-dias"><div class="kpi-title"><i class="fa fa-clock-o"></i> Días Promedio</div><div id="kpiDias" class="kpi-val">0</div></div></div>
                    <div class="col-md-3 col-sm-6"><div class="kpi-box bg-kpi-total"><div class="kpi-title"><i class="fa fa-users"></i> Total Reservas</div><div id="kpiTotalRes" class="kpi-val">0</div></div></div>
                </div>

                <div class="alert alert-info" style="display:flex;align-items:center;justify-content:space-between;margin-top:10px">
                    <div><strong><i class="fa fa-refresh"></i> Actualización en tiempo real:</strong> Las estadísticas se actualizan automáticamente cada 30 segundos. <span id="lblUltAct"></span></div>
                    <button id="btnKpiRefresh" class="btn btn-primary btn-sm btn-icon"><i class="fa fa-refresh"></i> Actualizar Ahora</button>
                </div>
            </div>
        </div>

        <!-- ====== 2) CONTROL DE CHECK-IN / CHECK-OUT ====== -->
        <div class="x_panel">
            <div class="x_title"><h2><i class="fa fa-sign-in"></i> Control de Check-in/Check-out</h2><div class="clearfix"></div></div>
            <div class="x_content">
                <div class="row">
                    <div class="col-md-6">
                        <div class="panel panel-success">
                            <div class="panel-heading"><i class="fa fa-sign-in"></i> Check-in Masivo</div>
                            <div class="panel-body">
                                <div class="form-group">
                                    <label>Fecha de Check-in:</label>
                                    <div class="input-group">
                                        <input id="chkInFecha" type="text" class="form-control" placeholder="dd-mm-aaaa">
                                        <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Hora de Check-in:</label>
                                    <div class="input-group">
                                        <input id="chkInHora" type="time" class="form-control" value="15:00">
                                        <span class="input-group-addon"><i class="fa fa-clock-o"></i></span>
                                    </div>
                                </div>
                                <button id="btnChkInMasivo" class="btn btn-success btn-block btn-icon"><i class="fa fa-sign-in"></i> Check-in Masivo</button>
                                <small class="text-muted">Afectará todas las reservas confirmadas para la fecha seleccionada</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="panel panel-warning">
                            <div class="panel-heading"><i class="fa fa-sign-out"></i> Check-out Masivo</div>
                            <div class="panel-body">
                                <div class="form-group">
                                    <label>Fecha de Check-out:</label>
                                    <div class="input-group">
                                        <input id="chkOutFecha" type="text" class="form-control" placeholder="dd-mm-aaaa">
                                        <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Hora de Check-out:</label>
                                    <div class="input-group">
                                        <input id="chkOutHora" type="time" class="form-control" value="11:00">
                                        <span class="input-group-addon"><i class="fa fa-clock-o"></i></span>
                                    </div>
                                </div>
                                <button id="btnChkOutMasivo" class="btn btn-warning btn-block btn-icon"><i class="fa fa-sign-out"></i> Check-out Masivo</button>
                                <small class="text-muted">Afectará todas las reservas en hotel para una fecha</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info" style="margin-top:6px">
                    <strong><i class="fa fa-info-circle"></i> Información</strong>
                    <ul style="margin:6px 0 0 18px">
                        <li><b>Check-in Individual:</b> Use los botones en la tabla de reservas</li>
                        <li><b>Check-out Individual:</b> Use los botones en la tabla de reservas</li>
                        <li><b>Check-in Masivo:</b> Procesa todas las reservas confirmadas para una fecha</li>
                        <li><b>Check-out Masivo:</b> Procesa todas las reservas en hotel para una fecha</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- ====== 3) GESTIÓN NO-SHOW Y EXTENSIONES ====== -->
        <div class="x_panel">
            <div class="x_title"><h2><i class="fa fa-user-times"></i> Gestión de No-Show y Extensiones</h2><div class="clearfix"></div></div>
            <div class="x_content">
                <div class="row">
                    <div class="col-md-6">
                        <div class="panel panel-danger">
                            <div class="panel-heading"><i class="fa fa-user-times"></i> Reportar No-Show</div>
                            <div class="panel-body">
                                <div class="form-group"><label>Seleccionar Reserva:</label><select class="form-control"><option>Seleccionar reserva...</option></select></div>
                                <div class="form-group"><label>Motivo del No-Show:</label><select class="form-control"><option>Seleccionar motivo...</option></select></div>
                                <div class="form-group"><label>Comentarios adicionales:</label><textarea class="form-control" rows="3" placeholder="Comentarios adicionales..."></textarea></div>
                                <button id="btnNoShow" class="btn btn-danger btn-block btn-icon"><i class="fa fa-user-times"></i> Reportar No-Show</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="panel panel-info">
                            <div class="panel-heading"><i class="fa fa-calendar-plus-o"></i> Solicitar Extensión</div>
                            <div class="panel-body">
                                <div class="form-group"><label>Seleccionar Reserva:</label><select class="form-control"><option>Seleccionar reserva...</option></select></div>
                                <div class="form-group"><label>Días adicionales:</label><input type="number" class="form-control" value="1" min="1" /></div>
                                <div class="form-group"><label>Nueva fecha de salida:</label><input type="text" class="form-control" placeholder="dd-mm-aaaa" disabled /></div>
                                <div class="form-group"><label>Motivo de la extensión:</label><select class="form-control"><option>Seleccionar motivo...</option></select></div>
                                <button id="btnExtension" class="btn btn-info btn-block btn-icon"><i class="fa fa-calendar-plus-o"></i> Solicitar Extensión</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="x_panel" style="margin-top:8px">
                    <div class="x_title"><h2><i class="fa fa-history"></i> Historial de No-Show y Extensiones</h2><div class="clearfix"></div></div>
                    <div class="x_content">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr><th>Fecha</th><th>Huésped</th><th>Tipo</th><th>Motivo</th><th>Comentarios</th><th>Usuario</th></tr>
                            </thead>
                            <tbody><tr><td colspan="6" class="text-center text-muted">Sin registros.</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ====== 4) CONTROL OPERATIVO (SLA) ====== -->
        <div class="ops-card">
            <div style="display:flex;align-items:center;justify-content:space-between">
                <h3 style="margin:0;display:flex;align-items:center;gap:10px"><i class="fa fa-exclamation-triangle"></i> Control Operativo <span class="ops-badge" id="opsCount">10</span></h3>
                <div>
                    <button id="btnOpsRefresh" class="btn btn-default btn-icon"><i class="fa fa-refresh"></i> Actualizar Alertas</button>
                    <button class="btn btn-warning btn-icon"><i class="fa fa-cog"></i> Configurar SLA</button>
                </div>
            </div>

            <div class="ops-row">
                <div style="display:flex;justify-content:space-between;margin-bottom:6px">
                    <strong><i class="fa fa-clock-o"></i> Monitor de SLA</strong>
                    <small><span style="color:#22c55e">✓ Dentro de SLA</span>&nbsp;&nbsp;&nbsp;<span style="color:#f59e0b">⚠ Próximo al límite</span>&nbsp;&nbsp;&nbsp;<span style="color:#ef4444">✗ SLA Excedido</span></small>
                </div>
                <div class="ops-progress"><div class="ops-bar" id="opsBar" style="width:75%"></div></div>
            </div>

            <div class="ops-alert">
                <strong><i class="fa fa-clock-o"></i> SLA Excedido - Servicio de Concierge</strong>
                <div>El servicio de concierge ha superado el tiempo límite de 20 minutos.</div>
                <small>Hace 2 minutos</small><br />
                <div style="margin-top:8px">
                    <button class="btn btn-success btn-sm btn-icon"><i class="fa fa-check"></i> Resolver</button>
                    <button class="btn btn-default btn-sm btn-icon"><i class="fa fa-times"></i> Ignorar</button>
                </div>
            </div>
        </div>

        <!-- ====== 5) RESERVAS X FECHA ====== -->
        <div class="x_panel">
            <div class="x_title">
                <h2>Reservas x Fecha <small>Progreso Semanal</small></h2>
                <div class="filter">
                    <div id="reportrange" class="pull-right" style="background:#fff;cursor:pointer;padding:5px 10px;border:1px solid #ccc">
                        <i class="glyphicon glyphicon-calendar fa fa-calendar"></i>
                        <span id="lblRango">Seleccione un rango</span> <b class="caret"></b>
                    </div>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <!-- Parcial del dashboard -->
                <div id="dashContainerReserva"><div class="text-muted">Cargando dashboard…</div></div>
            </div>
        </div>

        <!-- ====== 6) RESUMEN SEMANAL (justo después de Reservas x Fecha) ====== -->
        <div class="x_panel">
            <div class="x_title">
                <h2>Resumen Semanal <small>Actividades de Reservas</small></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li><a class="collapse-link"><i class="fa fa-chevron-up"></i></a></li>
                    <li><a class="close-link"><i class="fa fa-close"></i></a></li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <div class="row" style="border-bottom:1px solid #E0E0E0;padding-bottom:5px;margin-bottom:5px;">
                    <div class="col-md-7" style="overflow:hidden;">
                        <div id="resumenSparklines" style="height:160px;padding:10px 25px;background:rgba(0,0,0,.02);border-radius:6px"></div>
                        <h4 style="margin:18px">Movimiento Semanal de reservas</h4>
                    </div>
                    <div class="col-md-5">
                        <div class="row" style="text-align:center;">
                            <div class="col-md-4"><canvas class="canvasDoughnut" height="110" width="110"></canvas><h4 style="margin:0">Solicitudes</h4></div>
                            <div class="col-md-4"><canvas class="canvasDoughnut" height="110" width="110"></canvas><h4 style="margin:0">Nuevas Reservas</h4></div>
                            <div class="col-md-4"><canvas class="canvasDoughnut" height="110" width="110"></canvas><h4 style="margin:0">Nuevos Servicios</h4></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ====== 7) TABLA DE RESERVAS (queda al final) ====== -->
        <div class="x_panel">
            <div class="x_title">
                <h2>Reservas <small>Listado</small></h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li><a class="collapse-link"><i class="fa fa-chevron-up"></i></a></li>
                    <li><a class="close-link"><i class="fa fa-close"></i></a></li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <div id="tablaReservaContainer" class="table-responsive"><div class="text-muted">Cargando reservas…</div></div>
            </div>
        </div>

    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="modalUpsertReserva" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                <h4 class="modal-title">Reserva</h4>
            </div>
            <div class="modal-body" id="upsertReservaBody"><div class="text-muted">Cargando…</div></div>
        </div>
    </div>
</div>

@section Scripts{
<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script src="~/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
<script src="~/vendors/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="~/vendors/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
<script src="~/vendors/pnotify/dist/pnotify.js"></script>
<script src="~/vendors/pnotify/dist/pnotify.buttons.js"></script>
<script src="~/vendors/moment/min/moment.min.js"></script>
<script src="~/vendors/bootstrap-daterangepicker/daterangepicker.js"></script>

<script>
  // Endpoints (ajusta si difieren)
  const urlDashReserva   = '@Url.Action("Dashboard","Reservas")';     // _DashboardReserva
  const urlTablaReserva  = '@Url.Action("TablaReserva","Reservas")';  // _TablaReserva
  const urlUpsertReserva = '@Url.Action("UpsertReserva","Reservas")';
  const urlDelReserva    = '@Url.Action("EliminarReserva","Reservas")';
  function token(){ return $('input[name="__RequestVerificationToken"]').first().val(); }

  // ===== KPIs tiempo real (mock refresco) =====
  function marcaHora(){ $('#lblUltAct').text('Última actualización: ' + moment().format('h:mm:ss a')); }
  function refrescarKpis(){ /* aquí puedes pedir KPIs al backend */ marcaHora(); }
  $('#btnKpiRefresh').on('click', refrescarKpis);
  setInterval(refrescarKpis, 30000);

  // ===== Check masivos / No-show / Extensión (placeholders) =====
  $('#btnChkInMasivo').on('click', ()=> new PNotify({title:'Check-in',text:'Check-in masivo ejecutado.',type:'success',styling:'bootstrap3'}));
  $('#btnChkOutMasivo').on('click',()=> new PNotify({title:'Check-out',text:'Check-out masivo ejecutado.',type:'success',styling:'bootstrap3'}));
  $('#btnNoShow').on('click',     ()=> new PNotify({title:'No-Show',text:'Registrado.',type:'error',styling:'bootstrap3'}));
  $('#btnExtension').on('click',  ()=> new PNotify({title:'Extensión',text:'Solicitud enviada.',type:'info',styling:'bootstrap3'}));
  $('#btnOpsRefresh').on('click', ()=> new PNotify({title:'Operativo',text:'Alertas actualizadas.',type:'info',styling:'bootstrap3'}));

  // ===== Dashboard por rango =====
  let desde=null,hasta=null;
  function cargarDashboard(){
    const qs = $.param({desde:desde||'',hasta:hasta||''});
    $('#dashContainerReserva').load(urlDashReserva + (qs?('?'+qs):''), function(resp,status){
      if(status==='error'){ $('#dashContainerReserva').html('<div class="text-danger">No se pudo cargar el dashboard.</div>'); }
    });
  }
  if($.fn.daterangepicker){
    const $r = $('#reportrange');
    function cb(start,end){
      desde = start.format('YYYY-MM-DD'); hasta = end.format('YYYY-MM-DD');
      $('#lblRango').text(start.format('MMMM D, YYYY') + ' - ' + end.format('MMMM D, YYYY'));
      cargarDashboard();
    }
    $r.daterangepicker({startDate:moment().startOf('month'),endDate:moment().endOf('month'),opens:'left',locale:{format:'YYYY-MM-DD'}}, cb);
    cb(moment().startOf('month'), moment().endOf('month'));
  } else { cargarDashboard(); }

  // ===== Tabla de reservas =====
  function cargarTabla(){
    $('#tablaReservaContainer').html('<div class="text-muted">Cargando reservas…</div>');
    $.ajax({
      url:urlTablaReserva,type:'POST',headers:{'RequestVerificationToken':token()},
      success:function(html){
        $('#tablaReservaContainer').html(html);
        const $t = $('#tablaReservas');
        if($t.length){
          $t.DataTable({destroy:true,responsive:true,language:{url:'//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'}});
        }
      },
      error:function(){ $('#tablaReservaContainer').html('<div class="text-danger">No se pudo cargar el listado.</div>'); }
    });
  }
  $('#btnNuevaReserva').on('click', function(){
    $('#upsertReservaBody').html('<div class="text-muted">Cargando…</div>').load(urlUpsertReserva);
  });
  $('#tablaReservaContainer').on('click','.btn-res-editar',function(){
    const id=$(this).data('id'); $('#modalUpsertReserva').modal('show');
    $('#upsertReservaBody').html('<div class="text-muted">Cargando…</div>').load(urlUpsertReserva+'?id='+id);
  });
  $('#tablaReservaContainer').on('click','.btn-res-eliminar',function(){
    const id=$(this).data('id'); if(!confirm('¿Eliminar la reserva seleccionada?')) return;
    $.post({url:urlDelReserva,headers:{'RequestVerificationToken':token()},data:{idReserva:id}})
     .done(()=>{ new PNotify({title:'Eliminar',text:'Reserva eliminada.',type:'success',styling:'bootstrap3'}); cargarTabla(); })
     .fail(xhr=> new PNotify({title:'Error',text:xhr.responseText||'No se pudo eliminar',type:'error',styling:'bootstrap3'}));
  });

  // ===== Inicialización =====
  $(function(){ refrescarKpis(); cargarTabla(); });
</script>
}
