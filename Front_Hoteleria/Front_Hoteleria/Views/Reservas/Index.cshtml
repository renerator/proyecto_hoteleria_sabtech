@{
    ViewBag.Title = "Gestión de Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .reservas-wrapper {
        background: transparent;
    }

    /* contenedor general debajo del título */
    .dash-wrapper-reserva {
        margin-bottom: 20px;
    }

    /* panel blanco genérico (para filtros y tabla) */
    .card-white {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        box-shadow: 0 2px 4px rgba(0,0,0,.03);
        margin-bottom: 20px;
    }

    /* título de filtros */
    .filtros-title {
        font-size: 16px;
        font-weight: 600;
        color: #6b7b8a;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .filtros-title i {
            font-size: 18px;
            color: #6b7b8a;
        }
</style>

<div class="right_col" role="main">
    <div class="reservas-wrapper">
        <!-- título -->
        <div class="page-title" style="margin-bottom:15px;">
            <div class="title_left">
                <h3 style="margin-bottom:0;">Gestión de Reservas</h3>
                <small>Administración de reservas pendientes de asignación</small>
            </div>
        </div>

        <!-- 👇 esto obliga a que lo que sigue vaya debajo del título -->
        <div class="clearfix"></div>

        <!-- DASHBOARD: SIN panel blanco -->
        <div id="dashContainerReserva" class="dash-wrapper-reserva">
            <div class="p-3">Cargando dashboard…</div>
        </div>

        <!-- FILTROS (aquí sí va el panel blanco) -->
        <div class="card-white" style="padding: 20px 20px 5px 20px;">
            @Html.AntiForgeryToken()

            <div class="filtros-title">
                <i class="fa fa-filter"></i> Filtros de Búsqueda
            </div>

            <div class="row">
                <div class="col-md-3">
                    <label>Fecha Inicio</label>
                    <input type="date" class="form-control" id="filtroFechaInicio" />
                </div>
                <div class="col-md-3">
                    <label>Fecha Fin</label>
                    <input type="date" class="form-control" id="filtroFechaFin" />
                </div>
                <div class="col-md-3">
                    <label>Estado</label>
                    <select class="form-control" id="filtroEstado">
                        <option value="0" selected>Todos</option>
                        <option value="1">Pendiente</option>
                        <option value="2">Confirmada</option>
                        <option value="3">Rechazada</option>
                        <option value="4">Realizada</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label>&nbsp;</label><br />
                    <button class="btn btn-primary" id="btnBuscarReservas">
                        <i class="fa fa-search"></i> Buscar
                    </button>
                    <button class="btn btn-success" id="btnNuevaReserva">
                        <i class="fa fa-plus"></i> Crear Nueva Reserva
                    </button>
                </div>
            </div>
            <br />
        </div>

        <!-- TABLA -->
        <div id="tablaReservaContainer" class="card-white" style="padding:0;">
            <div class="p-3">Cargando reservas…</div>
        </div>
    </div>
</div>

<!-- MODAL CREAR / EDITAR -->
<div class="modal fade" id="modalUpsertReserva" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="upsertReservaBody">
            <div class="p-3">Cargando…</div>
        </div>
    </div>
</div>

<!-- MODAL ASIGNAR -->
<div class="modal fade" id="modalAsignarReserva" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="asignarReservaBody">
            <div class="p-3">Cargando…</div>
        </div>
    </div>
</div>

<!-- MODAL RECHAZAR -->
<div class="modal fade" id="modalRechazarReserva" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="rechazarReservaBody">
            <div class="p-3">Cargando…</div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        // endpoints
        const urlDash    = '@Url.Action("Dashboard","Reservas")';
        const urlTabla   = '@Url.Action("TablaPartial","Reservas")';
        const urlUpsert  = '@Url.Action("Upsert","Reservas")';
        const urlAsignar = '@Url.Action("Asignar","Reservas")';
        const urlRechazar = '@Url.Action("Rechazar","Reservas")';

        function getToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function cargarDashboard() {
            $('#dashContainerReserva').load(urlDash);
        }

        // === ASIGNAR ===
        function abrirModalAsignar(idReserva) {
            $('#modalAsignarReserva').modal('show');
            $('#asignarReservaBody').html('<div class="p-3">Cargando…</div>');

            $.get(urlAsignar, { idReserva: idReserva }, function (html) {
                $('#asignarReservaBody').html(html);
            });
        }

        // === RECHAZAR ===
        function abrirModalRechazar(idReserva) {
            $('#modalRechazarReserva').modal('show');
            $('#rechazarReservaBody').html('<div class="p-3">Cargando…</div>');

            $.get(urlRechazar, { idReserva: idReserva }, function (html) {
                $('#rechazarReservaBody').html(html);
            });
        }

        // botones de la tabla (generados por AJAX en _TablaReserva.cshtml)
        $(document).on('click', '.btn-asignar-reserva', function () {
            var idReserva = parseInt($(this).data('id'), 10) || 0;
            abrirModalAsignar(idReserva);
        });

        $(document).on('click', '.btn-rechazar-reserva', function () {
            var idReserva = parseInt($(this).data('id'), 10) || 0;
            abrirModalRechazar(idReserva);
        });


        function cargarTabla() {
            var data = {
                __RequestVerificationToken: getToken(),
                fechaDesde: $('#filtroFechaInicio').val(),
                fechaHasta: $('#filtroFechaFin').val(),
                estado: $('#filtroEstado').val()
            };

            $('#tablaReservaContainer').html('<div class="p-3">Cargando reservas…</div>');

            $.post(urlTabla, data)
                .done(function (html) {
                    $('#tablaReservaContainer').html(html);
                })
                .fail(function (xhr) {
                    $('#tablaReservaContainer').html('<div class="p-3 text-danger">No se pudo cargar la tabla (' + xhr.status + ')</div>');
                });
        }

        function abrirModalReserva(idReserva) {
            $('#modalUpsertReserva').modal('show');
            $('#upsertReservaBody').html('<div class="p-3">Cargando…</div>');

            // IMPORTANTE: el nombre del parámetro debe ser idReserva
            $.get(urlUpsert, { idReserva: idReserva }, function (html) {
                $('#upsertReservaBody').html(html);
            });
        }


        $(function () {
            // Fechas en blanco (para que lleguen null al controller)
            $('#filtroFechaInicio').val('');
            $('#filtroFechaFin').val('');

            // Estado por defecto: Todos (valor 0)
            $('#filtroEstado').val('0');

            cargarDashboard();
            cargarTabla();

            $('#btnBuscarReservas').on('click', function () {
                cargarTabla();
            });

            $('#btnNuevaReserva').on('click', function () {
                abrirModalReserva(0);
            });

            // submit del modal de crear/editar
            $('#modalUpsertReserva').on('submit', '#formReserva', function (e) {
                e.preventDefault();
                var $f = $(this);

                $.post($f.attr('action'), $f.serialize(), function (r) {
                    if (r && r.ok) {
                        $('#modalUpsertReserva').modal('hide');
                        cargarDashboard();
                        cargarTabla();
                    } else {
                        // si la API devolvió la vista con errores, la pintamos
                        $('#upsertReservaBody').html(r);
                    }
                });
            });
        });
    </script>
}
