@model Front_Hoteleria.Dto.Reserva.ReservaDto

@using (Html.BeginForm("Upsert", "Reservas", FormMethod.Post, new { id = "formReserva" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="modal-header" style="background:#2a3f54;color:#fff;">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color:#fff;">
            <span aria-hidden="true">&times;</span>
        </button>
        <h4 class="modal-title"><i class="fa fa-plus"></i> Nueva Reserva</h4>
    </div>
    <div class="modal-body" style="padding-bottom:5px;">
        <div class="row">
            <div class="col-md-6">
                <label>Nombre del Huésped <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.HuespedNombre, new { @class = "form-control", placeholder = "Nombre completo" })
            </div>
            <div class="col-md-6">
                <label>Email <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.HuespedEmail, new { @class = "form-control", placeholder = "correo@ejemplo.com", type = "email" })
            </div>
        </div>
        <div class="row" style="margin-top:12px;">
            <div class="col-md-6">
                <label>Teléfono <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.HuespedTelefono, new { @class = "form-control", placeholder = "+56912345678" })
            </div>
            <div class="col-md-6">
                <label>Tipo de Habitación <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.TipoHabitacionNombre, new { @class = "form-control", placeholder = "Suite, Doble, etc." })
                @* si más adelante llenas un combo, lo cambias por un DropDownList *@
            </div>
        </div>
        <div class="row" style="margin-top:12px;">
            <div class="col-md-4">
                <label>Fecha de Entrada <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.FechaEntrada, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            </div>
            <div class="col-md-4">
                <label>Fecha de Salida <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.FechaSalida, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            </div>
            <div class="col-md-4">
                <label>Número de Huéspedes <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.CantidadPersonas, new { @class = "form-control", type = "number", min = "1", value = "1" })
            </div>
        </div>
        <div class="row" style="margin-top:12px;">
            <div class="col-md-12">
                <label>Observaciones</label>
                @Html.TextAreaFor(m => m.Observaciones, 3, 50, new { @class = "form-control", placeholder = "Notas adicionales..." })
            </div>
        </div>
    </div>
    <div class="modal-footer" style="background:#f7f7f7;">
        <button type="button" class="btn btn-default" data-dismiss="modal">
            <i class="fa fa-times"></i> Cancelar
        </button>
        <button type="submit" class="btn btn-success">
            <i class="fa fa-save"></i> Guardar Reserva
        </button>
    </div>
}
