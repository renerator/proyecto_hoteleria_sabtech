@* Modelo sugerido: ReservaEditVm con Id/Nombre/Apellido/Fechas/HoraLlegada *@
@model dynamic

@Html.AntiForgeryToken()
<form id="frmUpsertReserva" class="form-horizontal">
    <input type="hidden" name="Id" value="@(Model?.Id ?? 0)" />

    <div class="form-group">
        <label class="control-label col-md-3">Nombre</label>
        <div class="col-md-6">
            <input name="Nombre" class="form-control" required value="@(Model?.Nombre ?? "")" />
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-md-3">Apellido</label>
        <div class="col-md-6">
            <input name="Apellido" class="form-control" required value="@(Model?.Apellido ?? "")" />
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-md-3">Fecha Desde</label>
        <div class="col-md-3">
            <input name="FechaDesde" type="date" class="form-control" required
                   value="@(Model?.FechaDesde?.ToString("yyyy-MM-dd") ?? "")" />
        </div>

        <label class="control-label col-md-2">Fecha Hasta</label>
        <div class="col-md-3">
            <input name="FechaHasta" type="date" class="form-control" required
                   value="@(Model?.FechaHasta?.ToString("yyyy-MM-dd") ?? "")" />
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-md-3">Hora llegada</label>
        <div class="col-md-3">
            <input name="HoraLlegada" type="time" class="form-control"
                   value="@(Model?.HoraLlegada ?? "")" />
        </div>
    </div>

    <div class="ln_solid"></div>
    <div class="form-group">
        <div class="col-md-6 col-md-offset-3">
            <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </div>
</form>

<script>
  // POST por AJAX al mismo endpoint de UpsertReserva (ajusta la URL si usas otro)
  $('#frmUpsertReserva').off('submit').on('submit', function (e) {
    e.preventDefault();
    $.ajax({
      url: '@Url.Action("UpsertReserva","Reservas")',
      type: 'POST',
      headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val() },
      data: $(this).serialize()
    }).done(function(){
      new PNotify({title:'Reservas', text:'Guardado correctamente', type:'success', styling:'bootstrap3'});
      $('#modalUpsertReserva').modal('hide');
      if (window.cargarTablaReservas) { cargarTablaReservas(); }
    }).fail(function(xhr){
      new PNotify({title:'Error', text: xhr.responseText || 'No se pudo guardar', type:'error', styling:'bootstrap3'});
    });
  });
</script>
