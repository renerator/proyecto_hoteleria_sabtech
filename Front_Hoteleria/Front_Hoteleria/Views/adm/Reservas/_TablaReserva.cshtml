@model IEnumerable<Front_Hoteleria.Dto.adm.Reserva.ReservaTrabajadorDto>

<table id="tablaReservas" class="table table-striped table-bordered" style="width:100%">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Fecha Desde</th>
            <th>Fecha Hasta</th>
            <th>Habitación</th>
            <th>Estado</th>
            <th>Total</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdReserva</td>
                    <td>@item.Nombres</td>
                    <td>@item.Apellidos</td>


                    <td>@(item.FechaDesde?.ToString("dd/MM/yyyy"))</td>
                    <td>@(item.FechaHasta?.ToString("dd/MM/yyyy"))</td>
                     <td>@item.Habitacion</td> 
                    <td>@item.EstadoReserva</td>
                    <td>@item.Totales</td>

                    <td>—</td>  @* Placeholder si no viene Total *@
                    <td>
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-info btn-sm btn-res-editar" data-id="@item.IdReserva">
                                <i class="fa fa-pencil"></i>
                            </button>
                            <button type="button" class="btn btn-danger btn-sm btn-res-eliminar" data-id="@item.IdReserva">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="9" class="text-center text-muted">No se encontraron reservas.</td></tr>
        }
    </tbody>
</table>

