@model IEnumerable<Front_Hoteleria.Dto.Habitacion.HabitacionDto>

@{
    var data = Model ?? Enumerable.Empty<Front_Hoteleria.Dto.Habitacion.HabitacionDto>();
}

<style>
    /* Contenedor de la botonera con separación entre botones */
    .btn-acciones-habitacion {
        display: inline-flex;
        align-items: center;
        gap: 6px; /* Ajusta este valor para más/menos separación */
    }

        .btn-acciones-habitacion .btn {
            padding: 3px 8px; /* Opcional: tamaño de los botones */
        }
</style>

<table id="tablaHabitaciones" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Área</th>
            <th>Ala</th>
            <th>Pasillo</th>
            <th>Nro habitación</th>
            <th>Disponible</th>
            <th>Capacidad</th>
            <th class="text-center" style="width: 160px;">Opciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!data.Any())
        {
            <tr>
                <td colspan="7" class="text-muted text-center">Sin datos</td>
            </tr>
        }
        else
        {
            foreach (var h in data)
            {
                <tr>
                    <td>@h.NombreArea</td>
                    <td>@h.Ala</td>
                    <td>@h.Pasillo</td>
                    <td>@h.NombreHabitacion</td>
                    <td class="text-center">
                        @if (h.VIP)
                        {
                            <i class="green fa fa-check"></i>
                        }
                        else
                        {
                            <i class="red fa fa-close"></i>
                        }
                    </td>
                    <td>@h.Capacidad</td>
                    <td class="text-center" style="white-space: nowrap;">
                        <div class="btn-acciones-habitacion">
                            <button type="button"
                                    class="btn btn-info btn-xs btn-ver"
                                    data-id="@h.IdHabitacion"
                                    title="Ver">
                                <i class="fa fa-eye"></i>
                            </button>
                            <button type="button"
                                    class="btn btn-warning btn-xs btn-editar"
                                    data-id="@h.IdHabitacion"
                                    title="Editar">
                                <i class="fa fa-pencil"></i>
                            </button>
                            <button type="button"
                                    class="btn btn-danger btn-xs btn-eliminar"
                                    data-id="@h.IdHabitacion"
                                    title="Eliminar">
                                <i class="fa fa-trash-o"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

