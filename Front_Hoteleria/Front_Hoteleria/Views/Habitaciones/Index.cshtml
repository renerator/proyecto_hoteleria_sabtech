@{
    ViewData["Title"] = "Habitaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/vendors/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/vendors/font-awesome/css/font-awesome.min.css" />
<link rel="stylesheet" href="~/vendors/datatables.net-bs/css/dataTables.bootstrap.min.css" />
<link rel="stylesheet" href="~/vendors/pnotify/dist/pnotify.css" />
<link rel="stylesheet" href="~/vendors/pnotify/dist/pnotify.buttons.css" />

<style>
    /* ---- Tarjetas base ---- */
    .inv-card, .rep-card {
        border-radius: 14px;
        padding: 18px 20px;
        box-shadow: 0 12px 28px rgba(0,0,0,.18);
        position: relative;
        margin-bottom: 24px;
    }

    .inv-card {
        background: linear-gradient(180deg,#244e6a,#213f55);
        color: #eaf1f7;
    }

    .rep-card {
        background: linear-gradient(180deg,#d84f43,#c63e34);
        color: #fff;
    }

    .inv-card-head, .rep-card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .inv-title, .rep-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 24px;
        font-weight: 600;
    }

        .inv-title .badge, .rep-title .badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 28px;
            height: 28px;
            padding: 0 8px;
            border-radius: 999px;
            font-weight: 700;
            font-size: 14px;
            line-height: 1;
        }

        .inv-title .badge {
            background: #ff6b6b;
            color: #fff;
        }

        .rep-title .badge {
            background: #f6b548;
            color: #fff;
        }

    .inv-actions, .rep-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .inv-sub {
        color: #b7c7d9;
        margin: 6px 2px 14px;
    }

    .rep-sub {
        opacity: .85;
        margin: 6px 2px 14px;
    }

    .inv-band, .rep-band {
        background: rgba(255,255,255,.10);
        border-radius: 12px;
        padding: 14px;
    }

    .kpi {
        background: rgba(255,255,255,.10);
        border-radius: 12px;
        padding: 16px;
        text-align: center;
    }

    .kpi-label {
        opacity: .95;
        margin-bottom: 6px;
    }

    .kpi-value {
        font-size: 22px;
        font-weight: 700;
    }

    /* --- Módulo Órdenes --- */
    .rep-grid-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .rep-grid-title {
        font-size: 22px;
        font-weight: 600;
        margin: 0;
    }

    .rep-grid-sub {
        color: #7d8a99;
        margin: 4px 0 12px;
    }

    .rep-filters {
        display: flex;
        flex-wrap: nowrap;
        gap: 10px;
        align-items: center;
        overflow-x: auto;
        white-space: nowrap;
    }

        .rep-filters > * {
            flex: 0 0 auto;
        }

        .rep-filters .form-control {
            min-width: 200px;
            width: 200px;
        }

        .rep-filters .input-group {
            min-width: 190px;
            width: 190px;
        }

        .rep-filters .btn {
            height: 34px;
            line-height: 20px;
            padding-top: 6px;
            padding-bottom: 6px;
        }

    .rep-actions-right {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    hr.soft {
        margin: 10px 0 12px;
        opacity: .25;
    }

    .tag {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 14px;
        font-size: 12px;
        font-weight: 700;
        color: #fff;
    }

    .tag-blue {
        background: #3498db;
    }

    .tag-green {
        background: #2ecc71;
    }

    .tag-grey {
        background: #7f8c8d;
    }

    .tag-red {
        background: #e74c3c;
    }

    .tag-orange {
        background: #f39c12;
    }

    .tag-cyan {
        background: #17a2b8;
    }

    .table-actions .btn {
        margin-right: 4px;
    }
</style>

<div class="right_col" role="main">
    <div class="x_panel">

        <!-- DASHBOARD HABITACIONES -->
        <div class="x_panel">
            <div class="x_title">
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <div id="dashContainer">
                    <div class="text-muted">Cargando dashboard…</div>
                </div>
            </div>
        </div>

        <!-- LISTADO HABITACIONES -->
        <div class="x_title">
            <h2>Listado de Habitaciones <small>Todos los estados</small></h2>
            <div class="clearfix"></div>
        </div>

        <div class="x_content">
            <form id="frmFiltros" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="vigencia" value="1" />

                <div class="col-sm-7 col-xs-12" style="display:flex; align-items:center">
                    <p class="text-muted" style="margin:0">
                        Listado de las habitaciones del hotel, puedes revisar las habitaciones, editarlas,
                        eliminarlas o crear nuevas.
                    </p>
                </div>

                <div class="col-sm-5 col-xs-12 text-right"
                     style="display:flex; gap:8px; justify-content:flex-end; align-items:center; margin-top:6px">
                    <button type="button" id="btnNuevo" class="btn btn-primary">
                        <i class="fa fa-plus"></i> Crear Nueva Habitación
                    </button>
                    <button type="button" id="btnCargaMasivaTop" class="btn btn-success">
                        <i class="fa fa-upload"></i> Carga Masiva
                    </button>
                </div>
            </form>

            <hr />
            <div id="tablaContainer" class="table-responsive"></div>
        </div>

        <!-- INVENTARIO DE MATERIALES POR HABITACIÓN -->
        <div class="x_title">
            <h2>
                Inventario de Materiales por Habitación
                <small>Control detallado de equipos y materiales</small>
            </h2>

            <ul class="nav navbar-right panel_toolbox">
                <li>
                    <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                </li>
                <li>
                    <a class="close-link"><i class="fa fa-close"></i></a>
                </li>
            </ul>

            <div class="clearfix"></div>
        </div>

        <div class="x_content">
            <!-- Fila 1 -->
            <div class="row" style="margin-bottom:12px">
                <div class="col-md-8 col-sm-12" style="display:flex;align-items:center">
                    <p class="text-muted" style="margin:0">
                        Control detallado del inventario de cada habitación.<br />
                        Rastrea colchones, televisores, lockers y otros materiales para prevenir pérdida.
                    </p>
                </div>
                <div class="col-md-4 col-sm-12 text-right"
                     style="display:flex;gap:8px;justify-content:flex-end;align-items:center;margin-top:6px">
                    <button type="button" id="btnInvNuevo" class="btn btn-success"><i class="fa fa-plus"></i> Agregar Material</button>
                    <button type="button" id="btnInvBulk" class="btn btn-info"><i class="fa fa-upload"></i> Actualización masiva</button>
                    <button type="button" id="btnInvAudit" class="btn btn-warning"><i class="fa fa-search"></i> Auditoría</button>
                </div>
            </div>

            <!-- Fila 2: filtros -->
            <div class="row" style="margin-bottom:12px">
                <div class="col-md-3">
                    <select id="invHabitacion" class="form-control">
                        <option value="">Todas las habitaciones</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="invInsumo" class="form-control">
                        <option value="">Todos los materiales</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="invEstado" class="form-control">
                        <option value="">Todos los estados</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="button" id="btnInvLimpiar" class="btn btn-default">
                        <i class="fa fa-times"></i> Limpiar Filtros
                    </button>
                </div>
            </div>

            <div id="invTablaContainer" class="table-responsive">
                <div class="text-muted">Cargando inventario…</div>
            </div>

            <!-- Tarjeta azul: Control de Inventario -->
            <div id="invResumenCard" class="inv-card" style="margin-top:16px;">
                <div class="inv-card-head">
                    <div class="inv-title">
                        <i class="fa fa-archive"></i>
                        <span>Control de Inventario por Habitación</span>
                        <span id="kpiTotal" class="badge">0</span>
                    </div>
                    <div class="inv-actions">
                        <button type="button" id="btnInvRefresh" class="btn btn-default"><i class="fa fa-refresh"></i> Actualizar Inventario</button>
                        <button type="button" id="btnInvNuevo2" class="btn btn-primary"><i class="fa fa-plus"></i> Agregar Material</button>
                        <button type="button" id="btnInvReporte" class="btn btn-warning"><i class="fa fa-file-text-o"></i> Reporte</button>
                    </div>
                </div>

                <div class="inv-sub">Seguimiento detallado de materiales y equipos para prevenir pérdidas</div>

                <div class="inv-band">
                    <div class="row inv-kpis">
                        <div class="col-md-3 col-sm-6">
                            <div class="kpi">
                                <div class="kpi-label"><i class="fa fa-check-circle text-success"></i> Materiales Completos</div>
                                <div id="kpiCompletos" class="kpi-value">0</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="kpi">
                                <div class="kpi-label"><i class="fa fa-exclamation-triangle" style="color:#B6861D"></i> Faltantes</div>
                                <div id="kpiFaltantes" class="kpi-value">0</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="kpi">
                                <div class="kpi-label"><i class="fa fa-times-circle text-danger"></i> Dañados</div>
                                <div id="kpiDanados" class="kpi-value">0</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="kpi">
                                <div class="kpi-label"><i class="fa fa-refresh"></i> En Reparación</div>
                                <div id="kpiReparacion" class="kpi-value">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tarjeta roja: Gestión de Reparaciones -->
            <div id="repResumenCard" class="rep-card" style="margin-top:18px;">
                <div class="rep-card-head">
                    <div class="rep-title">
                        <i class="fa fa-wrench"></i>
                        <span>Gestión de Reparaciones</span>
                        <span id="repTotal" class="badge">@ViewBag.RepTotal</span>
                    </div>
                    <div class="rep-actions">
                        <button type="button" id="btnRepRefresh" class="btn btn-default"><i class="fa fa-refresh"></i> Actualizar</button>
                        <button type="button" id="btnRepReportar" class="btn btn-danger"><i class="fa fa-exclamation-triangle"></i> Reportar Problema</button>
                        <button type="button" id="btnRepReporte" class="btn btn-info"><i class="fa fa-file-text-o"></i> Reporte</button>
                    </div>
                </div>

                <div class="rep-sub">
                    Control completo de requerimientos de reparación para mantener el estándar del campamento
                </div>

                <div class="rep-band">
                    <div class="row rep-kpis">
                        <div class="col-md-2 col-sm-4"><div class="kpi"><div class="kpi-label"><i class="fa fa-clock-o" style="opacity:.85"></i> Pendientes</div><div id="repPendientes" class="kpi-value">@ViewBag.RepPendientes</div></div></div>
                        <div class="col-md-2 col-sm-4"><div class="kpi"><div class="kpi-label"><i class="fa fa-play" style="opacity:.85"></i> En Progreso</div><div id="repEnProgreso" class="kpi-value">@ViewBag.RepEnProgreso</div></div></div>
                        <div class="col-md-2 col-sm-4"><div class="kpi"><div class="kpi-label"><i class="fa fa-check" style="color:#2ecc71"></i> Completadas</div><div id="repCompletadas" class="kpi-value">@ViewBag.RepCompletadas</div></div></div>
                        <div class="col-md-2 col-sm-4"><div class="kpi"><div class="kpi-label"><i class="fa fa-exclamation-triangle" style="color:#c0392b"></i> Urgentes</div><div id="repUrgentes" class="kpi-value">@ViewBag.RepUrgentes</div></div></div>
                        <div class="col-md-2 col-sm-4"><div class="kpi"><div class="kpi-label"><i class="fa fa-calendar" style="opacity:.85"></i> Hoy</div><div id="repHoy" class="kpi-value">@ViewBag.RepHoy</div></div></div>
                        <div class="col-md-2 col-sm-4"><div class="kpi"><div class="kpi-label"><i class="fa fa-clock-o" style="opacity:.85"></i> SLA Vencido</div><div id="repSlaVencido" class="kpi-value">@ViewBag.RepSlaVencido</div></div></div>
                    </div>
                </div>
            </div>

            <!-- ÓRDENES DE TRABAJO Y REPARACIONES -->
            <div class="x_title">
                <h2>
                    Órdenes de Trabajo y Reparaciones
                    <small>Control detallado de requerimientos de reparación</small>
                </h2>

                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                    <li>
                        <a class="close-link"><i class="fa fa-close"></i></a>
                    </li>
                </ul>

                <div class="clearfix"></div>
            </div>

            <div id="repOrdenesPanel" style="margin-top:18px;">
                <div class="rep-grid-head">
                    <h3 class="rep-grid-title">Órdenes de trabajo</h3>
                    <div class="rep-actions-right">
                        <button type="button" id="btnRepNueva" class="btn btn-success"><i class="fa fa-plus"></i> Nueva Orden</button>
                        <button type="button" id="btnRepAsignar" class="btn btn-warning"><i class="fa fa-user-plus"></i> Asignar Técnico</button>
                        <button type="button" id="btnRepCalidad" class="btn btn-info"><i class="fa fa-check-circle"></i> Control Calidad</button>
                    </div>
                </div>

                <hr class="soft" />

                <div class="rep-grid-sub">
                    Gestión completa de órdenes de trabajo, desde el reporte inicial hasta la finalización y control de calidad.
                </div>

                <form id="frmRepFiltros" class="rep-filters" method="post">
                    @Html.AntiForgeryToken()

                    <select name="habitacion" class="form-control">
                        <option value="">Todas las habitaciones</option>
                    </select>

                    <!-- TIPOS (en duro) -->
                    <select name="tipo" class="form-control">
                        <option value="">Todos los tipos</option>
                        <option value="1">Plomería</option>
                        <option value="2">Electricidad</option>
                        <option value="3">HVAC</option>
                        <option value="4">Mobiliario</option>
                        <option value="5">Estructura</option>
                        <option value="6">Emergencia</option>
                    </select>

                    <!-- ESTADOS (en duro) -->
                    <select name="estado" class="form-control">
                        <option value="">Todos los estados</option>
                        <option value="1">Pendiente</option>
                        <option value="2">En Progreso</option>
                        <option value="3">Completada</option>
                        <option value="4">Cancelada</option>
                    </select>

                    <!-- PRIORIDADES (en duro) -->
                    <select name="prioridad" class="form-control">
                        <option value="">Todas las prioridades</option>
                        <option value="1">Baja</option>
                        <option value="2">Media</option>
                        <option value="3">Alta</option>
                        <option value="4">Crítica</option>
                    </select>

                    <div class="input-group" style="min-width:190px">
                        <input type="date" name="fecha" class="form-control" />
                        <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                    </div>

                    <button type="button" id="btnRepLimpiar" class="btn btn-default">
                        <i class="fa fa-times"></i> Limpiar
                    </button>
                </form>

                <div id="repTablaContainer" class="table-responsive" style="margin-top:10px;">
                    <div class="text-muted">Cargando órdenes…</div>
                </div>
            </div>

            <!-- Botones inferiores Nuevo / Carga Masiva -->
            <div class="x_content text-left" style="margin-top:20px;">
                <button type="button" id="btnNuevoBottom" class="btn btn-primary">
                    <i class="fa fa-plus"></i> Nuevo
                </button>
                <button type="button"
                        id="btnCargaMasivaHab"
                        class="btn btn-success">
                    <i class="fa fa-upload"></i> Carga masiva
                </button>
            </div>


        </div><!-- /.x_content -->

    </div><!-- /.x_panel -->
    <!-- Modal crear / ver / editar habitación -->
    <div class="modal fade" id="modalUpsertHabitacion" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header" style="background:#2a3f54;color:#fff;">
                    <button type="button" class="close" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                    <h4 class="modal-title" id="tituloModalHabitacion">
                        <i class="fa fa-bed"></i> Habitación
                    </h4>
                </div>
                <div class="modal-body" id="upsertHabitacionBody">
                    <div class="text-muted">Cargando…</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Órdenes de trabajo / reparación (genérico, se carga partial completo) -->
    <div class="modal fade" id="modalOrdenTrabajo" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="modalOrdenTrabajoBody">
                <div class="modal-body">
                    <div class="text-muted">Cargando…</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Detalle Inventario (usa partial _DetalleInventario) -->
    <div class="modal fade" id="modalInventarioDetalle" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header" style="background:#2a3f54;color:#fff;">
                    <button type="button" class="close" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                    <h4 class="modal-title" id="tituloInvDetalle">
                        Detalle de Material
                    </h4>
                </div>
                <div class="modal-body" id="bodyInvDetalle">
                    <div class="text-muted">Cargando…</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Carga Masiva Habitaciones -->
    <div class="modal fade" id="modalCargaMasiva" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="bodyCargaMasiva">
                <div class="modal-body">
                    <div class="text-muted">Cargando…</div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/vendors/jquery/dist/jquery.min.js"></script>
    <script src="~/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/vendors/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/vendors/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
    <script src="~/vendors/pnotify/dist/pnotify.js"></script>
    <script src="~/vendors/pnotify/dist/pnotify.buttons.js"></script>

    <script>
        // -------- URLs --------
        const urlDashboard          = '@Url.Action("Dashboard","Habitaciones")';
        const urlTabla              = '@Url.Action("TablaPartial","Habitaciones")';
        const urlUpsertGet          = '@Url.Action("Upsert","Habitaciones")';
        const urlEliminar           = '@Url.Action("Eliminar","Habitaciones")';

        const urlInvTabla           = '@Url.Action("TablaInventario","Habitaciones")';
        const urlInvFiltros         = '@Url.Action("FiltrosInventario","Habitaciones")';
        const urlInvEdit            = '@Url.Action("EditarInventario","Habitaciones")';
        const urlInvDetalle         = '@Url.Action("DetalleInventario","Habitaciones")';
        const urlInvAuditoria       = '@Url.Action("AuditoriaMaterial","Habitaciones")';

       const urlCargaMasivaHabView = '@Url.Action("CargaMasivaHabitacionesView", "Habitaciones")';

        const urlRepTabla           = '@Url.Action("TablaReparaciones","Habitaciones")';
        const urlRepDetalle         = '@Url.Action("DetalleReparacion","Habitaciones")';
        const urlRepEditar          = '@Url.Action("EditarReparacion","Habitaciones")';

        // Órdenes de trabajo (partials MVC)
        const urlNuevaOrdenTrabajo  = '@Url.Action("NuevaOrdenTrabajo", "Habitaciones")';
        const urlAsignarTecnicoView = '@Url.Action("AsignarTecnico", "Habitaciones")';
        const urlControlCalidadView = '@Url.Action("ControlCalidad", "Habitaciones")';
      


        // -------- Helpers --------
        function token() {
            return $('input[name="__RequestVerificationToken"]').first().val();
        }
        // Botones de Carga Masiva (arriba y abajo)
        $('#btnCargaMasivaTop, #btnCargaMasivaHab').on('click', function () {
            // abre el modal genérico con el partial _CargaMasivaHabitaciones
            abrirModalOrdenTrabajo(urlCargaMasivaHabView);
        });

        // -------- Dashboard --------
        function cargarDashboard() {
            $('#dashContainer').load(urlDashboard, function (_resp, status) {
                if (status === 'error')
                    $('#dashContainer').html('<div class="text-danger">No se pudo cargar el dashboard.</div>');
            });
        }

        // -------- Tabla Habitaciones --------
        function cargarTabla() {
            $('#tablaContainer').html('<div class="text-muted">Cargando…</div>');
            $.ajax({
                url: urlTabla,
                type: 'POST',
                data: $('#frmFiltros').serialize(),
                headers: { 'RequestVerificationToken': token() },
                success: function (html) {
                    $('#tablaContainer').html(html);

                    var $tbl = $('#tablaHabitaciones');
                    if (!$tbl.length) return;

                    if ($.fn.dataTable && $.fn.dataTable.defaults && $.fn.dataTable.defaults.columns) {
                        $.fn.dataTable.defaults.columns = [];
                    }

                    if ($.fn.DataTable.isDataTable($tbl)) {
                        $tbl.DataTable().destroy();
                    }

                    $tbl.DataTable({
                        language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' }
                    });
                },
                error: function () {
                    $('#tablaContainer').html('<div class="text-danger">Error al cargar.</div>');
                }
            });
        }

        // NUEVA HABITACIÓN (botones superior e inferior)
        $('#btnNuevo, #btnNuevoBottom').on('click', function () {
            $('#upsertHabitacionBody').html('<div class="text-muted">Cargando…</div>');
            $.get(urlUpsertGet, { id: 0, soloLectura: false })
                .done(function (html) {
                    $('#upsertHabitacionBody').html(html);
                    $('#modalUpsertHabitacion').modal('show');
                })
                .fail(function (xhr) {
                    $('#upsertHabitacionBody').html('<div class="text-danger">Error al cargar el formulario (' + xhr.status + ')</div>');
                    $('#modalUpsertHabitacion').modal('show');
                });
        });
        // EDITAR HABITACIÓN
        $('#tablaContainer').on('click', '.btn-editar', function () {
