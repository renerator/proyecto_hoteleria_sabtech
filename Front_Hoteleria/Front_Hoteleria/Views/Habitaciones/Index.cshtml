        // Tabla inventario
        function cargarInvTabla() {
            $('#invTablaContainer').html('<div class="text-muted">Cargando…</div>');

            $.ajax({
                url: urlInvTabla,
                type: 'GET',
                data: {
                    habitacion: $('#invHabitacion').val(),
                    material: $('#invInsumo').val()
                },
                success: function (html) {
                    $('#invTablaContainer').html(html);

                    var $tbl = $('#tablaInventario');
                    if (!$tbl.length) return;

                    if ($.fn.dataTable && $.fn.dataTable.defaults && $.fn.dataTable.defaults.columns) {
                        $.fn.dataTable.defaults.columns = [];
                    }

                    if ($.fn.DataTable.isDataTable($tbl)) {
                        $tbl.DataTable().destroy();
                    }

                    $tbl.DataTable({
                        language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' }
                    });

                    refrescarResumenInventario();
                    $tbl.on('draw.dt', function () { refrescarResumenInventario(); });
                },
                error: function (xhr) {
                    var msg = xhr.responseText || 'No se pudo cargar el inventario.';
                    $('#invTablaContainer').html('<div class="text-danger">' + msg + '</div>');
                }
            });
        }

