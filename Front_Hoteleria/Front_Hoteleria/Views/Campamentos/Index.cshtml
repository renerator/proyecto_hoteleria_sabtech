@{
    ViewBag.Title = "Gestión de Campamentos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="right_col" role="main">
    <div class="">
        <div class="page-title">
            <div class="title_left">
                <h3>Gestión de Campamentos <small>Control de Infraestructura</small></h3>
            </div>
            <div class="title_right">
                <div class="col-md-5 col-sm-5 col-xs-12 form-group pull-right top_search">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Buscar campamento..." id="camp-txt-buscar">
                        <span class="input-group-btn">
                            <button class="btn btn-default" type="button" id="camp-btn-buscar">Go!</button>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>

        <div id="contenedor-dashboard-camp"></div>

        <div id="contenedor-tabla-camp" style="margin-top:20px;"></div>
    </div>
</div>

@section scripts{
    <script>
        $(function () {

            cargarDashboard();
            cargarTabla();

            function cargarDashboard() {
                $.get('@Url.Action("Resumen","Campamentos")', function (html) {
                    $('#contenedor-dashboard-camp').html(html);
                });
            }

            function cargarTabla(criterio, estado) {
                $.get('@Url.Action("Tabla","Campamentos")', { criterio: criterio, estado: estado }, function (html) {
                    $('#contenedor-tabla-camp').html(html);
                });
            }

            // buscar
            $('#camp-btn-buscar').on('click', function () {
                var c = $('#camp-txt-buscar').val();
                cargarTabla(c, null);
            });

          // desde dashboard: nuevo campamento
            $(document).on('click', '#camp-btn-nuevo', function () {
                $.get('@Url.Action("Upsert","Campamentos")', { IdCampamento: 0 }, function (html) {
                    $('#modalCampamentosContent').html(html);
                    $('#modalCampamentos').modal('show');
                });
            });

            // editar desde la tabla
            $(document).on('click', '.camp-btn-editar', function () {
                var id = $(this).data('id');
                $.get('@Url.Action("Upsert","Campamentos")', { IdCampamento: id }, function (html) {
                    $('#modalCampamentosContent').html(html);
                    $('#modalCampamentos').modal('show');
                });
            });

            // VER desde la tabla (modo solo lectura)
            $(document).on('click', '.camp-btn-ver', function () {
                var id = $(this).data('id');
                $.get('@Url.Action("Upsert","Campamentos")', { IdCampamento: id, soloLectura: true }, function (html) {
                    $('#modalCampamentosContent').html(html);
                    $('#modalCampamentos').modal('show');
                });
            });


            // eliminar
            $(document).on('click', '.camp-btn-del', function () {
                var id = $(this).data('id');
                if (!confirm('¿Seguro que deseas eliminar este campamento?')) return;

                $.post('@Url.Action("Eliminar","Campamentos")', { IdCampamento: id }, function (r) {
                    if (r && r.ok) {
                        // recargar tabla
                        $.get('@Url.Action("Tabla","Campamentos")', function (html) {
                            $('#contenedor-tabla-camp').html(html);
                        });
                    } else {
                        alert(r.msg || 'No se pudo eliminar');
                    }
                });
            });

            // recargar
            $(document).on('click', '#camp-btn-refresh', function () {
                cargarDashboard();
                cargarTabla();
            });

        });
    </script>

    <!-- modal global -->
    <div class="modal fade" id="modalCampamentos" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" id="modalCampamentosContent"></div>
        </div>
    </div>
}
