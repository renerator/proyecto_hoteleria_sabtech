@model Front_Hoteleria.Model.Servicio.ServicioModel

@Html.AntiForgeryToken()
<form id="frmUpsertServicio" method="post">
    <input type="hidden" name="IdServicio" value="@(Model?.IdServicio ?? 0)" />
    <div class="row">
        <div class="col-md-4">
            <label>Habitación</label>
            <input name="NumeroHabitacion" value="@(Model?.NumeroHabitacion ?? "")" class="form-control" placeholder="0001" />
        </div>
        <div class="col-md-4">
            <label>Tipo de Servicio</label>
            <input name="NombreServicio" value="@(Model?.NombreServicio ?? "")" class="form-control" placeholder="Limpieza / Desayuno / …" />
        </div>
        <div class="col-md-4">
            <label>Prioridad</label>
            <select name="Prioridad" class="form-control">
                @{
                    var prio = Model?.Prioridad ?? "Normal";
                    string Sel(string v) => prio == v ? "selected" : "";
                }
                <option @Sel("Baja")>Baja</option>
                <option @Sel("Media")>Media</option>
                <option @Sel("Alta")>Alta</option>
                <option @Sel("Urgente")>Urgente</option>
                <option @Sel("Normal")>Normal</option>
            </select>
        </div>
        <div class="col-md-4">
            <label>Fecha</label>
            <input name="Fecha" value="@(Model?.Fecha?.ToString("yyyy-MM-dd") ?? "")" class="form-control" placeholder="dd-mm-aaaa" />
        </div>
        <div class="col-md-4">
            <label>Hora</label>
            <input name="Hora" value="@(Model?.Hora ?? "")" class="form-control" placeholder="hh:mm" />
        </div>
        <div class="col-md-12">
            <label>Comentarios</label>
            <textarea name="Comentarios" class="form-control" rows="3">@Model?.Comentarios</textarea>
        </div>
    </div>
    <hr />
    <div class="text-right">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Guardar</button>
    </div>
</form>

<script>
(function(){
    var urlPost = '@Url.Action("UpsertServicio","Servicios")';
    function token(){ return $('input[name="__RequestVerificationToken"]').val(); }

    $('#frmUpsertServicio').on('submit', function(e){
        e.preventDefault();
        $.ajax({
            url: urlPost, type:'POST',
            headers: { 'RequestVerificationToken': token() },
            data: $(this).serialize(),
            success: function(){
                $('#modalUpsert').modal('hide');
                // recargar tabla si existe
                if (window.$) { $('#frmFiltrosServicios').trigger('submit'); }
            },
            error: function(xhr){
                alert(xhr.responseText || 'No se pudo guardar.');
            }
        });
    });
})();
</script>
