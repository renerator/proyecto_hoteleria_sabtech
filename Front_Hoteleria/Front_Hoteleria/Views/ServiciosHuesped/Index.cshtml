@{
    ViewBag.Title = "Solicitudes de Servicios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="right_col" role="main">
    <div class="">
        <div class="page-title">
            <div class="title_left">
                <h3>Gestión de Solicitudes de Servicio</h3>
                <p class="text-muted">Administración de solicitudes de servicios</p>
            </div>
        </div>
        <div class="clearfix"></div>

        @* Token para los POST con [ValidateAntiForgeryToken] *@
        @Html.AntiForgeryToken()

        @* Contenedor del dashboard (se llena por AJAX) *@
        <div id="dashSolicitudContainer">
            <!-- Dashboard se cargará por AJAX -->
        </div>

        @* Contenedor de los paneles/filtros (se llena por AJAX) *@
        <div id="panelesSolicitudContainer" style="margin-top:15px;">
            <!-- Paneles se cargarán por AJAX -->
        </div>

        @* Contenedor de la tabla (se llena por AJAX) *@
        <div id="divTablaSolicitudes" style="margin-top:15px;">
            <!-- Tabla se cargará por AJAX -->
        </div>

        @* Contenedor para el modal de crear/editar (Upsert) *@
        <div id="divUpsertSolicitud"></div>

        @* Contenedor donde se inyecta el modal de Asignar Personal *@
        <div id="divAsignarPersonal"></div>

        @* Modal “contenedor” para el detalle, el contenido se trae por AJAX *@
        <div id="modalDetalleServicio" class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-lg">
                <div class="modal-content"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Cargamos dashboard y paneles al entrar
            cargarDashboard();
            cargarPaneles();
        });

        function getToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function cargarDashboard() {
            $.get('@Url.Action("Dashboard", "SolicitudServicio")',
                function (html) {
                    $('#dashSolicitudContainer').html(html);
                });
        }

        function cargarPaneles() {
            $.get('@Url.Action("Paneles", "SolicitudServicio")',
                function (html) {
                    $('#panelesSolicitudContainer').html(html);
                    // cuando los filtros estén listos, cargamos la tabla
                    recargarTabla();
                });
        }

        // Recarga tabla con los filtros actuales
        function recargarTabla() {
            var idEstado = $('#filtroEstado').val();
            var fechaInicio = $('#fechaInicio').val();
            var fechaFin = $('#fechaFin').val();

            $.post('@Url.Action("Tabla", "SolicitudServicio")',
                {
                    __RequestVerificationToken: getToken(),
                    idEstado: idEstado,
                    fechaInicio: fechaInicio,
                    fechaFin: fechaFin
                },
                function (html) {
                    $('#divTablaSolicitudes').html(html);
                }
            ).fail(function (xhr) {
                console.error("Error al cargar la tabla:", xhr.status, xhr.responseText);
            });
        }

        // ================== DETALLE ==================
        function verSolicitud(id) {
            $.get('@Url.Action("Detalle", "SolicitudServicio")',
                { idSolicitud: id },
                function (html) {
                    $('#modalDetalleServicio .modal-content').html(html);
                    $('#modalDetalleServicio').modal('show');
                }
            ).fail(function (xhr) {
                alert('No se pudo cargar el detalle (' + xhr.status + ').');
            });
        }

        // ================== EDITAR (Upsert) ==================
        function editarSolicitud(id) {
            $.get('@Url.Action("Upsert", "SolicitudServicio")',
                { id: id },
                function (html) {
                    $('#divUpsertSolicitud').html(html);
                    $('#modalSolicitudServicio').modal('show');
                }
            ).fail(function (xhr) {
                alert('No se pudo cargar la solicitud para edición (' + xhr.status + ').');
            });
        }

        // ================== ASIGNAR PERSONAL ==================
        function notificarPersonal(id) {
            $.get('@Url.Action("AsignarPersonal", "SolicitudServicio")',
                { idSolicitud: id },
                function (html) {
                    $('#divAsignarPersonal').html(html);
                    $('#modalAsignarPersonal').modal('show');
                }
            ).fail(function (xhr) {
                alert('No se pudo cargar la ventana de asignación (' + xhr.status + ').');
            });
        }

        // ================== ELIMINAR ==================
        function eliminarSolicitud(id) {
            if (!confirm('¿Está seguro de eliminar esta solicitud?')) {
                return;
            }

            $.post('@Url.Action("Eliminar", "SolicitudServicio")',
                {
                    __RequestVerificationToken: getToken(),
                    idSolicitud: id
                },
                function (resp) {
                    if (resp && resp.ok) {
                        recargarTabla();
                    } else {
                        alert((resp && resp.message) || 'No se pudo eliminar la solicitud.');
                    }
                }
            ).fail(function (xhr) {
                alert('Error al eliminar la solicitud (' + xhr.status + ').');
            });
        }
    </script>
}
