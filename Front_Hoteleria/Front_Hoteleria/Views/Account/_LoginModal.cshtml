@{ Layout = null; }
@* _LoginModal.cshtml — Estilo según captura *@

<!-- Vendors locales (quita estos <link> si ya están en _Layout) -->
<link href="@Url.Content("~/vendors/bootstrap/dist/css/bootstrap.min.css")" rel="stylesheet" />
<link href="@Url.Content("~/vendors/font-awesome/css/font-awesome.min.css")" rel="stylesheet" />
<link href="@Url.Content("~/vendors/nprogress/nprogress.css")" rel="stylesheet" />
<link href="@Url.Content("~/vendors/animate.css/animate.min.css")" rel="stylesheet" />

<style>
    /* ===== Modal ===== */
    #loginModal .modal-dialog {
        max-width: 520px;
        width: 100%;
        margin: 40px auto;
    }

    #loginModal .modal-content {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 18px 60px rgba(0,0,0,.18);
        overflow: hidden;
    }

    .modal-backdrop, .modal-backdrop.in {
        opacity: .9 !important;
        background: #0f172a;
    }

    /* ===== Caja ===== */
    .login-card {
        background: linear-gradient(180deg,#f7fafc 0%, #ffffff 85%);
        padding: 28px 28px 10px;
    }

    .login-header {
        text-align: left;
        margin-bottom: 14px;
    }

    .login-title-row {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .login-badge {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg,#0ea5e9,#10b981);
        color: #fff;
        font-size: 22px;
        box-shadow: 0 6px 14px rgba(16,185,129,.25);
    }

    .login-title {
        margin: 0;
        font-weight: 800;
        font-size: 32px;
        color: #1f2937;
        line-height: 1.1;
    }

    .login-subtitle {
        margin: 4px 0 0;
        color: #6b7280;
        font-size: 16px;
    }

    /* ===== Labels ===== */
    .form-label {
        display: block;
        margin: 14px 0 6px;
        color: #4b5563;
        font-weight: 700;
    }

    /* ===== Inputs grandes con icono a la derecha ===== */
    .input-wrap {
        position: relative;
    }

        .input-wrap .form-control {
            height: 56px;
            padding: 12px 48px 12px 14px;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            background: #fff;
            box-shadow: 0 1px 0 rgba(0,0,0,.02) inset;
            transition: border-color .15s ease, box-shadow .15s ease;
            font-size: 16px;
        }

            .input-wrap .form-control:focus {
                border-color: #93c5fd;
                box-shadow: 0 0 0 3px rgba(59,130,246,.18);
                outline: 0;
            }

    .input-icon-right {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        font-size: 18px;
    }

    /* ===== Utilidades (BS3 friendly) ===== */
    .flex-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .text-brand {
        color: #10b981;
    }
    /* link verde */
    .hidden {
        display: none !important;
    }
    /* reemplazo de d-none en BS3 */

    /* ===== Botón degradado ===== */
    .btn-gradient {
        width: 100%;
        height: 54px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(90deg,#0ea5e9,#10b981);
        color: #fff;
        font-weight: 700;
        font-size: 16px;
        box-shadow: 0 8px 18px rgba(16,185,129,.25);
        transition: filter .15s ease, transform .08s ease;
    }

        .btn-gradient:hover {
            filter: brightness(.98);
            color: #fff;
        }

        .btn-gradient:active {
            transform: translateY(1px);
        }

    /* ===== Separador & Footer ===== */
    .soft-divider {
        height: 1px;
        background: #e6e8ec;
        margin: 28px 0 18px;
    }

    .brand-line {
        display: flex;
        align-items: center;
        gap: 12px;
        justify-content: center;
        color: #10b981;
    }

    .brand-chip {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        color: #fff;
        background: linear-gradient(135deg,#10b981,#0ea5e9);
        box-shadow: 0 6px 14px rgba(16,185,129,.25);
    }

    .brand-name {
        font-weight: 800;
        font-size: 22px;
        margin: 0;
    }

    .meta {
        text-align: center;
        color: #9ca3af;
        font-size: 12px;
        margin-top: 6px;
    }
</style>

<div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="login-card animated fadeIn">
                <!-- Header -->
                <div class="login-header">
                    <div class="login-title-row">
                        <span class="login-badge"><i class="fa fa-user-shield"></i></span>
                        <h1 class="login-title">Inicio de Sesión</h1>
                    </div>
                    <p class="login-subtitle">Accede a tu cuenta de Sabtech Group</p>
                </div>

                <!-- Form -->
                <form onsubmit="return false;">
                    <!-- Usuario -->
                    <label for="txtUsuario" class="form-label"><i class="fa fa-user text-muted"></i> Usuario</label>
                    <div class="input-wrap">
                        <input type="text" id="txtUsuario" class="form-control" placeholder="admin" maxlength="30" autocomplete="username" />
                        <i class="fa fa-user input-icon-right"></i>
                    </div>

                    <!-- Contraseña -->
                    <label for="txtPassword" class="form-label"><i class="fa fa-lock text-muted"></i> Contraseña</label>
                    <div class="input-wrap">
                        <input type="password" id="txtPassword" class="form-control" placeholder="Ingresa tu contraseña" maxlength="64" autocomplete="current-password" />
                        <i class="fa fa-lock input-icon-right"></i>
                    </div>

                    <!-- Utilidades -->
                    <div class="flex-row" style="margin:12px 2px 8px;">
                        <div class="checkbox" style="margin:0;">
                            <label><input type="checkbox" id="chkRecordar" /> Recordar usuario</label>
                        </div>
                        <a href="#" id="lnkForgot" class="text-brand">¿Olvidaste tu contraseña?</a>
                    </div>

                    <!-- Mensaje de error -->
                    <div id="loginMsg" class="text-danger hidden" role="alert" style="margin:8px 2px 12px;"></div>

                    <!-- Botón -->
                    <button id="btnLogin" type="button" class="btn btn-gradient">Iniciar Sesión</button>

                    <!-- Footer -->
                    <div class="soft-divider"></div>
                    <div class="text-center">
                        <div class="brand-line">
                            <span class="brand-chip"><i class="fa fa-building"></i></span>
                            <h2 class="brand-name">Sabtech Group</h2>
                        </div>
                        <div class="meta">©2025 Sistema Hotelero [Empresa Mandante]</div>
                        <div class="meta">Versión 1.0.0</div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>
