<style>
    /* Modal más ancho y centrado */
    .modal-content {
        border-radius: 15px; /* esquinas bien redondeadas */
    }
</style>

<div class="modal fade" id="loginModal" tabindex="-1" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h4 class="modal-title">Hoteleria</h4>
            </div>
            <div class="modal-body p-5">
                <div class="form-group mb-3">
                    <input type="text"
                           class="form-control form-control-lg"
                           id="txtUsuario"
                           placeholder="Usuario"
                           maxlength="15" />
                </div>
                <div class="form-group mb-3">
                    <input type="password"
                           class="form-control form-control-lg"
                           id="txtPassword"
                           placeholder="Contraseña"
                           maxlength="15" />
                </div>
                <div id="loginMsg" class="text-danger small d-none"></div>
            </div>
            <div class="modal-footer border-0">
                <button id="btnLogin" type="button" class="btn btn-primary w-100 rounded-pill btn-lg">
                    Ingresar
                </button>
            </div>
        </div>
    </div>
</div>

