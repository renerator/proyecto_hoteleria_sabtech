@{
    ViewBag.Title = "Sugerencias y Reclamos (Huésped)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="right_col" role="main">
    <div class="">
        <div class="page-title">
            <div class="title_left">
                <h3>Sugerencias y Reclamos</h3>
            </div>
        </div>

        <div class="clearfix"></div>

        <!-- PANEL NARANJO: FORMULARIO -->
        <div class="row">
            <div class="col-md-12">
                <div class="x_panel">
                    <div class="x_title">
                        <h2><i class="fa fa-comments"></i> Centro de Sugerencias y Reclamos</h2>
                        <div class="clearfix"></div>
                    </div>
                    <div class="x_content">

                        <div class="panel panel-warning" style="border:0;">
                            <div class="panel-heading" style="background:#e67e22; color:#fff;">
                                <h4 style="margin:0;"><i class="fa fa-comments"></i> Registrar Nueva Solicitud</h4>
                            </div>
                            <div class="panel-body">
                                <p style="color:#466; margin-bottom:20px;">
                                    Registre sus sugerencias o reclamos para mejorar su experiencia. Recibirá respuesta por correo electrónico.
                                </p>

                                <form id="suggestionForm">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Tipo de Solicitud:</label>
                                                <select class="form-control" id="tipoSolicitud" required>
                                                    <option value="">Seleccione una opción</option>
                                                    <option value="reclamo">⚠️ Reclamo</option>
                                                    <option value="sugerencia">💡 Sugerencia</option>
                                                    <option value="felicitacion">🎉 Felicitación</option>
                                                    <option value="queja">😞 Queja</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Categoría:</label>
                                                <select class="form-control" id="categoriaSolicitud" required>
                                                    <option value="">Seleccione una categoría</option>
                                                    <option value="habitacion">🏠 habitación</option>
                                                    <option value="servicios">🛠 servicios</option>
                                                    <option value="comida">🍽 comida</option>
                                                    <option value="limpieza">🧹 limpieza</option>
                                                    <option value="personal">👥 personal</option>
                                                    <option value="instalaciones">🏢 instalaciones</option>
                                                    <option value="otros">📋 otros</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label>Asunto:</label>
                                        <input type="text" class="form-control" id="asuntoSolicitud" placeholder="Resumen breve de su solicitud" required />
                                    </div>

                                    <div class="form-group">
                                        <label>Descripción Detallada:</label>
                                        <textarea class="form-control" id="descripcionSolicitud" rows="4" placeholder="Describa detalladamente su sugerencia o reclamo..." required></textarea>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Email para respuesta:</label>
                                                <input type="email" class="form-control" id="emailHuesped" placeholder="su.email@ejemplo.com" required />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Prioridad:</label>
                                                <select class="form-control" id="prioridadSolicitud">
                                                    <option value="normal">🟢 Normal</option>
                                                    <option value="alta">🟡 Alta</option>
                                                    <option value="urgente">🔴 Urgente</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group" style="margin-top:15px;">
                                        <button type="submit" class="btn btn-warning" style="background:#f39c12; border-color:#f39c12;">
                                            <i class="fa fa-paper-plane"></i> Enviar Solicitud
                                        </button>
                                        <button type="button" class="btn btn-default" id="btn-limpiar-formulario">
                                            ↻ Limpiar
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- AQUÍ VA LA TABLA COMO PARCIAL -->
                        <div id="contenedor-tabla-reclamos">
                            @Html.Action("TablaReclamos", "ReclamosHuesped")
                        </div>

                        <!-- modales -->
                        <div class="modal fade" id="genericModal" tabindex="-1" role="dialog">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content"></div>
                            </div>
                        </div>
                        <div id="simpleModal" style="display:none;" class="reclamos-simple-modal">
                            <div class="reclamos-simple-modal-content">
                                <div id="simpleModalContent"></div>
                                <div class="text-right" style="margin-top: 20px;">
                                    <button onclick="cerrarSimpleModal()" class="btn btn-danger btn-sm">
                                        <i class="fa fa-times"></i> Cerrar
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div> <!-- x_content -->
                </div>
            </div>
        </div>

    </div>
</div>

@section scripts {
    <script src="~/Scripts/reclamos.js"></script>
}
