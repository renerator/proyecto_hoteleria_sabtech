@{
    ViewBag.Title = "Sugerencias y Reclamos (Huésped)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="right_col" role="main">
    <div class="">
        <div class="page-title">
            <div class="title_left">
                <h3>Sugerencias y Reclamos</h3>
            </div>
        </div>

        <div class="clearfix"></div>

        <!-- PANEL NARANJO: FORMULARIO -->
        <div class="row">
            <div class="col-md-12">
                <div class="x_panel">
                    <div class="x_title">
                        <h2><i class="fa fa-comments"></i> Centro de Sugerencias y Reclamos</h2>
                        <div class="clearfix"></div>
                    </div>
                    <div class="x_content">

                        <div class="panel panel-warning" style="border:0;">
                            <div class="panel-heading" style="background:#e67e22; color:#fff;">
                                <h4 style="margin:0;"><i class="fa fa-comments"></i> Registrar Nueva Solicitud</h4>
                            </div>
                            <div class="panel-body">
                                <p style="color:#466; margin-bottom:20px;">
                                    Registre sus sugerencias o reclamos para mejorar su experiencia. Recibirá respuesta por correo electrónico.
                                </p>

                                <form id="suggestionForm">
                                    @Html.AntiForgeryToken()

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="cmbTipoSolicitudHuesped">Tipo de Solicitud:</label>
                                                <select class="form-control"
                                                        id="cmbTipoSolicitudHuesped"
                                                        name="idTipoSolicitudHuesped"
                                                        required>
                                                    <option value="">Seleccione una opción</option>
                                                    <option value="1">⚠ Reclamo</option>
                                                    <option value="2">💡 Sugerencia</option>
                                                    <option value="3">🎉 Felicitación</option>
                                                    <option value="4">😞 Queja</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="cmbCategoriaSolicitudHuesped">Categoría:</label>
                                                <select class="form-control"
                                                        id="cmbCategoriaSolicitudHuesped"
                                                        name="idCategoriaSolicitudHuesped"
                                                        required>
                                                    <option value="">Seleccione una categoría</option>
                                                    <option value="1">🏠 habitación</option>
                                                    <option value="2">🛠 servicios</option>
                                                    <option value="3">🍽 comida</option>
                                                    <option value="4">🧹 limpieza</option>
                                                    <option value="5">👥 personal</option>
                                                    <option value="6">🏢 instalaciones</option>
                                                    <option value="7">📋 otros</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="asuntoSolicitud">Asunto:</label>
                                        <input type="text"
                                               class="form-control"
                                               id="asuntoSolicitud"
                                               name="Asunto"
                                               placeholder="Resumen breve de su solicitud"
                                               required />
                                    </div>

                                    <div class="form-group">
                                        <label for="descripcionSolicitud">Descripción Detallada:</label>
                                        <textarea class="form-control"
                                                  id="descripcionSolicitud"
                                                  name="Descripcion"
                                                  rows="4"
                                                  placeholder="Describa detalladamente su sugerencia o reclamo..."
                                                  required></textarea>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="emailHuesped">Email para respuesta:</label>
                                                <input type="email"
                                                       class="form-control"
                                                       id="emailHuesped"
                                                       name="EmailHuesped"
                                                       placeholder="su.email@ejemplo.com"
                                                       required />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="prioridadSolicitud">Prioridad:</label>
                                                <select class="form-control"
                                                        id="prioridadSolicitud"
                                                        name="Prioridad">
                                                    <option value="normal">🟢 Normal</option>
                                                    <option value="alta">🟡 Alta</option>
                                                    <option value="urgente">🔴 Urgente</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group" style="margin-top:15px;">
                                        <button type="submit"
                                                class="btn btn-warning"
                                                style="background:#f39c12; border-color:#f39c12;">
                                            <i class="fa fa-paper-plane"></i> Enviar Solicitud
                                        </button>
                                        <button type="button"
                                                class="btn btn-default"
                                                id="btn-limpiar-formulario">
                                            ↻ Limpiar
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- AQUÍ VA LA TABLA COMO PARCIAL (SOLO AJAX, SIN Html.Action) -->
                        <div id="contenedor-tabla-reclamos">
                            <div class="text-center text-muted" style="padding:10px;">
                                Cargando solicitudes...
                            </div>
                        </div>

                        <!-- modales -->
                        <div class="modal fade" id="genericModal" tabindex="-1" role="dialog">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content"></div>
                            </div>
                        </div>

                        <div id="simpleModal" style="display:none;" class="reclamos-simple-modal">
                            <div class="reclamos-simple-modal-content">
                                <div id="simpleModalContent"></div>
                                <div class="text-right" style="margin-top: 20px;">
                                    <button onclick="cerrarSimpleModal()" class="btn btn-danger btn-sm">
                                        <i class="fa fa-times"></i> Cerrar
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div> <!-- x_content -->
                </div>
            </div>
        </div>

    </div>
</div>

@section scripts {
    <script type="text/javascript">
        // función para mostrar mensajes (usa PNotify si existe, si no, alert)
        function mostrarMensaje(tipo, texto) {
            if (window.PNotify) {
                new PNotify({
                    title: (tipo === "success" ? "Éxito" : "Error"),
                    text: texto,
                    type: tipo,
                    styling: "bootstrap3"
                });
            } else {
                alert(texto);
            }
        }

        // carga la tabla por AJAX
        function recargarTablaReclamos() {
            $("#contenedor-tabla-reclamos")
                .load('@Url.Action("TablaReclamos", "ReclamosHuesped")');
        }

        function limpiarFormulario() {
            var form = document.getElementById("suggestionForm");
            if (form) form.reset();
        }

        function cerrarSimpleModal() {
            $("#simpleModal").hide();
            $("#simpleModalContent").empty();
        }

        function abrirSimpleModal(html) {
            $("#simpleModalContent").html(html);
            $("#simpleModal").show();
        }

        $(function () {
            // cargar tabla al entrar
            recargarTablaReclamos();

            // Envío del formulario por AJAX
            $("#suggestionForm").on("submit", function (e) {
                e.preventDefault();

                var $form = $(this);

                $.ajax({
                    url: '@Url.Action("Crear", "ReclamosHuesped")',
                    type: "POST",
                    data: $form.serialize(),
                    success: function (resp) {
                        if (resp && resp.ok) {
                            mostrarMensaje("success", resp.message || "Solicitud registrada correctamente.");
                            limpiarFormulario();
                            recargarTablaReclamos();
                        } else {
                            mostrarMensaje("error", (resp && resp.message) || "No se pudo registrar la solicitud.");
                        }
                    },
                    error: function () {
                        mostrarMensaje("error", "Se produjo un error al enviar la solicitud.");
                    }
                });
            });

            // Botón limpiar
            $("#btn-limpiar-formulario").on("click", function () {
                limpiarFormulario();
            });
        });
        // Abrir detalle en modal
$(document).on("click", ".btn-ver-detalle", function (e) {
    e.preventDefault();
    var id = $(this).data("id");   // data-id en el botón

    $.get("@Url.Action("Detalle", "ReclamosHuesped")",
        { idReclamoHuesped: id },
        function (html) {
            $("#genericModal .modal-content").html(html);
            $("#genericModal").modal("show");
        });
});

    </script>
}
