@{
    ViewBag.Title = "Mis Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="page-title">
    <h2>Mis Reservas</h2>
    <p>Gestiona tus solicitudes de reserva</p>
</div>

@Html.AntiForgeryToken()

<div class="x_panel">
    <div class="x_title">
        <h3><i class="fa fa-plus"></i> Nueva Reserva</h3>
        <div class="clearfix"></div>
    </div>
    <div class="x_content text-center">
        <p>¿Necesita hacer una nueva reserva? Haga clic en el botón para iniciar el proceso.</p>
        <button id="btnNueva" class="btn btn-success btn-lg">
            <i class="fa fa-plus"></i> Crear Nueva Reserva
        </button>
    </div>
</div>

<div class="x_panel">
    <div class="x_title">
        <h3><i class="fa fa-search"></i> Buscar Mis Reservas</h3>
        <div class="clearfix"></div>
    </div>
    <div class="x_content">
        <form id="frmFiltro" class="form-inline" onsubmit="return false;">
            <div class="form-group">
                <label>ID de Reserva:</label>
                <input name="Codigo" class="form-control" placeholder="Ej: RES001" />
            </div>
            <div class="form-group">
                <label>Estado:</label>
                <select name="Estado" class="form-control">
                    <option value="">Todos</option>
                    <option value="1">Pendiente</option>
                    <option value="2">Aprobada</option>
                    <option value="3">Rechazada</option>
                    <option value="4">Completada</option>
                </select>
            </div>
            <div class="form-group">
                <label>Desde:</label>
                <input name="Desde" class="form-control" placeholder="yyyy-mm-dd" />
            </div>
            <div class="form-group">
                <label>Hasta:</label>
                <input name="Hasta" class="form-control" placeholder="yyyy-mm-dd" />
            </div>
            <button id="btnBuscar" class="btn btn-primary"><i class="fa fa-search"></i> Buscar</button>
            <button id="btnTodas" class="btn btn-default"><i class="fa fa-list"></i> Ver Todas</button>
        </form>

        <div id="divTabla" class="table-responsive" style="margin-top:14px"></div>
    </div>
</div>

<!-- Modal upsert (cuerpo se carga por AJAX) -->
<div id="modalUpsert" class="modal fade" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content" id="modalBody"></div></div>
</div>

@section scripts{
    <script>
(function(){
  function antix() { return $('input[name="__RequestVerificationToken"]').val(); }

  // abrir modal nueva
  $('#btnNueva').on('click', function(){
      $('#modalBody').html('<div class="p-3">Cargando…</div>');
      $('#modalUpsert').modal('show');
      $.get('@Url.Action("Nueva","ReservasHuesped")', function(html){ $('#modalBody').html(html); });
  });

  // cargar tabla
  function cargarTabla(f) {
     var data = $('#frmFiltro').serialize();
     $.ajax({
        url: '@Url.Action("Tabla","ReservasHuesped")',
        method: 'POST',
        headers: { 'RequestVerificationToken': antix() },
        data: data,
        success: function(html){ $('#divTabla').html(html); },
        error: function(){ $('#divTabla').html('<div class="text-danger">No se pudo cargar el listado.</div>'); }
     });
  }
  $('#btnBuscar').on('click', function(){ cargarTabla(); });
  $('#btnTodas').on('click', function(){ $('#frmFiltro')[0].reset(); cargarTabla(); });

  // primera carga
  cargarTabla();

})();
    </script>
}
