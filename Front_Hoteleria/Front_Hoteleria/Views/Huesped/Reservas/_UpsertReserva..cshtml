@model Front_Hoteleria.Dto.adm.Reserva.ReservaTrabajadorDto
@using System.Web.Mvc
@{
    // Catálogos que te deja el GET Upsert()
    var habitaciones = ViewBag.Habitaciones as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var tipos = ViewBag.TiposReserva as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();

    var idTrabajador = (ViewBag.IdTrabajador as int?) ?? 0;

    // Defaults de solo-lectura para la UI
    var fechaDesdeStr = (Model?.FechaDesde ?? DateTime.Today).ToString("yyyy-MM-dd");
    var fechaHastaStr = (Model?.FechaHasta ?? DateTime.Today.AddDays(1)).ToString("yyyy-MM-dd");
    var estadoEfectivo = (Model?.IdEstadoReserva ?? 0) == 0 ? 1 : Model.IdEstadoReserva; // 1 = Ingresada
}

@using (Html.BeginForm("CrearReserva", "Reservas", FormMethod.Post, new { id = "formCrearReserva", @class = "form-horizontal", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()

    <!-- Enviamos el estado efectivo (1 si venía 0/null) -->
    <input type="hidden" name="IdEstadoReserva" value="@estadoEfectivo" />
    <input type="hidden" name="IdTrabajador" value="@idTrabajador" />

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label>Nombre *</label>
                @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control", required = "required", placeholder = "Nombre" })
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label>Apellido *</label>
                @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control", required = "required", placeholder = "Apellido" })
            </div>
        </div>

        <div class="col-sm-6">
            <div class="form-group">
                <label>Email *</label>
                <input type="email" class="form-control" name="Email" required placeholder="correo@empresa.com" />
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label>Teléfono *</label>
                <input type="tel" class="form-control" name="Telefono" required placeholder="+56 9 1234 5678" />
            </div>
        </div>

        <div class="col-sm-6">
            <div class="form-group">
                <label>Habitación *</label>
                @Html.DropDownListFor(m => m.IdHabitacion, habitaciones, "Seleccionar habitación...", new { @class = "form-control", required = "required" })
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label>Tipo de Reserva *</label>
                @Html.DropDownListFor(m => m.IdTipoReserva, tipos, "Seleccionar tipo...", new { @class = "form-control", required = "required" })
            </div>
        </div>

        <div class="col-sm-6">
            <div class="form-group">
                <label>Fecha Check In *</label>
                <input class="form-control" type="date" name="FechaDesde" required
                       value="@fechaDesdeStr" placeholder="dd-mm-aaaa" />
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label>Fecha Check Out *</label>
                <input class="form-control" type="date" name="FechaHasta" required
                       value="@fechaHastaStr" placeholder="dd-mm-aaaa" />
            </div>
        </div>

        <div class="col-sm-6">
            <div class="form-group">
                <label>Monto Total *</label>
                @Html.TextBoxFor(m => m.Totales, new { @class = "form-control", type = "number", min = "0", step = "1", required = "required", placeholder = "0" })
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label>Solicitudes Especiales</label>
                @Html.TextAreaFor(m => m.MotivoReserva, 3, 40, new { @class = "form-control", placeholder = "Cama extra, cuna, etc." })
            </div>
        </div>
    </div>

    <div class="text-right">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-success">Crear Reserva</button>
    </div>
}
