@Html.AntiForgeryToken()
<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h4 class="modal-title"><i class="fa fa-plus"></i> Nueva Solicitud de Servicio</h4>
</div>
<div class="modal-body">
    <form id="frmServicio" autocomplete="off">
        <div class="form-group">
            <label>Tipo de servicio *</label>
            <select name="Servicio" class="form-control" required>
                <option value="">-- Seleccione --</option>
                <option value="Lavanderia">Lavandería</option>
                <option value="Traslado interno">Traslado interno</option>
                <option value="Mantencion">Mantención</option>
                <option value="Room service">Room service</option>
            </select>
        </div>
        <div class="form-group">
            <label>Fecha requerida *</label>
            <input type="date" name="Fecha" class="form-control" required
                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group">
            <label>Horario preferente</label>
            <input type="time" name="Hora" class="form-control" />
        </div>
        <div class="form-group">
            <label>Observaciones</label>
            <textarea name="Observaciones" rows="3" class="form-control"
                      placeholder="Detalle del servicio que necesita..."></textarea>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
    <button type="button" class="btn btn-success" id="btnGuardarServicio">Guardar</button>
</div>

<script>
    // guardar dummy (solo cierra modal y muestra alerta)
    $('#btnGuardarServicio').on('click', function () {
        // acá iría el $.post(...) a tu API
        alert('Servicio solicitado correctamente (demo).');
        $('#modalUpsert').modal('hide');
    });
</script>
