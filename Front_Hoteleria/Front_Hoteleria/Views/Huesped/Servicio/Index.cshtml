@{
    ViewBag.Title = "Servicios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="right_col" role="main">
    <div class="x_panel">
        <div class="x_title">
            <h2>Servicios <small>Panel Operativo (Huésped)</small></h2>
            <div class="clearfix"></div>
        </div>

        <div class="x_content">
            <!-- Filtros básicos para la tabla -->
            <form id="frmFiltrosServicios" class="form-inline" method="post" style="margin-bottom:10px">
                @Html.AntiForgeryToken()
                <input type="hidden" name="vigencia" value="1" />
                <div class="form-group">
                    <label for="txtNombre" class="sr-only">Nombre</label>
                    <input id="txtNombre" name="nombre" class="form-control" placeholder="Buscar mi solicitud..." />
                </div>
                <button type="submit" class="btn btn-default"><i class="fa fa-search"></i> Buscar</button>
                <button type="button" id="btnLimpiarFiltros" class="btn btn-default"><i class="fa fa-eraser"></i> Limpiar</button>

                <button type="button" id="btnNuevoServicio" class="btn btn-primary pull-right" data-toggle="modal" data-target="#modalUpsert">
                    <i class="fa fa-plus"></i> Solicitar Servicio
                </button>
            </form>

            <!-- 1) Dashboard -->
            <div id="dashContainer" style="margin-bottom:15px"></div>

            <!-- 2) Paneles intermedios -->
            <div id="panelesContainer" style="margin-bottom:15px"></div>

            <!-- 3) Tabla -->
            <div id="tablaContainer" class="table-responsive"></div>
        </div>
    </div>
</div>

<!-- Modal Upsert -->
<div class="modal fade" id="modalUpsert" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                <h4 class="modal-title">Solicitud de Servicio</h4>
            </div>
            <div class="modal-body" id="upsertBody">
                <div class="text-muted">Cargando…</div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
(function(){
    // Endpoints (usa los de tu ServiciosController: versión Huesped)
    const urlDashboard  = '@Url.Action("DashboardServicioHuesped","Servicios")'; // GET -> Partial
    const urlPaneles    = '@Url.Action("PanelesServicioHuesped","Servicios")';   // GET -> Partial
    const urlTabla      = '@Url.Action("TablaServicioHuesped","Servicios")';     // POST -> Partial
    const urlUpsertGet  = '@Url.Action("UpsertSolicitudServicio","Servicios")';  // GET -> Partial form
    const urlUpsertPost = '@Url.Action("UpsertSolicitudServicio","Servicios")';  // POST -> JSON/Partial
    const urlEliminar   = '@Url.Action("EliminarSolicitudServicio","Servicios")';// POST -> JSON

    function token(){
        var $t = $('#frmFiltrosServicios').find('input[name="__RequestVerificationToken"]');
        return $t.length ? $t.val() : $('input[name="__RequestVerificationToken"]').val();
    }

    function cargarDashboard(){
        $('#dashContainer').load(urlDashboard, function(_, status){
            if(status!=='success') $('#dashContainer').html('<div class="text-danger">No se pudo cargar el dashboard.</div>');
        });
    }

    function cargarPaneles(){
        $('#panelesContainer').load(urlPaneles, function(_, status){
            if(status!=='success') $('#panelesContainer').html('<div class="text-danger">No se pudieron cargar los paneles.</div>');
        });
    }

    function cargarTabla(){
        $('#tablaContainer').html('<div class="text-muted">Cargando…</div>');
        $.ajax({
            url: urlTabla,
            type: 'POST',
            data: $('#frmFiltrosServicios').serialize(),
            headers: { 'RequestVerificationToken': token() },
            success: function(html){ $('#tablaContainer').html(html); },
            error: function(){ $('#tablaContainer').html('<div class="text-danger">No se pudo cargar el listado.</div>'); }
        });
    }

    // Abrir modal (nueva solicitud)
    $('#btnNuevoServicio').on('click', function(){
        $('#upsertBody').html('<div class="text-muted">Cargando…</div>');
        $('#upsertBody').load(urlUpsertGet, function(_, status){
            if(status!=='success'){
                $('#upsertBody').html('<div class="text-danger">No se pudo cargar el formulario.</div>');
            }else{
                wireUpsert(); // engancha eventos del form dentro del modal
            }
        });
    });

    // Delegados editar / eliminar en la tabla
    $('#tablaContainer').on('click','.btn-editar-solicitud', function(){
        var id = $(this).data('id');
        $('#upsertBody').html('<div class="text-muted">Cargando…</div>');
        $('#modalUpsert').modal('show');
        $('#upsertBody').load(urlUpsertGet + '?id=' + encodeURIComponent(id), function(_, status){
            if(status!=='success'){
                $('#upsertBody').html('<div class="text-danger">No se pudo cargar el formulario.</div>');
            }else{
                wireUpsert();
            }
        });
    });

    $('#tablaContainer').on('click','.btn-eliminar-solicitud', function(){
        var id = $(this).data('id');
        if(!confirm('¿Eliminar la solicitud?')) return;
        $.ajax({
            url: urlEliminar, type:'POST',
            headers: { 'RequestVerificationToken': token() },
            data: { idSolicitud: id },
            success: function(res){
                cargarTabla();
            },
            error: function(xhr){ alert(xhr.responseText || 'Error al eliminar.'); }
        });
    });

    // Bind de envío AJAX del form que viene dentro del modal
    function wireUpsert(){
        var $frm = $('#upsertBody').find('form#frmUpsertSolicitud');
        if(!$frm.length) return;

        // “Servicios rápidos” dentro del modal (si el parcial los trae)
        $('#upsertBody').off('click', '.js-quick').on('click', '.js-quick', function(){
            var tipo = $(this).data('tipo');
            $('#TipoServicioId').val(tipo);
            var $desc = $('#Descripcion');
            if($desc.length && !$desc.val()){
                var txt = (tipo == 1) ? 'Solicitud de limpieza: ' :
                          (tipo == 2) ? 'Solicitud de reposición: ' :
                                        'Solicitud de reparación: ';
                $desc.val(txt);
            }
        });

        $frm.off('submit').on('submit', function(e){
            e.preventDefault();
            var formData = $frm.serialize();
            $.ajax({
                url: urlUpsertPost,
                type: 'POST',
                data: formData,
                headers: { 'RequestVerificationToken': token() },
                success: function(resp){
                    // Si el servidor devuelve JSON { ok: true } cerramos; si devuelve HTML (validación), reinyectamos
                    var isJson = false;
                    try { if (typeof resp === 'object') isJson = true; } catch(e){}
                    if(isJson && resp.ok){
                        $('#modalUpsert').modal('hide');
                        cargarTabla();
                    }else{
                        // asumimos que volvió un Partial con validaciones
                        $('#upsertBody').html(resp);
                        wireUpsert(); // reenganchar
                    }
                },
                error: function(xhr){
                    var msg = xhr.responseText || 'No se pudo guardar la solicitud.';
                    $('#upsertBody').html('<div class="alert alert-danger">'+ msg +'</div>');
                }
            });
        });
    }

    // Buscar / limpiar
    $('#frmFiltrosServicios').on('submit', function(e){ e.preventDefault(); cargarTabla(); });
    $('#btnLimpiarFiltros').on('click', function(){
        $('#frmFiltrosServicios')[0].reset(); cargarTabla();
    });

    // Carga inicial
    $(function(){
        cargarDashboard();
        cargarPaneles();
        cargarTabla();
    });
})();
    </script>
}
