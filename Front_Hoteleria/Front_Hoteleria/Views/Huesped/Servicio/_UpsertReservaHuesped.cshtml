@model Front_Hoteleria.Dto.Huesped.ReservaHuespedDto

@{
    bool esEdicion = Model != null && Model.IdReserva > 0;
    string titulo = esEdicion ? "Editar Reserva" : "Nueva Reserva";

    var fechaIngreso = (Model != null && Model.FechaDesde != default(DateTime))
        ? Model.FechaDesde
        : DateTime.Today;

    var fechaHasta = (Model != null && Model.FechaHasta != default(DateTime))
        ? Model.FechaHasta
        : DateTime.Today;
}

<div class="modal-header" style="background:#e8f5e9;">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h4 class="modal-title">
        <i class="fa fa-calendar"></i> @titulo
    </h4>
</div>

<div class="modal-body">
    @using (Html.BeginForm("", "", FormMethod.Post, new { id = "frmReservaHuesped" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.IdReserva)
        @* si más adelante usas Código de reserva, puedes dejarlo *@
        @* @Html.HiddenFor(m => m.CodigoReserva) *@

        <div class="row">
            <!-- Turno de Trabajo -->
            <div class="col-md-6">
                <div class="form-group">
                    <label>Turno de Trabajo:</label>
                    <select name="IdTurno" class="form-control">
                        <option value="0">Seleccionar turno...</option>
                        <option value="1" @(Model != null && Model.IdTurno == 1 ? "selected" : "")>
                            Turno Día (06:00 - 14:00)
                        </option>
                        <option value="2" @(Model != null && Model.IdTurno == 2 ? "selected" : "")>
                            Turno Tarde (14:00 - 22:00)
                        </option>
                        <option value="3" @(Model != null && Model.IdTurno == 3 ? "selected" : "")>
                            Turno Noche (22:00 - 06:00)
                        </option>
                    </select>
                </div>
            </div>

            <!-- Días de Estadía -->
            <div class="col-md-6">
                <div class="form-group">
                    <label>Días de Estadía:</label>
                    <select name="DiasEstadia" class="form-control">
                        <option value="">Seleccionar días...</option>
                        <option value="1" @(Model != null && Model.DiasEstadia == 1 ? "selected" : "")>1 día</option>
                        <option value="2" @(Model != null && Model.DiasEstadia == 2 ? "selected" : "")>2 días</option>
                        <option value="3" @(Model != null && Model.DiasEstadia == 3 ? "selected" : "")>3 días</option>
                        <option value="7" @(Model != null && Model.DiasEstadia == 7 ? "selected" : "")>1 semana</option>
                        <option value="15" @(Model != null && Model.DiasEstadia == 15 ? "selected" : "")>15 días</option>
                        <option value="30" @(Model != null && Model.DiasEstadia == 30 ? "selected" : "")>1 mes</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Fecha de Ingreso -->
            <div class="col-md-6">
                <div class="form-group">
                    <label>Fecha de Ingreso:</label>
                    <input type="date"
                           name="FechaDesde"
                           class="form-control"
                           value="@fechaIngreso.ToString("yyyy-MM-dd")"
                           required />
                </div>
            </div>

            <!-- Fecha de Hasta -->
            <div class="col-md-6">
                <div class="form-group">
                    <label>Fecha de Hasta:</label>
                    <input type="date"
                           name="FechaHasta"
                           class="form-control"
                           value="@fechaHasta.ToString("yyyy-MM-dd")"
                           required />
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Email para Confirmación -->
            <div class="col-md-6">
                <div class="form-group">
                    <label>Email para Confirmación:</label>
                    @Html.TextBoxFor(m => m.Email,
                        new
                        {
                            @class = "form-control",
                            type = "email",
                            placeholder = "tu@email.com",
                            required = "required"
                        })
                </div>
            </div>
        </div>

        <!-- Observaciones -->
        <div class="form-group">
            <label>Observaciones:</label>
            @Html.TextAreaFor(m => m.Comentarios,
                4,
                40,
                new
                {
                    @class = "form-control",
                    placeholder = "Observaciones adicionales..."
                })
        </div>
    }
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
    <button type="button" class="btn btn-success" id="btnGuardarReserva">
        <i class="fa fa-check"></i> @((esEdicion) ? "Guardar Cambios" : "Solicitar Reserva")
    </button>
</div>

<script>
    (function () {
        function antix() {
            return $('#frmReservaHuesped input[name="__RequestVerificationToken"]').val();
        }

        $('#btnGuardarReserva').off('click').on('click', function () {
            var data = $('#frmReservaHuesped').serialize();

            $.ajax({
                url: '@Url.Action("Guardar","ReservasHuesped")',
                type: 'POST',
                data: data,
                headers: { 'RequestVerificationToken': antix() },
                success: function (resp) {
                    if (resp && resp.ok) {
                        alert(resp.message || 'Reserva guardada');
                        $('#modalReserva').modal('hide');
                        if (typeof (window.$) !== 'undefined') {
                            $('#btnBuscar').click();
                        }
                    } else {
                        alert((resp && resp.message) || 'No se pudo guardar la reserva.');
                    }
                },
                error: function () {
                    alert('Error al guardar la reserva.');
                }
            });
        });
    })();
</script>
