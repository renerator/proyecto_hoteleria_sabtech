@model Front_Hoteleria.Dto.Huesped.ReservaHuespedDto

@{
    Layout = null;

    var esEdicion = Model != null && Model.IdReserva > 0;
    var titulo = esEdicion ? "Editar Reserva" : "Nueva Reserva";
}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h4 class="modal-title">
        <i class="fa fa-pencil"></i> @titulo
    </h4>
</div>

<div class="modal-body">
    @using (Html.BeginForm("", "", FormMethod.Post, new { id = "frmReservaHuesped" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.IdReserva)
        @Html.HiddenFor(m => m.IdTrabajador)
        @Html.HiddenFor(m => m.IdEstadoReserva)

        <!-- Fila 1: Nombre / Apellido -->
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Nombre *</label>
                    @Html.TextBoxFor(m => m.Nombre, new
                    {
                        @class = "form-control",
                        required = "required",
                        placeholder = "Juan"
                    })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Apellido *</label>
                    @Html.TextBoxFor(m => m.Apellido, new
                    {
                        @class = "form-control",
                        required = "required",
                        placeholder = "Pérez"
                    })
                </div>
            </div>
        </div>

        <!-- Fila 2: Fecha Desde / Fecha Hasta -->
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Fecha Desde *</label>
                    @Html.TextBoxFor(m => m.FechaDesde, "{0:yyyy-MM-dd}", new
                    {
                        @class = "form-control",
                        type = "date",
                        required = "required"
                    })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Fecha Hasta *</label>
                    @Html.TextBoxFor(m => m.FechaHasta, "{0:yyyy-MM-dd}", new
                    {
                        @class = "form-control",
                        type = "date",
                        required = "required"
                    })
                </div>
            </div>
        </div>

        <!-- Fila 3: Email / Teléfono -->
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Email *</label>
                    @Html.TextBoxFor(m => m.Email, new
                    {
                        @class = "form-control",
                        type = "email",
                        required = "required",
                        placeholder = "juan.perez@email.com"
                    })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Teléfono</label>
                    @Html.TextBoxFor(m => m.Telefono, new
                    {
                        @class = "form-control",
                        placeholder = "+56 9 1234 5678"
                    })
                </div>
            </div>
        </div>

        <!-- Fila 4: Comentarios -->
        <div class="form-group">
            <label>Comentarios</label>
            @Html.TextAreaFor(m => m.Comentarios, 4, 40, new
            {
                @class = "form-control",
                placeholder = "Necesito habitación cerca del ascensor"
            })
        </div>
    }
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-default" data-dismiss="modal">
        Cancelar
    </button>
    <button type="button" class="btn btn-primary" id="btnGuardarReserva">
        <i class="fa fa-save"></i> @((esEdicion) ? "Guardar Cambios" : "Solicitar Reserva")
    </button>
</div>
