@using System.Linq
@model IEnumerable<Front_Hoteleria.Dto.Huesped.ServicioHuespedDto>

<style>
    .svc-h-table-header {
        padding: 15px 20px;
        border-bottom: 1px solid #e5e5e5;
        background: #fff;
        border-radius: 8px 8px 0 0;
    }

    .svc-h-label {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: .75rem;
        font-weight: 600;
    }

    .svc-h-label-pendiente {
        background: #fff3cd;
        color: #856404;
    }

    .svc-h-label-enproceso {
        background: #d1ecf1;
        color: #0c5460;
    }

    .svc-h-label-completado {
        background: #d4edda;
        color: #155724;
    }

    .svc-h-label-cancelado {
        background: #f8d7da;
        color: #721c24;
    }
</style>

<div class="table-responsive">
    <table id="tblSolicitudesServicio" class="table table-hover">
        <thead>
            <tr class="svc-h-table-header">
                <th>Tipo</th>
                <th>Descripción</th>
                <th>Prioridad</th>
                <th>Estado</th>
                <th>Fecha</th>
                <th class="text-right">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">
                        No se encontraron solicitudes de servicio.
                    </td>
                </tr>
            }
            else
            {
                foreach (var s in Model)
                {
                    // IdEstado numérico: 1=Pendiente, 2=Asignada, 3=Rechazada, 4=Realizada
                    var idEstado = s.IdEstado ?? 0;

                    string badgeClass;
                    string textoEstado;

                    switch (idEstado)
                    {
                        case 1: // Pendiente
                            textoEstado = "Pendiente";
                            badgeClass = "svc-h-label svc-h-label-pendiente";
                            break;

                        case 2: // Asignada
                            textoEstado = "Asignada";
                            badgeClass = "svc-h-label svc-h-label-enproceso";
                            break;

                        case 3: // Rechazada
                            textoEstado = "Rechazada";
                            badgeClass = "svc-h-label svc-h-label-cancelado";
                            break;

                        case 4: // Realizada
                            textoEstado = "Realizada";
                            badgeClass = "svc-h-label svc-h-label-completado";
                            break;

                        default:
                            // Si viene texto en s.Estado, úsalo; si no, "Desconocido"
                            textoEstado = !string.IsNullOrWhiteSpace(s.Estado)
                                ? s.Estado
                                : "Desconocido";
                            badgeClass = "svc-h-label svc-h-label-pendiente";
                            break;
                    }

                    <tr>
                        <td>@s.TipoServicio</td>
                        <td>@s.Descripcion</td>
                        <td>@s.Prioridad</td>
                        <td>
                            <span class="@badgeClass">
                                @textoEstado
                            </span>
                        </td>
                        <td>
                            @s.FechaSolicitud.ToString("yyyy-MM-dd")
                        </td>
                        <td class="text-right">
                            <button type="button"
                                    class="btn btn-danger btn-xs btn-eliminar-servicio"
                                    data-id="@s.IdSolicitudServicio"
                                    title="Eliminar">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
