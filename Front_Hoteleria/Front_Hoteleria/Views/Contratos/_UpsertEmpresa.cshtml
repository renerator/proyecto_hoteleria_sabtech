@model Front_Hoteleria.Dto.Contrato.EmpresaContratoDto

<div class="modal-header" style="background:#f5f8fb;">
    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
    <h4 class="modal-title">
        <i class="fa fa-building-o"></i> Registrar Nueva Empresa
    </h4>
</div>

<div class="modal-body">
    <form id="frmEmpresa">
        <input type="hidden" name="IdEmpresa" value="@(Model?.IdEmpresa ?? 0)" />

        <div class="row">
            <div class="col-md-6">
                <label>Nombre de la Empresa *</label>
                <input type="text" name="Nombre" class="form-control"
                       placeholder="Ej: Constructora ABC Ltda."
                       value="@(Model?.Nombre ?? "")" />
            </div>
            <div class="col-md-6">
                <label>RUT *</label>
                <input type="text" name="Rut" class="form-control"
                       placeholder="Ej: 12.345.678-9"
                       value="@(Model?.Rut ?? "")" />
            </div>
        </div>

        <div class="row" style="margin-top:10px;">
            <div class="col-md-6">
                <label>Dirección</label>
                <input type="text" name="Direccion" class="form-control"
                       placeholder="Ej: Av. Principal 123, Santiago"
                       value="@(Model?.Direccion ?? "")" />
            </div>
            <div class="col-md-6">
                <label>Teléfono</label>
                <input type="text" name="Telefono" class="form-control"
                       placeholder="Ej: +56 2 1234 5678"
                       value="@(Model?.Telefono ?? "")" />
            </div>
        </div>

        <div class="row" style="margin-top:10px;">
            <div class="col-md-6">
                <label>Email</label>
                <input type="email" name="Email" class="form-control"
                       placeholder="Ej: contacto@empresa.com"
                       value="@(Model?.Email ?? "")" />
            </div>
            <div class="col-md-6">
                <label>Contacto Principal</label>
                <input type="text" name="ContactoPrincipal" class="form-control"
                       placeholder="Ej: Juan Pérez"
                       value="@(Model?.ContactoPrincipal ?? "")" />
            </div>
        </div>

        <div class="form-group" style="margin-top:10px;">
            <label>Descripción de la Empresa</label>
            <textarea name="Descripcion" class="form-control" rows="3"
                      placeholder="Descripción de la empresa...">@((Model?.Descripcion) ?? "")</textarea>
        </div>
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
    <button type="button" class="btn btn-primary" id="btnGuardarEmpresa">Registrar Empresa</button>
</div>

<script>
    $('#btnGuardarEmpresa').on('click', function () {

        var data = $('#frmEmpresa').serialize();

        $.post('@Url.Action("GuardarEmpresa","Contratos")', data, function (r) {
            if (r && r.ok) {
                if (window.PNotify) {
                    new PNotify({
                        title: 'Empresa',
                        text: 'Empresa registrada correctamente.',
                        type: 'success',
                        styling: 'bootstrap3'
                    });
                }
                $('#modalCon').modal('hide');
            } else {
                if (window.PNotify) {
                    new PNotify({
                        title: 'Empresa',
                        text: r.msg || 'No se pudo guardar.',
                        type: 'error',
                        styling: 'bootstrap3'
                    });
                } else {
                    alert(r.msg || 'No se pudo guardar.');
                }
            }
        });
    });
</script>
