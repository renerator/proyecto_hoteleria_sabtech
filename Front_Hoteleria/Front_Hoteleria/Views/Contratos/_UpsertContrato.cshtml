@model Front_Hoteleria.Dto.Contrato.ContratoDto
@using System.Globalization
@using System.Web.Mvc
@using System.Linq

@{
    bool soloLectura = (ViewBag.SoloLectura as bool?) ?? false;
    bool esEdicion = Model != null && Model.IdContrato > 0;

    var valorContrato = Model?.Valor != null
        ? Model.Valor.Value.ToString("0.##", CultureInfo.InvariantCulture)
        : "";

    Func<int?, string> nombreTipo = (id) =>
    {
        switch (id)
        {
            case 1: return "Temporal";
            case 2: return "Indefinido";
            case 3: return "Por Proyecto";
            case 4: return "Servicio";
            default: return "—";
        }
    };

    var titulo = soloLectura
        ? "Detalle del Contrato"
        : (esEdicion ? "Editar Contrato" : "Crear Nuevo Contrato");
}

<div class="modal-header" style="background:#f5f8fb;">
    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
    <h4 class="modal-title">@titulo</h4>
</div>

<div class="modal-body">
    <form id="frmContrato" method="post" action="@Url.Action("Guardar","Contratos")" autocomplete="off">
        @Html.AntiForgeryToken()
        <input type="hidden" name="IdContrato" value="@(Model?.IdContrato ?? 0)" />

        <!-- Empresa + Nro Contrato -->
        <div class="row">
            <div class="col-md-6">
                <label>Empresa *</label>
                @if (soloLectura)
                {
                    var empItems = (IEnumerable<SelectListItem>)(ViewBag.Empresas ?? Enumerable.Empty<SelectListItem>());
                    var selEmpItem = empItems.FirstOrDefault(x => x.Selected);
                    var hiddenEmp = selEmpItem?.Value ?? (Model?.IdEmpresa > 0 ? Model.IdEmpresa.ToString() : "");
                    var empText = !string.IsNullOrWhiteSpace(Model?.Empresa)
                                      ? (string.IsNullOrWhiteSpace(Model?.RutEmpresa)
                                            ? Model.Empresa
                                            : $"{Model.RutEmpresa}-{Model.Empresa}")
                                      : (empItems.FirstOrDefault(x => x.Value == hiddenEmp)?.Text ?? "—");

                    <input type="text" class="form-control" value="@empText" readonly />
                    <input type="hidden" name="IdEmpresa" value="@hiddenEmp" />
                }
                else
                {
                    var empresas = (IEnumerable<SelectListItem>)(ViewBag.Empresas ?? Enumerable.Empty<SelectListItem>());
                    @Html.DropDownList(
                        "IdEmpresa",
                        empresas,
                        
                        new { @class = "form-control", id = "cmbEmpresas" }
                    )
                }
            </div>
            <div class="col-md-6">
                <label>Número de Contrato *</label>
                <input type="text"
                       name="NumeroContrato"
                       class="form-control"
                       placeholder="Ej: CONT-2025-001"
                       value="@(Model?.NumeroContrato ?? "")"
                       @(soloLectura ? "readonly" : "") />
            </div>
        </div>

        <!-- Fechas -->
        <div class="row" style="margin-top:12px;">
            <div class="col-md-6">
                <label>Fecha de Inicio *</label>
                <input type="date"
                       name="FechaInicio"
                       class="form-control"
                       value="@(Model?.FechaInicio.HasValue == true ? Model.FechaInicio.Value.ToString("yyyy-MM-dd") : "")"
                       @(soloLectura ? "readonly" : "") />
            </div>
            <div class="col-md-6">
                <label>Fecha de Vencimiento *</label>
                <input type="date"
                       name="FechaFin"
                       class="form-control"
                       value="@(Model?.FechaFin.HasValue == true ? Model.FechaFin.Value.ToString("yyyy-MM-dd") : "")"
                       @(soloLectura ? "readonly" : "") />
            </div>
        </div>

        <!-- Tipo contrato + Valor -->
        <div class="row" style="margin-top:12px;">
            <div class="col-md-6">
                <label>Tipo de Contrato *</label>
                @if (soloLectura)
                {
                    <input type="text" class="form-control"
                           value="@nombreTipo(Model?.IdTipoContrato)"
                           readonly />
                }
                else
                {
                    <select name="IdTipoContrato" id="cmbTipos" class="form-control">
                        <option value="">Seleccionar...</option>
                        <option value="1" @(Model?.IdTipoContrato == 1 ? "selected" : "")>Temporal</option>
                        <option value="2" @(Model?.IdTipoContrato == 2 ? "selected" : "")>Indefinido</option>
                        <option value="3" @(Model?.IdTipoContrato == 3 ? "selected" : "")>Por Proyecto</option>
                        <option value="4" @(Model?.IdTipoContrato == 4 ? "selected" : "")>Servicio</option>
                    </select>
                }
            </div>
            <div class="col-md-6">
                <label>Valor del Contrato</label>
                <input type="number"
                       name="Valor"
                       class="form-control"
                       placeholder="Ej: 1500.00"
                       step="0.01"
                       min="0"
                       value="@valorContrato"
                       @(soloLectura ? "readonly" : "") />
            </div>
        </div>

        <!-- Campamento + Máximo + Estado -->
        <div class="row" style="margin-top:12px;">
            <div class="col-md-6">
                <label>Campamento Asignado</label>
                @if (soloLectura)
                {
                    var campItems = (IEnumerable<SelectListItem>)(ViewBag.Campamentos ?? Enumerable.Empty<SelectListItem>());
                    var selCampItem = campItems.FirstOrDefault(x => x.Selected);
                    var hiddenCamp = selCampItem?.Value ?? (Model?.IdCampamento > 0 ? Model.IdCampamento.ToString() : "");
                    var campText = !string.IsNullOrWhiteSpace(Model?.Campamento)
                                      ? Model.Campamento
                                      : (campItems.FirstOrDefault(x => x.Value == hiddenCamp)?.Text ?? "—");

                    <input type="text" class="form-control" value="@campText" readonly />
                    <input type="hidden" name="IdCampamento" value="@hiddenCamp" />
                }
                else
                {
                    var campamentos = (IEnumerable<SelectListItem>)(ViewBag.Campamentos ?? Enumerable.Empty<SelectListItem>());
                    @Html.DropDownListFor(
                        m => m.IdCampamento,
                        campamentos,
                       
                        new { @class = "form-control", id = "cmbCampamentos" }
                    )
                }
            </div>

            <div class="col-md-3">
                <label>Máximo de Trabajadores</label>
                <input type="number"
                       name="MaximoTrabajadores"
                       class="form-control"
                       placeholder="Ej: 50"
                       min="1"
                       value="@(Model?.MaximoTrabajadores ?? 0)"
                       @(soloLectura ? "readonly" : "") />
            </div>

            <div class="col-md-3">
                <label>Estado</label>
                @if (soloLectura)
                {
                    <input type="text" class="form-control"
                           value="@(Model?.Estado == true ? "Activo" : "Inactivo")"
                           readonly />
                }
                else
                {
                    <div class="form-inline" style="display:flex;gap:8px;align-items:center;">
                        <input type="hidden" name="Estado" value="false" />
                        <input type="checkbox"
                               id="chkEstado"
                               name="Estado"
                               value="true"
                               @( (Model == null || !esEdicion) ? "checked" : (Model.Estado ? "checked" : "") ) />
                        <label for="chkEstado" style="margin:0;">Activo</label>
                    </div>
                }
            </div>
        </div>

        <!-- Descripción -->
        <div class="row" style="margin-top:12px;">
            <div class="col-md-12">
                <label>Descripción del Contrato</label>
                <textarea name="Descripcion"
                          class="form-control"
                          rows="3"
                          placeholder="Descripción del contrato..."
                          @(soloLectura ? "readonly" : "")>@(Model?.Descripcion ?? "")</textarea>
            </div>
        </div>

        <div class="text-right" style="margin-top:14px;">
            <button type="button" class="btn btn-default" data-dismiss="modal">@(soloLectura ? "Cerrar" : "Cancelar")</button>
            @if (!soloLectura)
            {
                <button type="submit" class="btn btn-primary" id="btnGuardarContrato">
                    @(esEdicion ? "Guardar Cambios" : "Crear Contrato")
                </button>
            }
        </div>
    </form>
</div>

<script>
    (function () {
        $(document).off('submit', '#frmContrato').on('submit', '#frmContrato', function (e) {
            e.preventDefault();
            var $form = $(this);

            var idEmpresa = $form.find('[name="IdEmpresa"]').val();
            var numero = $form.find('[name="NumeroContrato"]').val();
            var tipoId = $form.find('[name="IdTipoContrato"]').val();
            var ini = $form.find('[name="FechaInicio"]').val();
            var fin = $form.find('[name="FechaFin"]').val();

            if (!idEmpresa) { alert('Debe seleccionar una empresa.'); return; }
            if (!numero) { alert('Debe ingresar el número de contrato.'); return; }
            if (!tipoId) { alert('Debe seleccionar el tipo de contrato.'); return; }
            if (!ini) { alert('Debe seleccionar la fecha de inicio.'); return; }
            if (!fin) { alert('Debe seleccionar la fecha de vencimiento.'); return; }

            $.ajax({
                type: 'POST',
                url: $form.attr('action'),
                data: $form.serialize(),
                success: function (r) {
                    if (r && r.ok) {
                        $('#modalCon').modal('hide');
                        if (typeof cargarTablaCon === 'function') { cargarTablaCon(''); }
                    } else {
                        alert((r && (r.message || r.msg)) || 'No se pudo guardar el contrato');
                    }
                },
                error: function (xhr) {
                    var msg = 'Error al guardar.';
                    try { msg += '\n' + (xhr.responseText || ''); } catch (e) { }
                    alert(msg);
                }
            });
        });
    })();
</script>
