@model Front_Hoteleria.Dto.Contrato.ContratoDto
@{
    // ?soloLectura=true
    var soloLectura = string.Equals(
        (Request["soloLectura"] ?? "").ToString(),
        "true",
        System.StringComparison.OrdinalIgnoreCase
    );

    bool esEdicion = Model != null && Model.IdContrato > 0;
}

<div class="modal-header" style="background:#f5f8fb;">
    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
    <h4 class="modal-title">
        @(esEdicion ? "Editar Contrato" : "Crear Nuevo Contrato")
    </h4>
</div>

<div class="modal-body">
    <form id="frmContrato">
        <input type="hidden" name="IdContrato" value="@(Model?.IdContrato ?? 0)" />

        <!-- fila 1 -->
        <div class="row">
            <div class="col-md-6">
                <label>Empresa *</label>
                @if (soloLectura)
                {
                    <input type="text" class="form-control" value="@(Model?.Empresa ?? "")" readonly />
                }
                else
                {
                    <select name="IdEmpresa" class="form-control">
                        <option value="">Seleccionar empresa...</option>
                        <!-- demo / en vivo llenas desde el controller -->
                        <option value="1" @(Model?.IdEmpresa == 1 ? "selected" : "")>Constructora ABC Ltda.</option>
                        <option value="2" @(Model?.IdEmpresa == 2 ? "selected" : "")>Servicios Mineros XYZ S.A.</option>
                        @* si viene empresa en el modelo y no está en la lista *@
                        @if (Model?.IdEmpresa > 0 && Model?.Empresa != null && Model.IdEmpresa != 1 && Model.IdEmpresa != 2)
                        {
                            <option value="@Model.IdEmpresa" selected="selected">@Model.Empresa</option>
                        }
                    </select>
                }
            </div>
            <div class="col-md-6">
                <label>Número de Contrato *</label>
                <input type="text"
                       name="NumeroContrato"
                       class="form-control"
                       placeholder="Ej: CONT-2024-001"
                       value="@(Model?.NumeroContrato ?? "")"
                       @(soloLectura ? "readonly" : "") />
            </div>
        </div>

        <!-- fila 2 -->
        <div class="row" style="margin-top:12px;">
            <div class="col-md-6">
                <label>Fecha de Inicio *</label>
                <input type="date"
                       name="FechaInicio"
                       class="form-control"
                       value="@(Model?.FechaInicio.HasValue == true ? Model.FechaInicio.Value.ToString("yyyy-MM-dd") : "")"
                       @(soloLectura ? "readonly" : "") />
            </div>
            <div class="col-md-6">
                <label>Fecha de Vencimiento *</label>
                <input type="date"
                       name="FechaFin"
                       class="form-control"
                       value="@(Model?.FechaFin.HasValue == true ? Model.FechaFin.Value.ToString("yyyy-MM-dd") : "")"
                       @(soloLectura ? "readonly" : "") />
            </div>
        </div>

        <!-- fila 3 -->
        <div class="row" style="margin-top:12px;">
            <div class="col-md-6">
                <label>Tipo de Contrato *</label>
                @if (soloLectura)
                {
                    <input type="text" class="form-control" value="@(Model?.Tipo ?? "")" readonly />
                }
                else
                {
                    <select name="Tipo" class="form-control">
                        <option value="">Seleccionar...</option>
                        <option value="temporal" @(Model?.Tipo == "temporal" ? "selected" : "")>Temporal</option>
                        <option value="indefinido" @(Model?.Tipo == "indefinido" ? "selected" : "")>Indefinido</option>
                        <option value="proyecto" @(Model?.Tipo == "proyecto" ? "selected" : "")>Por Proyecto</option>
                        <option value="servicio" @(Model?.Tipo == "servicio" ? "selected" : "")>Servicio</option>
                    </select>
                }
            </div>
            <div class="col-md-6">
                <label>Valor del Contrato</label>
                <input type="number"
                       name="Valor"
                       class="form-control"
                       placeholder="Ej: 150000.00"
                       step="0.01"
                       min="0"
                       value="@(Model?.Valor ?? 0)"
                       @(soloLectura ? "readonly" : "") />
            </div>
        </div>

        <!-- fila 4 -->
        <div class="row" style="margin-top:12px;">
            <div class="col-md-6">
                <label>Campamento Asignado</label>
                @if (soloLectura)
                {
                    <input type="text" class="form-control" value="@(Model?.Campamento ?? "")" readonly />
                }
                else
                {
                    <select name="IdCampamento" class="form-control">
                        <option value="">Seleccionar campamento...</option>
                        <option value="1" @(Model?.IdCampamento == 1 ? "selected" : "")>Campamento Norte</option>
                        <option value="2" @(Model?.IdCampamento == 2 ? "selected" : "")>Campamento Sur</option>
                        @if (Model?.IdCampamento > 0 && Model?.Campamento != null && Model.IdCampamento != 1 && Model.IdCampamento != 2)
                        {
                            <option value="@Model.IdCampamento" selected="selected">@Model.Campamento</option>
                        }
                    </select>
                }
            </div>
            <div class="col-md-6">
                <label>Máximo de Trabajadores</label>
                <input type="number"
                       name="MaximoTrabajadores"
                       class="form-control"
                       placeholder="Ej: 50"
                       min="1"
                       value="@(Model?.MaximoTrabajadores ?? 0)"
                       @(soloLectura ? "readonly" : "") />
            </div>
        </div>

        <!-- fila 5 -->
        <div class="row" style="margin-top:12px;">
            <div class="col-md-12">
                <label>Descripción del Contrato</label>
                <textarea name="Descripcion"
                          class="form-control"
                          rows="3"
                          placeholder="Descripción del contrato..."
                          @(soloLectura ? "readonly" : "")>@(Model?.Descripcion ?? "")</textarea>
            </div>
        </div>
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
    @if (!soloLectura)
    {
        <button type="button" class="btn btn-primary" id="btnGuardarContrato">
            @(esEdicion ? "Guardar Cambios" : "Crear Contrato")
        </button>
    }
</div>

<script>
    $('#btnGuardarContrato').off('click').on('click', function () {
        var datos = $('#frmContrato').serialize();
        $.post('@Url.Action("Guardar","Contratos")', datos, function (r) {
            if (r && r.ok) {
                $('#modalCon').modal('hide');
                // recargar la tabla
                if (typeof cargarTablaCon === 'function') {
                    cargarTablaCon('');
                }
            } else {
                alert(r.msg || 'No se pudo guardar el contrato');
            }
        });
    });
</script>
