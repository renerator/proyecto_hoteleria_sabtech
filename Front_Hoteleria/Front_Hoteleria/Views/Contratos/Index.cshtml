@{
    ViewBag.Title = "Gestión de Contratos | Sabtech Group";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .contract-stats {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: #fff;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .contract-card {
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 15px;
        background: #fff;
        transition: all .2s;
    }

        .contract-card:hover {
            box-shadow: 0 4px 10px rgba(0,0,0,.08);
            transform: translateY(-2px);
        }

    .contract-status {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-active {
        background: #5cb85c;
        color: #fff;
    }

    .status-expired {
        background: #d9534f;
        color: #fff;
    }

    .status-pending {
        background: #f0ad4e;
        color: #fff;
    }

    .status-suspended {
        background: #5bc0de;
        color: #fff;
    }

    .worker-item {
        background: #f8f9fa;
        border-left: 4px solid #3498db;
        padding: 8px 10px;
        margin: 4px 0;
        border-radius: 4px;
    }

    .access-level {
        display: inline-block;
        padding: 2px 6px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: bold;
        margin-left: 4px;
    }

    .level-admin {
        background: #d9534f;
        color: #fff;
    }

    .level-manager {
        background: #f0ad4e;
        color: #fff;
    }

    .level-worker {
        background: #5cb85c;
        color: #fff;
    }

    .level-guest {
        background: #5bc0de;
        color: #fff;
    }
</style>

<div class="right_col" role="main">
    <div class="">
        <div class="page-title">
            <div class="title_left">
                <h3>Gestión de Contratos <small>Control de empresas y accesos</small></h3>
            </div>
            <div class="title_right">
                <div class="col-md-5 col-sm-5 col-xs-12 form-group pull-right top_search">
                    <div class="input-group">
                        <input id="txtBuscarCon" type="text" class="form-control" placeholder="Buscar contrato o empresa...">
                        <span class="input-group-btn">
                            <button id="btnBuscarCon" class="btn btn-default" type="button">Go!</button>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>

        <!-- DASHBOARD -->
        <div id="dashConContainer" class="row">
            <div class="col-md-12">
                <div class="text-muted">Cargando indicadores…</div>
            </div>
        </div>

        <!-- ACCIONES + TABLA -->
        <div class="row">
            <div class="col-md-12">
                <div class="x_panel">
                    <div class="x_content">
                        <div class="row" style="margin-bottom:15px;">
                            <div class="col-md-6">
                                <button type="button" id="btnNuevoCon" class="btn btn-primary">
                                    <i class="fa fa-plus"></i> Nuevo Contrato
                                </button>
                                <button type="button" id="btnNuevaEmpresa" class="btn btn-success">
                                    <i class="fa fa-building-o"></i> Nueva Empresa
                                </button>
                                <button type="button" id="btnAgregarTrabajador" class="btn btn-info">
                                    <i class="fa fa-user"></i> Agregar Trabajador
                                </button>
                            </div>
                           
                            <div class="col-md-6 text-right">
                                <button type="button" id="btnExportarCon" class="btn btn-warning">
                                    <i class="fa fa-file-excel-o"></i> Exportar Reporte
                                </button>
                                <button type="button" id="btnRefreshCon" class="btn btn-default">
                                    <i class="fa fa-refresh"></i> Actualizar
                                </button>
                            </div>
                        </div>

                        <div id="tablaConContainer">
                            <div class="text-muted">Cargando contratos…</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="modalCon" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content"></div>
    </div>
</div>

@section Scripts{
    <script>
        const urlDashCon   = '@Url.Action("Resumen","Contratos")';
        const urlTablaCon  = '@Url.Action("Tabla", "Contratos")';
        const urlUpsertCon = '@Url.Action("Upsert","Contratos")';

        function cargarDashboardCon() {
            $('#dashConContainer').load(urlDashCon);
        }

        function cargarTablaCon(buscar) {
            $('#tablaConContainer').load(urlTablaCon);
        }

        $(function () {
            // búsqueda
            $('#btnBuscarCon').on('click', function () {
                cargarTablaCon($('#txtBuscarCon').val());
            });
            $('#txtBuscarCon').on('keyup', function (e) {
                if (e.key === 'Enter') {
                    cargarTablaCon($(this).val());
                }
            });

            // nuevo/editar
            $('#btnNuevoCon').on('click', function () {
                $.get(urlUpsertCon, function (html) {
                    $('#modalCon .modal-content').html(html);
                    $('#modalCon').modal('show');
                });
            });

            // refrescar
            $('#btnRefreshCon').on('click', function () {
                cargarDashboardCon();
                cargarTablaCon('');
            });

            // NUEVA EMPRESA
            $('#btnNuevaEmpresa').on('click', function () {
                $.get('@Url.Action("NuevaEmpresa", "Contratos")', function (html) {
                    $('#modalCon .modal-content').html(html);
                    $('#modalCon').modal('show');
                });
            });

            // agregar trabajador
            $('#btnAgregarTrabajador').on('click', function () {
                $.get('@Url.Action("NuevoTrabajador","Contratos")', function (html) {
                    $('#modalCon .modal-content').html(html);
                    $('#modalCon').modal('show');
                });
            });

            // exportar dummy
            $('#btnExportarCon').on('click', function () {
                if (window.PNotify) new PNotify({ title:'Exportar', text:'Exportación de contratos (demo).', type:'info' });
            });

            // carga inicial
            cargarDashboardCon();
            cargarTablaCon('');
        });
    </script>
}
