@model IEnumerable<Front_Hoteleria.Dto.Contrato.ContratoDto>

@{
    // Cast correcto del ViewBag con el tipo REAL
    var trabPorEmpresa = ViewBag.TrabajadoresEmpresa
        as Dictionary<int, List<Font_Hoteleria.Dto.Trabajadores.TrabajadoresDto>>
        ?? new Dictionary<int, List<Font_Hoteleria.Dto.Trabajadores.TrabajadoresDto>>();

    // Traductor de tipo de contrato
    Func<int?, string> nombreTipo = (id) =>
    {
        switch (id)
        {
            case 1: return "Temporal";
            case 2: return "Indefinido";
            case 3: return "Por Proyecto";
            case 4: return "Servicio";
            default: return "—";
        }
    };

    // Traductor de nivel de acceso
    Func<int, string> nombreNivel = (n) =>
    {
        switch (n)
        {
            case 4: return "Administrador";
            case 3: return "Supervisor";
            case 2: return "Trabajador";
            case 1:
            default: return "Invitado";
        }
    };
    Func<int, string> cssNivel = (n) =>
    {
        switch (n)
        {
            case 4: return "level-admin";
            case 3: return "level-manager";
            case 2: return "level-worker";
            case 1:
            default: return "level-guest";
        }
    };
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No hay contratos registrados.</div>
}
else
{
    foreach (var c in Model)
    {
        bool activo = c.Estado;
        string estadoTexto = activo ? "Activo" : "Inactivo";
        string css = activo ? "status-active" : "status-suspended";
        string tipoTexto = nombreTipo(c.IdTipoContrato);

        // Buscar trabajadores por Empresa del contrato:
        var idEmp = c.IdEmpresa ?? 0;
        var workers = trabPorEmpresa.ContainsKey(idEmp)
            ? trabPorEmpresa[idEmp]
            : new List<Font_Hoteleria.Dto.Trabajadores.TrabajadoresDto>();

        <div class="contract-card">
            <div class="row">
                <div class="col-md-8">
                    <h4>
                        @(c.NumeroContrato ?? "SIN CÓDIGO")
                        <small>@(c.Empresa ?? "Empresa no informada")</small>
                    </h4>

                    <p>
                        <strong>Empresa:</strong>
                        @c.Empresa
                        @(string.IsNullOrWhiteSpace(c.RutEmpresa) ? "" : $" ({c.RutEmpresa})")
                    </p>

                    <p>
                        <strong>Campamento:</strong>
                        @(string.IsNullOrWhiteSpace(c.Campamento) ? "No asignado" : c.Campamento)
                    </p>

                    <p>
                        <strong>Período:</strong>
                        @((c.FechaInicio.HasValue ? c.FechaInicio.Value.ToString("dd-MM-yyyy") : "—"))
                        al
                        @((c.FechaFin.HasValue ? c.FechaFin.Value.ToString("dd-MM-yyyy") : "—"))
                    </p>

                    <p>
                        <strong>Tipo:</strong> @tipoTexto
                        |
                        <strong>Valor:</strong> @(c.Valor.HasValue ? ("$" + c.Valor.Value.ToString("N0")) : "—")
                    </p>

                    <p>
                        <strong>Trabajadores:</strong>
                        @workers.Count
                        /
                        @(c.MaximoTrabajadores.HasValue ? c.MaximoTrabajadores.Value.ToString() : "Sin límite")
                    </p>
                </div>

                <div class="col-md-4 text-right">
                    <span class="contract-status @css">@estadoTexto</span>
                    <br /><br />
                    <button type="button"
                            class="btn btn-sm btn-info btn-ver-contrato"
                            data-id="@c.IdContrato">
                        <i class="fa fa-eye"></i> Ver
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-warning btn-editar-contrato"
                            data-id="@c.IdContrato">
                        <i class="fa fa-edit"></i> Editar
                    </button>
                </div>
            </div>

            <div class="row" style="margin-top:10px;">
                <div class="col-md-12">
                    <h5>Trabajadores Asociados (@workers.Count):</h5>
                    <div class="row">
                        @if (workers.Any())
                        {
                            foreach (var w in workers)
                            {
                                var nombre = string.Format("{0} {1}",
                                    (w.NombresTrabajador ?? "").Trim(),
                                    (w.PaternoTrabajador ?? "").Trim()).Trim();

                                <div class="col-md-4">
                                    <div class="worker-item">
                                        <strong>@(string.IsNullOrWhiteSpace(nombre) ? "—" : nombre)</strong>
                                        <span class="access-level @(cssNivel(w.NivelAcceso))">
                                            @nombreNivel(w.NivelAcceso)
                                        </span>
                                        <br />
                                        <small>
                                            @(string.IsNullOrWhiteSpace(w.CargoTrabajador) ? "Sin cargo" : w.CargoTrabajador)<br />
                                            RUT: @(string.IsNullOrWhiteSpace(w.RutTrabajador) ? "—" : w.RutTrabajador)<br />
                                            Tel: @(string.IsNullOrWhiteSpace(w.Telefono) ? "—" : w.Telefono)
                                        </small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-md-12">
                                <p class="text-muted">No hay trabajadores asociados a la empresa de este contrato.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

<script>
    // Editar
    $(document)
        .off('click', '.btn-editar-contrato')
        .on('click', '.btn-editar-contrato', function () {
            var id = $(this).data('id');
            $.get('@Url.Action("Upsert","Contratos")', { id: id }, function (html) {
                $('#modalCon .modal-content').html(html);
                $('#modalCon').modal('show');
            });
        });

    // Ver (solo lectura)
    $(document)
        .off('click', '.btn-ver-contrato')
        .on('click', '.btn-ver-contrato', function () {
            var id = $(this).data('id');
            $.get('@Url.Action("Upsert","Contratos")', { id: id, soloLectura: true }, function (html) {
                $('#modalCon .modal-content').html(html);
                $('#modalCon').modal('show');
            });
        });
</script>
