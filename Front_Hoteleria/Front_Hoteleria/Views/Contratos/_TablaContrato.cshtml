@model IEnumerable<Front_Hoteleria.Dto.Contrato.ContratoDto>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No hay contratos registrados.</div>
}
else
{
    foreach (var c in Model)
    {
        // aseguramos string
        var estado = (c.Estado ?? "Activo").ToString().Trim();

        // usamos string.Equals y StartsWith de string
        var css =
            string.Equals(estado, "Activo", System.StringComparison.OrdinalIgnoreCase) ? "status-active" :
            estado.StartsWith("Venc", System.StringComparison.OrdinalIgnoreCase) ? "status-expired" :
            estado.StartsWith("Pend", System.StringComparison.OrdinalIgnoreCase) ? "status-pending" :
            "status-suspended";

        <div class="contract-card">
            <div class="row">
                <div class="col-md-8">
                    <h4>
                        @(c.NumeroContrato ?? "SIN CÓDIGO")
                        <small>@(c.Empresa ?? "Empresa no informada")</small>
                    </h4>
                    <p>
                        <strong>Empresa:</strong> @c.Empresa (@c.RutEmpresa)
                    </p>
                    <p>
                        <strong>Campamento:</strong> @(string.IsNullOrWhiteSpace(c.Campamento) ? "No asignado" : c.Campamento)
                    </p>
                    <p>
                        <strong>Período:</strong>
                        @((c.FechaInicio.HasValue ? c.FechaInicio.Value.ToString("dd-MM-yyyy") : "—"))
                        al
                        @((c.FechaFin.HasValue ? c.FechaFin.Value.ToString("dd-MM-yyyy") : "—"))
                    </p>
                    <p>
                        <strong>Tipo:</strong> @(string.IsNullOrWhiteSpace(c.Tipo) ? "—" : c.Tipo)
                        |
                        <strong>Valor:</strong> @(c.Valor.HasValue ? ("$" + c.Valor.Value.ToString("N0")) : "—")
                    </p>
                    <p>
                        <strong>Trabajadores:</strong>
                        @(c.Trabajadores != null ? c.Trabajadores.Count : 0) /
                        @(c.MaximoTrabajadores.HasValue ? c.MaximoTrabajadores.Value.ToString() : "Sin límite")
                    </p>
                </div>
                <div class="col-md-4 text-right">
                    <span class="contract-status @css">@estado</span>
                    <br /><br />
                    <button type="button"
                            class="btn btn-sm btn-info btn-ver-contrato"
                            data-id="@c.IdContrato">
                        <i class="fa fa-eye"></i> Ver
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-warning btn-editar-contrato"
                            data-id="@c.IdContrato">
                        <i class="fa fa-edit"></i> Editar
                    </button>
                </div>
            </div>
            <div class="row" style="margin-top:10px;">
                <div class="col-md-12">
                    <h5>Trabajadores Asociados (@(c.Trabajadores != null ? c.Trabajadores.Count : 0)):</h5>
                    <div class="row">
                        @if (c.Trabajadores != null && c.Trabajadores.Any())
                        {
                            foreach (var w in c.Trabajadores)
                            {
                                <div class="col-md-4">
                                    <div class="worker-item">
                                        <strong>@w.NombreCompleto</strong><br />
                                        <small>
                                            @w.Cargo
                                            <span class="access-level level-@w.NivelAcceso">@w.NivelAcceso</span><br />
                                            RUT: @w.Rut
                                        </small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-md-12">
                                <p class="text-muted">No hay trabajadores asignados a este contrato.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

<script>
    // botones internos del parcial
    $(document)
        .off('click', '.btn-editar-contrato')
        .on('click', '.btn-editar-contrato', function () {
            var id = $(this).data('id');
            $.get('@Url.Action("Upsert","Contratos")', { id: id }, function (html) {
                $('#modalCon .modal-content').html(html);
                $('#modalCon').modal('show');
            });
        });

    $(document)
        .off('click', '.btn-ver-contrato')
        .on('click', '.btn-ver-contrato', function () {
            var id = $(this).data('id');
            $.get('@Url.Action("Upsert","Contratos")', { id: id, soloLectura: true }, function (html) {
                $('#modalCon .modal-content').html(html);
                $('#modalCon').modal('show');
            });
        });
</script>
