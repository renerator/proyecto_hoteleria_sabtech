@model Front_Hoteleria.Dto.Contrato.ContratoKPIDto

<div class="col-md-12">
    <div class="contract-stats">
        <div class="row">
            <div class="col-md-3 text-center">
                <h3>@(Model?.ContratosActivos ?? 0)</h3>
                <p>Contratos Activos</p>
            </div>
            <div class="col-md-3 text-center">
                <h3>@(Model?.EmpresasRegistradas ?? 0)</h3>
                <p>Empresas Registradas</p>
            </div>
            <div class="col-md-3 text-center">
                <h3>@(Model?.TrabajadoresActivos ?? 0)</h3>
                <p>Trabajadores Activos</p>
            </div>
            <div class="col-md-3 text-center">
                <h3>@(Model?.VencenPronto ?? 0)</h3>
                <p>Vencen Pronto</p>
            </div>
        </div>
    </div>
</div>
