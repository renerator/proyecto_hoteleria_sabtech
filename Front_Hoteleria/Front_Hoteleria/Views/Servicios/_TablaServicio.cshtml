@model IEnumerable<Front_Hoteleria.Model.Servicio.ServicioModel>

<div class="row">
    <!-- Clima -->
    <div class="col-md-4 col-sm-6 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2>Información del tiempo <small>Opcional</small></h2>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <div class="text-muted">Santiago — 27°C — Región Metropolitana</div>
                <hr />
                <div class="row text-center">
                    <div class="col-xs-2">Lun<br /><strong>25°</strong></div>
                    <div class="col-xs-2">Mar<br /><strong>25°</strong></div>
                    <div class="col-xs-2">Mie<br /><strong>27°</strong></div>
                    <div class="col-xs-2">Jue<br /><strong>28°</strong></div>
                    <div class="col-xs-2">Vie<br /><strong>28°</strong></div>
                    <div class="col-xs-2">Sab<br /><strong>26°</strong></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Listado -->
    <div class="col-md-8 col-sm-6 col-xs-12">
        <div class="x_panel fixed_height_320">
            <div class="x_title">
                <h2>Listado de Servicios <small>Revisión</small></h2>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <table id="tablaServicios" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th><i class="fa fa-bed"></i> HABITACIÓN</th>
                            <th><i class="fa fa-cog"></i> SERVICIO</th>
                            <th><i class="fa fa-calendar"></i> FECHA</th>
                            <th><i class="fa fa-clock-o"></i> HORA</th>
                            <th><i class="fa fa-warning"></i> PRIORIDAD</th>
                            <th><i class="fa fa-sliders"></i> OPCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var s in Model)
                            {
                                <tr>
                                    <td>@(s.NumeroHabitacion ?? "0000")</td>
                                    <td><span class="label label-default">@((s.NombreServicio ?? "Servicio"))</span></td>
                                    <td>@(s.Fecha?.ToString("yyyy/MM/dd") ?? "—")</td>
                                    <td>@(s.Hora ?? "—")</td>
                                    <td>
                                        <span class="label @(s.Prioridad == "Alta" ? "label-warning" : (s.Prioridad == "Urgente" ? "label-danger" : "label-success"))">
                                            @(s.Prioridad ?? "Normal")
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn btn-success btn-xs" title="Aprobar"><i class="fa fa-check-square-o"></i></button>
                                        <button class="btn btn-warning btn-xs btn-editar-servicio" data-id="@s.IdServicio" title="Editar"><i class="fa fa-edit"></i></button>
                                        <button class="btn btn-danger  btn-xs btn-eliminar-servicio" data-id="@s.IdServicio" title="Eliminar"><i class="fa fa-trash-o"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <!-- Fila de ejemplo cuando no hay datos -->
                            <tr>
                                <td>0005</td>
                                <td><span class="label label-default">Limpieza</span></td>
                                <td>2025/09/15</td>
                                <td>10:00</td>
                                <td><span class="label label-warning">Alta</span></td>
                                <td>
                                    <button class="btn btn-success btn-xs" title="Aprobar"><i class="fa fa-check-square-o"></i></button>
                                    <button class="btn btn-warning btn-xs" title="Editar"><i class="fa fa-edit"></i></button>
                                    <button class="btn btn-danger  btn-xs" title="Eliminar"><i class="fa fa-trash-o"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
(function(){
    if ($.fn.DataTable) {
        $('#tablaServicios').DataTable({ destroy:true, responsive:true, language:{ url:'//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' }});
    }
})();
</script>
