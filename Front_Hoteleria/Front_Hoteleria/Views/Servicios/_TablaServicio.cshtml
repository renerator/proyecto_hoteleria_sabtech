@model List<Front_Hoteleria.Dto.Servicio.ServicioDto>

<table id="tblServicios" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Servicio</th>
            <th>Categoría</th>
            <th>Prioridad</th>
            <th>Tiempo Est. (min)</th>
            <th>Precio</th>
            <th>Estado</th>
            <th style="width:130px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.IdServicio</td>
                <td>@s.NombreServicio</td>
                <td>@s.IdServiciosCategoria</td>
                <td>@s.IdServicioPrioridad</td>
                <td>@s.TiempoEstimadoMinutos</td>
                <td>$@s.Precio</td>
                <td>@(s.Estado ? "Activo" : "Inactivo")</td>
                <td>
                    <button type="button" class="btn btn-xs btn-primary btn-edit" data-id="@s.IdServicio">
                        <i class="fa fa-edit"></i>
                    </button>
                    <button type="button" class="btn btn-xs btn-danger btn-del" data-id="@s.IdServicio">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section scripts{
    <script>
        $(function () {
            if (!$.fn.DataTable.isDataTable('#tblServicios')) {
                $('#tblServicios').DataTable({
                    responsive: true,
                    pageLength: 25,
                    order: [[0, 'desc']],
                    language: { url: '//cdn.datatables.net/plug-ins/1.13.1/i18n/es-ES.json' }
                });
            }
            // KPIs simples
            var total = $('#tblServicios tbody tr').length;
            var activos = $('#tblServicios tbody tr').filter(function () {
                return $(this).find('td:eq(6)').text().trim() === 'Activo';
            }).length;
            $('#kpiTotal').text(total);
            $('#kpiActivos').text(activos);
            $('#kpiInactivos').text(total - activos);
        });
    </script>
}
