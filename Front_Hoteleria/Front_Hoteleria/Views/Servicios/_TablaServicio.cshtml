@model List<Front_Hoteleria.Dto.Servicio.ServicioDto>

<table id="tblServicios" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Servicio</th>
            <th>Categoría</th>
            <th>Prioridad</th>
            <th>Tiempo Est. (min)</th>
            <th>Precio</th>
            <th>Estado</th>
            <th style="width:130px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.IdServicio</td>
                <td>@s.NombreServicio</td>
                <td>@s.NombreCategoria</td>
                <td>@s.NombrePrioridad</td>
                <td>@s.TiempoEstimadoMinutos</td>
                <td>@String.Format("${0:N2}", @s.Precio)</td>                
                <td>@(s.NombreEstadoServicio</td>
                <td class="text-center">
                    <button class="btn btn-success btn-xs" title="Confirmar" data-id="@s.IdServicio"><i class="fa fa-check"></i></button>
                    <button class="btn btn-info btn-xs" title="Ver Detalle" data-id="@s.IdServicio"><i class="fa fa-eye"></i></button>
                    <button class="btn btn-warning btn-xs" title="Editar" data-id="@s.IdServicio"><i class="fa fa-pencil"></i></button>
                    <button class="btn btn-danger btn-xs" title="Eliminar" data-id="@s.IdServicio"><i class="fa fa-times"></i></button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section scripts{
    <script>
        $(function () {
            if (!$.fn.DataTable.isDataTable('#tblServicios')) {
                $('#tblServicios').DataTable({
                    responsive: true,
                    pageLength: 25,
                    order: [[0, 'desc']],
                    language: { url: '//cdn.datatables.net/plug-ins/1.13.1/i18n/es-ES.json' }
                });
            }
            // KPIs simples
            var total = $('#tblServicios tbody tr').length;
            var activos = $('#tblServicios tbody tr').filter(function () {
                return $(this).find('td:eq(6)').text().trim() === 'Activo';
            }).length;
            $('#kpiTotal').text(total);
            $('#kpiActivos').text(activos);
            $('#kpiInactivos').text(total - activos);
        });
    </script>
}
