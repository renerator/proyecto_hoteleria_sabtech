@model IEnumerable<Front_Hoteleria.Dto.Servicio.ServicioDto>

<table id="tablaHabitaciones" class="table table-striped table-bordered">
    <thead>
        <tr>
            @*<th>Área</th>*@
            @*<th>Ala</th>
            <th>Pasillo</th>*@
            <th>Nro habitación</th>
            <th>Disponible</th>
            <th>Capacidad</th>
            <th style="width:140px">Opciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr><td colspan="7" class="text-muted">Sin datos</td></tr>
        }
        else
        {
            foreach (var h in Model)
            {
                <tr>
                    @*<td>@h.Area</td>*@
                    @*<td>@h.Ala</td>
                    <td>@h.Pasillo</td>*@
                    <td>@h.NombreHabitacion</td>
                    <td>
                        @if (h.VIP)
                        {
                            <i class="green fa fa-check"></i>
                        }
                        else
                        {
                            <i class="red fa fa-close"></i>
                        }
                    </td>
                    <td>@h.Capacidad</td>
                    <td>
                        <button type="button" class="btn btn-primary btn-editar" data-id="@h.IdHabitacion" title="Ver/Editar">
                            <i class="fa fa-search"></i>
                        </button>
                        <button type="button" class="btn btn-warning btn-editar" data-id="@h.IdHabitacion" title="Editar">
                            <i class="fa fa-edit"></i>
                        </button>
                        <button type="button" class="btn btn-danger btn-eliminar" data-id="@h.IdHabitacion" title="Eliminar">
                            <i class="fa fa-trash-o"></i>
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
