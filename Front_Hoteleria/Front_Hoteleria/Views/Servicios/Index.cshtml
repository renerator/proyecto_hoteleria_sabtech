@{
    ViewBag.Title = "Servicios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="right_col" role="main">
    <div class="">
        <div class="page-title">
            <div class="title_left">
                <h3>Gestión de Servicios</h3>
                <p class="text-muted">Administración de solicitudes de servicios</p>
            </div>
        </div>
        <div class="clearfix"></div>

        @Html.Partial("_DashboardServicio")
        @Html.Partial("_PanelesServicio")

        <div id="divTablaServicios">
            @Html.Partial("_TablaServicio", new List<Front_Hoteleria.Dto.Servicio.ServicioDto>())
        </div>

        @Html.Partial("_UpsertServicio")
    </div>
</div>

@section Scripts {
    <script>
        // acá luego enganchas el ajax para /Servicios/Tabla
        function recargarTabla(estado) {
            $.post('@Url.Action("Tabla", "Servicios")',
                {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                    estado: estado
                },
                function (html) {
                    $('#divTablaServicios').html(html);
                });
        }
    </script>
}
