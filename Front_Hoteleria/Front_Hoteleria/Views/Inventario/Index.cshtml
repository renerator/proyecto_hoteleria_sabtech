@{
    ViewBag.Title = "Gestión de Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* fondo general del contenido */
    .right_col {
        background: #f4f6f9;
        min-height: calc(100vh - 70px);
    }

    /* título */
    .page-title .title_left h3 {
        font-size: 28px;
        font-weight: 500;
        color: #365d82;
        margin-top: 5px;
    }

    /* ====== DASHBOARD (lo que devuelve _DashboardInventario) ====== */
    #contenedor-dashboard .inventory-stats {
        background: #2c6da5 !important;
        border-radius: 8px;
        padding: 18px 10px 14px 10px;
        color: #fff;
        margin-bottom: 18px;
        box-shadow: 0 1px 2px rgba(0,0,0,.08);
    }

        #contenedor-dashboard .inventory-stats .stat-number {
            font-size: 30px;
            font-weight: 600;
            display: block;
            line-height: 1;
            margin-bottom: 4px;
        }

        #contenedor-dashboard .inventory-stats .stat-label {
            font-size: 13px;
            opacity: .9;
        }

        #contenedor-dashboard .inventory-stats .col-md-3:not(:last-child) {
            border-right: 1px solid rgba(255,255,255,.25);
        }

    /* ====== PANEL DE LA TABLA ====== */
    #contenedor-tabla .x_panel {
        background: #fff;
        border: 1px solid #e1e8f0;
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(15,23,42,.04);
    }

    #contenedor-tabla .x_title {
        border-bottom: 1px solid #edf1f5;
        padding: 16px 20px 10px 20px;
        margin-bottom: 0;
    }

        #contenedor-tabla .x_title h2 {
            font-size: 18px;
            font-weight: 500;
            color: #365d82;
        }

    #contenedor-tabla .x_content {
        padding: 15px 20px 20px 20px !important;
    }

    /* ====== TABLA ====== */
    #tblInventario {
        background: #fff;
    }

        #tblInventario thead th {
            background: #f4f6f9 !important;
            border-bottom: none !important;
            color: #53657a;
            font-weight: 500;
            vertical-align: middle;
        }

        #tblInventario tbody td {
            vertical-align: middle;
        }

        /* botones de opciones */
        #tblInventario .btn-xs {
            width: 32px;
            height: 28px;
            padding: 3px 0;
            text-align: center;
            border: none;
            color: #fff;
        }

        #tblInventario .btn-info {
            background: #22a6b3;
        }

        #tblInventario .btn-success {
            background: #27ae60;
        }

        #tblInventario .btn-danger {
            background: #e74c3c;
        }

    /* ====== DATATABLES footer (paginación) ====== */
    #contenedor-tabla .dataTables_wrapper .dataTables_paginate .paginate_button {
        border-radius: 4px !important;
        border: 1px solid #d7dfe7 !important;
        margin-left: 3px !important;
    }

    /* input buscar datatable */
    #contenedor-tabla .dataTables_filter input {
        border: 1px solid #d7dfe7;
        border-radius: 4px;
    }
</style>

<div class="right_col" role="main">
    <div class="">
        <div class="page-title">
            <div class="title_left">
                <h3>Gestión de Inventario</h3>
            </div>
            <div class="title_right">
                <div class="col-md-5 col-sm-5 col-xs-12 form-group pull-right top_search">
                    <div class="input-group">
                        <input type="text" id="txtBuscarInventario" class="form-control" placeholder="Buscar artículo...">
                        <span class="input-group-btn">
                            <button class="btn btn-default" type="button" id="btnBuscarInventario">Buscar</button>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>

        <!-- aquí se carga el dashboard (KPIs + acciones + filtros) -->
        <div id="contenedor-dashboard"></div>

        <!-- aquí se carga la tabla -->
        <div id="contenedor-tabla" style="margin-top:20px;"></div>
    </div>
</div>

@section scripts {
    <script>
        // ========================
        // FUNCIONES GLOBALES
        // ========================

        // nuevo / editar
        window.abrirModalInventario = function (id) {
            $.get('@Url.Action("Upsert","Inventario")', { id: id }, function (html) {
                $('#modalInventarioContent').html(html);
                $('#modalInventario').modal('show');
            }).fail(function () {
                alert('No se pudo abrir el formulario de inventario.');
            });
        };

        // ver detalle
        window.verInventario = function (id) {
            $.get('@Url.Action("Ver","Inventario")', { id: id }, function (html) {
                $('#modalInventarioContent').html(html);
                $('#modalInventario').modal('show');
            }).fail(function () {
                alert('No se pudo cargar el detalle.');
            });
        };

        // registrar movimiento
        window.abrirMovimiento = function (idArticulo) {
            $.get('@Url.Action("RegistrarMovimiento","Inventario")', { id: idArticulo }, function (html) {
                $('#modalInventarioContent').html(html);
                $('#modalInventario').modal('show');
            }).fail(function () {
                alert('No se pudo abrir el movimiento.');
            });
        };

        // importar masivo
        window.abrirImportacion = function () {
            $.get('@Url.Action("Importar","Inventario")', function (html) {
                $('#modalInventarioContent').html(html);
                $('#modalInventario').modal('show');
            });
        };

        // ========================
        // INICIAL
        // ========================
        $(function () {
            cargarDashboard();
            cargarTabla();

            // buscador de arriba
            $('#btnBuscarInventario').on('click', function () {
                var criterio = $('#txtBuscarInventario').val();
                cargarTabla({ criterio: criterio });
            });

            // botones que vienen en el dashboard (Agregar Artículo)
            $(document).on('click', '#btnAbrirModalInventario, #inv-btn-add', function () {
                abrirModalInventario(null);
            });

            // importar masivo (botón azul claro)
            $(document).on('click', '#inv-btn-import', function () {
                abrirImportacion();
            });

            // registrar movimiento (botón naranjo)
            $(document).on('click', '#inv-btn-move', function () {
                abrirMovimiento(null);
            });

            // por si la tabla trae un botón con class inv-action-edit y data-id
            $(document).on('click', '.inv-action-edit', function () {
                var id = $(this).data('id');
                abrirModalInventario(id);
            });
        });

        function cargarDashboard() {
            $.get('@Url.Action("Resumen", "Inventario")', function (html) {
                $('#contenedor-dashboard').html(html);
            }).fail(function () {
                $('#contenedor-dashboard').html('<div class="alert alert-danger">No se pudo cargar el dashboard.</div>');
            });
        }

        function cargarTabla(filtros) {
            filtros = filtros || {};
            $.get('@Url.Action("Tabla", "Inventario")', filtros, function (html) {
                $('#contenedor-tabla').html(html);
            }).fail(function () {
                $('#contenedor-tabla').html('<div class="alert alert-danger">No se pudo cargar el inventario.</div>');
            });
        }
    </script>

    <!-- modal global del inventario -->
    <div class="modal fade" id="modalInventario" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" id="modalInventarioContent">
                <!-- aquí se cargan los partials -->
            </div>
        </div>
    </div>
}
