@{
    ViewBag.Title = "Gestión de Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .right_col {
        background: #f4f6f9;
        min-height: calc(100vh - 70px);
    }

    .page-title .title_left h3 {
        font-size: 28px;
        font-weight: 500;
        color: #365d82;
        margin-top: 5px;
    }
</style>

<div class="right_col" role="main">
    <div class="">
        <div class="page-title">
            <div class="title_left">
                <h3>Gestión de Inventario</h3>
            </div>
            <div class="title_right">
                <div class="col-md-5 col-sm-5 col-xs-12 form-group pull-right top_search">
                    <div class="input-group">
                        <input type="text" id="txtBuscarInventario" class="form-control" placeholder="Buscar artículo...">
                        <span class="input-group-btn">
                            <button class="btn btn-default" type="button" id="btnBuscarInventario">Buscar</button>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>

        <!-- dashboard -->
        <div id="contenedor-dashboard"></div>

        <!-- tabla -->
        <div id="contenedor-tabla" style="margin-top:20px;"></div>
    </div>
</div>

@section scripts {
    <script>
        // =========== helpers de apertura ===========
        window.abrirModalInventario = function (id) {
            id = id || 0;
            $.get('@Url.Action("Upsert","Inventario")', { id: id }, function (html) {
                $('#modalInventarioContent').html(html);
                $('#modalInventario').modal('show');
            });
        };

        window.verInventario = function (id) {
            $.get('@Url.Action("Upsert","Inventario")', { id: id, soloLectura: true }, function (html) {
                $('#modalInventarioContent').html(html);
                $('#modalInventario').modal('show');
            });
        };

        window.abrirMovimiento = function (idArticulo) {
            $.get('@Url.Action("RegistrarMovimiento","Inventario")', { id: idArticulo }, function (html) {
                $('#modalInventarioContent').html(html);
                $('#modalInventario').modal('show');
            });
        };

        window.abrirImportacion = function () {
            $.get('@Url.Action("Importar","Inventario")', function (html) {
                $('#modalInventarioContent').html(html);
                $('#modalInventario').modal('show');
            });
        };

        // =========== inicio ===========
        $(function () {
            cargarDashboard();
            cargarTabla();

            // buscador de arriba
            $('#btnBuscarInventario').on('click', function () {
                var criterio = $('#txtBuscarInventario').val();
                cargarTabla({ criterio: criterio });
            });

            // botón "Agregar Artículo" (viene en el dashboard o en la tabla)
            $(document).on('click', '#btnAbrirModalInventario, #inv-btn-add', function () {
                abrirModalInventario(0);
            });

            // botones de la TABLA (ya sin onclick, solo data-id)
            $(document).on('click', '.inv-action-view', function () {
                var id = $(this).data('id');
                if (!id) return;
                verInventario(id);
            });

            $(document).on('click', '.inv-action-edit', function () {
                var id = $(this).data('id');
                if (!id) return;
                abrirModalInventario(id);
            });

            $(document).on('click', '.inv-action-move', function () {
                var id = $(this).data('id');
                abrirMovimiento(id);
            });

            $(document).on('click', '.inv-action-delete', function () {
                var id = $(this).data('id');
                if (!id) return;
                if (!confirm('¿Eliminar este artículo?')) return;

                $.post('@Url.Action("Eliminar","Inventario")', { id: id }, function (r) {
                    if (r && r.ok) {
                        cargarTabla();
                        cargarDashboard();
                    } else {
                        alert(r.msg || 'No se pudo eliminar.');
                    }
                });
            });

            // refrescar
            $(document).on('click', '#inv-btn-refresh', function () {
                cargarDashboard();
                cargarTabla();
            });
        });

        function cargarDashboard() {
            $.get('@Url.Action("Resumen", "Inventario")', function (html) {
                $('#contenedor-dashboard').html(html);
            });
        }

        function cargarTabla(filtros) {
            filtros = filtros || {};
            $.get('@Url.Action("Tabla", "Inventario")', filtros, function (html) {
                $('#contenedor-tabla').html(html);
            });
        }
    </script>

    <!-- modal global -->
    <div class="modal fade" id="modalInventario" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" id="modalInventarioContent"></div>
        </div>
    </div>
}
