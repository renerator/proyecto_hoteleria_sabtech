@model Front_Hoteleria.Dto.Inventario.InventarioItemDto
@{
    Layout = null;
    bool soloLectura = ViewBag.SoloLectura != null && (bool)ViewBag.SoloLectura;
    bool esNuevo = !soloLectura && Model.IdArticulo == 0;
    bool esEditar = !soloLectura && Model.IdArticulo > 0;

    string titulo = soloLectura
        ? "Detalle del Artículo"
        : (esNuevo ? "AGREGAR NUEVO ARTÍCULO AL INVENTARIO" : "EDITAR ARTÍCULO DEL INVENTARIO");
}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h4 class="modal-title">@titulo</h4>
</div>

<div class="modal-body">
    <form id="frmInventario" autocomplete="off">
        @Html.HiddenFor(m => m.IdArticulo)

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Nombre del artículo *</label>
                    @if (soloLectura)
                    {
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", @readonly = "readonly" })
                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", required = "required" })
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Categoría</label>
                    @if (soloLectura)
                    {
                        @Html.TextBoxFor(m => m.Categoria, new { @class = "form-control", @readonly = "readonly" })
                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.Categoria, new { @class = "form-control" })
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Habitación</label>
                    @if (soloLectura)
                    {
                        @Html.TextBoxFor(m => m.Habitacion, new { @class = "form-control", @readonly = "readonly" })
                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.Habitacion, new { @class = "form-control" })
                    }
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>Estado</label>
                    @if (soloLectura)
                    {
                        @Html.TextBoxFor(m => m.Estado, new { @class = "form-control", @readonly = "readonly" })
                    }
                    else
                    {
                        <select name="Estado" class="form-control">
                            <option value="">-- seleccionar --</option>
                            <option value="disponible" @(Model.Estado == "disponible" ? "selected" : "")>Disponible</option>
                            <option value="faltante" @(Model.Estado == "faltante" ? "selected" : "")>Faltante</option>
                            <option value="mantenimiento" @(Model.Estado == "mantenimiento" ? "selected" : "")>Mantenimiento</option>
                            <option value="dañado" @(Model.Estado == "dañado" ? "selected" : "")>Dañado</option>
                        </select>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Valor</label>
                    @if (soloLectura)
                    {
                        @Html.TextBoxFor(m => m.Valor, new { @class = "form-control", @readonly = "readonly" })
                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.Valor, new { @class = "form-control", type = "number", step = "0.01" })
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Marca</label>
                    @if (soloLectura)
                    {
                        @Html.TextBoxFor(m => m.Marca, new { @class = "form-control", @readonly = "readonly" })
                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.Marca, new { @class = "form-control" })
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Modelo</label>
                    @if (soloLectura)
                    {
                        @Html.TextBoxFor(m => m.Modelo, new { @class = "form-control", @readonly = "readonly" })
                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.Modelo, new { @class = "form-control" })
                    }
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>N° de Serie</label>
            @if (soloLectura)
            {
                @Html.TextBoxFor(m => m.Serie, new { @class = "form-control", @readonly = "readonly" })
            }
            else
            {
                @Html.TextBoxFor(m => m.Serie, new { @class = "form-control" })
            }
        </div>

        <div class="form-group">
            <label>Observaciones</label>
            @if (soloLectura)
            {
                @Html.TextAreaFor(m => m.Observaciones, 3, 50, new { @class = "form-control", @readonly = "readonly" })
            }
            else
            {
                @Html.TextAreaFor(m => m.Observaciones, 3, 50, new { @class = "form-control" })
            }
        </div>
    </form>
</div>

@if (!soloLectura)
{
    <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary" id="btnGuardarInventario">Guardar</button>
    </div>

    <script>
        $('#btnGuardarInventario').off('click').on('click', function () {
            $.post('@Url.Action("Guardar", "Inventario")',
                $('#frmInventario').serialize(),
                function (r) {
                    if (r && r.ok) {
                        // cerrar modal
                        $('#modalInventario').modal('hide');

                        // recargar tabla
                        $.get('@Url.Action("Tabla", "Inventario")', function (html) {
                            $('#contenedor-tabla').html(html);
                        });

                        // recargar dashboard
                        $.get('@Url.Action("Resumen", "Inventario")', function (html) {
                            $('#contenedor-dashboard').html(html);
                        });
                    } else {
                        alert(r.msg || 'No se pudo guardar el artículo.');
                    }
                }
            ).fail(function () {
                alert('Error al guardar el artículo.');
            });
        });
    </script>
}
