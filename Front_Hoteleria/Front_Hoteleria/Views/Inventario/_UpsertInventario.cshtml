@model Front_Hoteleria.Dto.Inventario.InventarioItemDto
@{
    Layout = null;
    // helper para comparar string sin que reviente si viene null
    Func<string, string, bool> isSel = (val, current) =>
        !string.IsNullOrWhiteSpace(val) && string.Equals(val, current, StringComparison.OrdinalIgnoreCase);
}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h4 class="modal-title">Editar Artículo de Inventario</h4>
</div>

<div class="modal-body">
    <form id="frmInventarioEdit" autocomplete="off">
        @Html.HiddenFor(m => m.Id)

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Nombre del Artículo *</label>
                    @Html.TextBoxFor(m => m.Nombre,
                        new { @class = "form-control", placeholder = "Ej: Sábanas Blancas King Size", required = "required" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Categoría *</label>
                    <select name="Categoria" class="form-control" required>
                        <option value="">Seleccionar categoría...</option>
                        <option value="ropa_cama" @(isSel("ropa_cama", Model.Categoria) ? "selected" : "")>Ropa de Cama</option>
                        <option value="electrodomesticos" @(isSel("electrodomesticos", Model.Categoria) ? "selected" : "")>Electrodomésticos</option>
                        <option value="muebles" @(isSel("muebles", Model.Categoria) ? "selected" : "")>Muebles</option>
                        <option value="decoracion" @(isSel("decoracion", Model.Categoria) ? "selected" : "")>Decoración</option>
                        <option value="tecnologia" @(isSel("tecnologia", Model.Categoria) ? "selected" : "")>Tecnología</option>
                        <option value="limpieza" @(isSel("limpieza", Model.Categoria) ? "selected" : "")>Limpieza</option>
                        <option value="otros" @(isSel("otros", Model.Categoria) ? "selected" : "")>Otros</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Habitación *</label>
                    <select name="Habitacion" class="form-control" required>
                        <option value="">Seleccionar habitación...</option>
                        @for (int i = 1; i <= 20; i++)
                        {
                            var room = i.ToString("D4");
                            <option value="@room" @(isSel(room, Model.Habitacion) ? "selected" : "")>@room</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Estado *</label>
                    <select name="Estado" class="form-control" required>
                        <option value="">Seleccionar estado...</option>
                        <option value="disponible" @(isSel("disponible", Model.Estado) ? "selected" : "")>Disponible</option>
                        <option value="faltante" @(isSel("faltante", Model.Estado) ? "selected" : "")>Faltante</option>
                        <option value="mantenimiento" @(isSel("mantenimiento", Model.Estado) ? "selected" : "")>Mantenimiento</option>
                        <option value="dañado" @(isSel("dañado", Model.Estado) ? "selected" : "")>Dañado</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Valor ($) *</label>
                    <input type="number"
                           name="Valor"
                           class="form-control"
                           step="0.01"
                           min="0"
                           value="@(Model.Valor.HasValue ? Model.Valor.Value.ToString("0.##") : "0")"
                           required />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Marca</label>
                    @Html.TextBoxFor(m => m.Marca,
                        new { @class = "form-control", placeholder = "Samsung, LG, etc." })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Modelo</label>
                    @Html.TextBoxFor(m => m.Modelo, new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Número de Serie</label>
                    @Html.TextBoxFor(m => m.Serie, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>Descripción Detallada</label>
            @Html.TextAreaFor(m => m.Descripcion, 3, 50,
                new { @class = "form-control", placeholder = "Descripción detallada del artículo, características, estado, etc." })
        </div>
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
    <button type="button" class="btn btn-warning" id="btnLimpiarInventarioEdit">Limpiar</button>
    <button type="button" class="btn btn-success" id="btnActualizarInventario">Actualizar Artículo</button>
</div>

<script>
    // limpiar
    $('#btnLimpiarInventarioEdit').off('click').on('click', function () {
        $('#frmInventarioEdit')[0].reset();
    });

    // actualizar (dejamos el endpoint como si ya existiera)
    $('#btnActualizarInventario').off('click').on('click', function () {
        var form = $('#frmInventarioEdit');
        $.ajax({
            url: '@Url.Action("Actualizar", "Inventario")',   // <-- asumimos que existe
            type: 'POST',
            data: form.serialize(),
            success: function (r) {
                if (r.ok) {
                    $('#modalInventario').modal('hide');
                    // recargar tabla
                    $.get('@Url.Action("Tabla","Inventario")', function (html) {
                        $('#contenedor-tabla').html(html);
                    });
                } else {
                    alert(r.msg || 'No se pudo actualizar el artículo.');
                }
            },
            error: function () {
                alert('Error al actualizar el artículo.');
            }
        });
    });
</script>
