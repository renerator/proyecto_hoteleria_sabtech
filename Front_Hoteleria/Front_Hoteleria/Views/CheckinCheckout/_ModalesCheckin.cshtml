<!-- Modal Check-in -->
<div class="modal fade" id="checkinModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background: #2ecc71; color: white;">
                <button type="button" class="close" data-dismiss="modal" style="color: white;"><span>&times;</span></button>
                <h4 class="modal-title"><i class="fa fa-sign-in"></i> Check-in</h4>
            </div>
            <div class="modal-body">
                <p><strong>Reserva:</strong> <span id="ciReservaId"></span></p>
                <p><strong>Huésped:</strong> <span id="ciHuesped"></span></p>
                <p><strong>Habitación:</strong> <span id="ciHabitacion"></span></p>
                <p><strong>Fecha Entrada:</strong> <span id="ciFechaEntrada"></span></p>
                <p><strong>Fecha Salida:</strong> <span id="ciFechaSalida"></span></p>
                <hr>
                <div class="form-group">
                    <label>Hora de Check-in</label>
                    <input type="time" class="form-control" id="ciHora" required>
                </div>
                <div class="form-group">
                    <label>Observaciones</label>
                    <textarea class="form-control" id="ciObservaciones" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" onclick="confirmarCheckin()">
                    <i class="fa fa-check"></i> Confirmar Check-in
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Check-out -->
<div class="modal fade" id="checkoutModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background: #3498db; color: white;">
                <button type="button" class="close" data-dismiss="modal" style="color: white;"><span>&times;</span></button>
                <h4 class="modal-title"><i class="fa fa-sign-out"></i> Check-out</h4>
            </div>
            <div class="modal-body">
                <p><strong>Reserva:</strong> <span id="coReservaId"></span></p>
                <p><strong>Huésped:</strong> <span id="coHuesped"></span></p>
                <p><strong>Habitación:</strong> <span id="coHabitacion"></span></p>
                <p><strong>Check-in:</strong> <span id="coCheckin"></span></p>
                <p><strong>Check-out programado:</strong> <span id="coFechaSalida"></span></p>
                <hr>
                <div class="form-group">
                    <label>Hora de Check-out</label>
                    <input type="time" class="form-control" id="coHora" required>
                </div>
                <div class="form-group">
                    <label>Observaciones</label>
                    <textarea class="form-control" id="coObservaciones" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="confirmarCheckout()">
                    <i class="fa fa-check"></i> Confirmar Check-out
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal No Show -->
<div class="modal fade" id="noshowModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background: #e74c3c; color: white;">
                <button type="button" class="close" data-dismiss="modal" style="color: white;"><span>&times;</span></button>
                <h4 class="modal-title"><i class="fa fa-user-times"></i> Registrar No Show</h4>
            </div>
            <div class="modal-body">
                <p><strong>Reserva:</strong> <span id="nsReservaId"></span></p>
                <p><strong>Huésped:</strong> <span id="nsHuesped"></span></p>
                <p><strong>Habitación:</strong> <span id="nsHabitacion"></span></p>
                <hr>
                <div class="form-group">
                    <label>Motivo / Observaciones</label>
                    <textarea class="form-control" id="nsObservaciones" rows="3"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="confirmarNoShow()">
                    <i class="fa fa-times"></i> Confirmar No Show
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Extender -->
<div class="modal fade" id="extenderModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background: #f39c12; color: white;">
                <button type="button" class="close" data-dismiss="modal" style="color: white;"><span>&times;</span></button>
                <h4 class="modal-title"><i class="fa fa-calendar-plus-o"></i> Extender Estadía</h4>
            </div>
            <div class="modal-body">
                <p><strong>Reserva:</strong> <span id="extReservaId"></span></p>
                <p><strong>Huésped:</strong> <span id="extHuesped"></span></p>
                <p><strong>Habitación:</strong> <span id="extHabitacion"></span></p>
                <p><strong>Fecha Salida Original:</strong> <span id="extFechaSalidaOriginal"></span></p>
                <hr>
                <div class="form-group">
                    <label>Nueva Fecha de Salida</label>
                    <input type="date" class="form-control" id="extNuevaFecha" />
                </div>
                <div class="form-group">
                    <label>Motivo de Extensión</label>
                    <textarea class="form-control" id="extMotivo" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-warning" onclick="confirmarExtension()">
                    <i class="fa fa-check"></i> Confirmar Extensión
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // stub: puedes reemplazar con llamadas AJAX reales a los actions Checkin/Checkout/NoShow/Extender
    function abrirCheckin(id) {
        $('#ciReservaId').text(id);
        $('#checkinModal').modal('show');
    }
</script>
