@model IEnumerable<Front_Hoteleria.Dto.SolicitudServicio.SolicitudServicioDto>

@{
    var data = Model ?? Enumerable.Empty<Front_Hoteleria.Dto.SolicitudServicio.SolicitudServicioDto>();
}

@Html.AntiForgeryToken()

<style>
    /* Ajustes generales de la tabla para que se vea como la maqueta */
    #servicesTable {
        background: #fff;
    }

        #servicesTable thead th {
            background: #f9fafb;
            font-weight: 600;
            vertical-align: middle;
        }

        #servicesTable tbody td {
            vertical-align: middle;
        }

            /* ID solicitud en negrita como la maqueta */
            #servicesTable tbody td.col-id {
                font-weight: 700;
            }

    /* Estado: pills por tipo */
    .badge-estado {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
        color: #fff;
    }

        .badge-estado i {
            margin-right: 4px;
        }

    .badge-estado-pendiente {
        background: #f0ad4e;
    }

    .badge-estado-asignada {
        background: #5bc0de;
    }

    .badge-estado-rechazada {
        background: #d9534f;
    }

    .badge-estado-realizada {
        background: #5cb85c;
    }

    /* Columna acciones centrada y con botones pequeños */
    #servicesTable th.col-acciones,
    #servicesTable td.col-acciones {
        text-align: center;
        white-space: nowrap;
        width: 160px;
    }

        #servicesTable td.col-acciones .btn {
            margin: 0 1px;
        }

            #servicesTable td.col-acciones .btn i {
                margin: 0;
            }
</style>

<div class="x_panel">
    <div class="x_title">
        <h2 id="tituloListado">
            <i class="fa fa-list"></i> Listado de Servicios Pendientes
        </h2>
        <div class="clearfix"></div>
    </div>

    <div class="x_content">
        <div class="table-responsive">
            <table id="servicesTable" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>ID Solicitud</th>
                        <th>Fecha/Hora</th>
                        <th class="col-servicio">Tipo Servicio</th>
                        <th>Habitación</th>
                        <th>Solicitante</th>
                        <th>Personal Asignado</th>
                        <th>Estado</th>
                        <th class="col-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (data.Any())
                    {
                        foreach (var s in data)
                        {
                            var codigo = $"SOL-{s.IdSolicitud:000}";

                            var fechaTexto = s.FechaSolicitud.HasValue
                                ? s.FechaSolicitud.Value.ToString("dd/MM/yyyy HH:mm")
                                : "";

                            var tipoServicio = s.TipoServicio;
                            var habitacion = !string.IsNullOrWhiteSpace(s.NombreHabitacion)
                                ? s.NombreHabitacion
                                : s.IdHabitacion.ToString();

                            var solicitante = s.NombreSolicitante;
                            var personalAsig = string.IsNullOrWhiteSpace(s.PersonalAsignado)
                                ? "Sin asignar"
                                : s.PersonalAsignado;

                            var estado = (s.EstadoSolicitud ?? "").Trim();
                            var cssEstado = "badge-estado badge-estado-pendiente";
                            switch (estado)
                            {
                                case "Asignada":
                                    cssEstado = "badge-estado badge-estado-asignada";
                                    break;
                                case "Rechazada":
                                    cssEstado = "badge-estado badge-estado-rechazada";
                                    break;
                                case "Realizada":
                                    cssEstado = "badge-estado badge-estado-realizada";
                                    break;
                                case "Pendiente":
                                default:
                                    cssEstado = "badge-estado badge-estado-pendiente";
                                    break;
                            }

                            <tr>
                                <td>@codigo</td>
                                <td>@fechaTexto</td>
                                <td>@tipoServicio</td>
                                <td>@habitacion</td>
                                <td>@solicitante</td>
                                <td>@personalAsig</td>
                                <td>
                                    <span class="@cssEstado">
                                        <i class="fa fa-clock-o"></i> @estado
                                    </span>
                                </td>
                                <td class="col-acciones">
                                    <!-- VER -->
                                    <button type="button"
                                            class="btn btn-info btn-xs"
                                            title="Ver"
                                            onclick="verSolicitud(@s.IdSolicitud)">
                                        <i class="fa fa-eye"></i>
                                    </button>

                                    <!-- EDITAR -->
                                    <button type="button"
                                            class="btn btn-warning btn-xs"
                                            title="Editar"
                                            onclick="editarSolicitud(@s.IdSolicitud)">
                                        <i class="fa fa-pencil"></i>
                                    </button>

                                    <!-- NOTIFICAR PERSONAL -->
                                    <button type="button"
                                            class="btn btn-success btn-xs"
                                            title="Notificar Personal"
                                            onclick="notificarPersonal(@s.IdSolicitud)">
                                        <i class="fa fa-user"></i>
                                    </button>

                                    <!-- ELIMINAR -->
                                    <button type="button"
                                            class="btn btn-danger btn-xs"
                                            title="Eliminar"
                                            onclick="eliminarSolicitud(@s.IdSolicitud)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted">
                                No hay solicitudes para los filtros seleccionados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    $(function () {
        $('#servicesTable').DataTable({
            destroy: true,
            pageLength: 10,
            language: {
                url: '//cdn.datatables.net/plug-ins/1.10.24/i18n/Spanish.json'
            }
        });
    });
</script>
