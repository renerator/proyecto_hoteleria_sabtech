@model Front_Hoteleria.Dto.SolicitudServicio.SolicitudServicioDto
@using System.Web.Mvc

@{
    Layout = null;

    var esEdicion = Model != null && Model.IdSolicitud > 0;
    var titulo = esEdicion ? "Editar Solicitud de Servicio" : "Nueva Solicitud de Servicio";

    var empresas = ViewBag.Empresas as List<SelectListItem> ?? new List<SelectListItem>();
    var servicios = ViewBag.Servicios as List<SelectListItem> ?? new List<SelectListItem>();
    var habitaciones = ViewBag.Habitaciones as List<SelectListItem> ?? new List<SelectListItem>();
}

<div id="modalSolicitudServicio" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header" style="background:#2a3f54;color:#fff;">
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                <h4 class="modal-title">
                    <i class="fa fa-plus"></i> @titulo
                </h4>
            </div>

            @using (Html.BeginForm("Crear", "SolicitudServicio", FormMethod.Post,
                     new { id = "frmSolicitudServicio", @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdSolicitud)

                <div class="modal-body">

                    <!-- FILA 1: Servicio / Habitación -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Servicio <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(m => m.IdServicio,
                                      servicios,
                                      "Seleccione...",
                                      new { @class = "form-control", id = "IdServicio", required = "required" })
                                @Html.ValidationMessageFor(m => m.IdServicio, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Habitación <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(m => m.IdHabitacion,
                                      habitaciones,
                                      "Seleccione...",
                                      new { @class = "form-control", id = "IdHabitacion", required = "required" })
                                @Html.ValidationMessageFor(m => m.IdHabitacion, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <!-- FILA 2: Rut / Nombre / Empresa -->
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>RUT Solicitante <span class="text-danger">*</span></label>
                                <input type="text"
                                       id="RutSolicitante"
                                       name="RutSolicitante"
                                       class="form-control"
                                       value="@(Model != null ? Model.RutSolicitante : "")"
                                       placeholder="11.111.111-1"
                                       required />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Solicitante <span class="text-danger">*</span></label>
                                <input type="text"
                                       id="NombreSolicitante"
                                       name="NombreSolicitante"
                                       class="form-control"
                                       value="@(Model != null ? Model.NombreSolicitante : "")"
                                       placeholder="Nombre del solicitante"
                                       required />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Empresa</label>
                                @Html.DropDownListFor(m => m.idEmpresa,
                                      empresas,
                                      "Seleccione...",
                                      new { @class = "form-control", id = "idEmpresa" })
                            </div>
                        </div>
                    </div>

                    <!-- DESCRIPCIÓN -->
                    <div class="form-group">
                        <label>Descripción <span class="text-danger">*</span></label>
                        <textarea id="Descripcion"
                                  name="Descripcion"
                                  rows="3"
                                  class="form-control"
                                  placeholder="Detalles de la solicitud"
                                  required>@(Model != null ? Model.Descripcion : "")</textarea>
                    </div>

                    <!-- PRIORIDAD -->
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Prioridad</label>
                                <select id="IdPrioridad" name="IdPrioridad" class="form-control">
                                    <option value="">-- Seleccione --</option>
                                    <option value="1" @(Model != null && Model.idPrioridad == 1 ? "selected" : "")>Normal</option>
                                    <option value="2" @(Model != null && Model.idPrioridad == 2 ? "selected" : "")>Alta</option>
                                    <option value="3" @(Model != null && Model.idPrioridad == 3 ? "selected" : "")>Baja</option>
                                </select>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fa fa-save"></i> Guardar
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function validarRutChile(rut) {
        if (!rut) return false;

        rut = rut.replace(/\./g, '').replace(/-/g, '').toUpperCase();
        if (rut.length < 2) return false;

        var cuerpo = rut.slice(0, -1);
        var dv = rut.slice(-1);

        if (!/^\d+$/.test(cuerpo)) return false;

        var suma = 0;
        var multiplo = 2;

        for (var i = cuerpo.length - 1; i >= 0; i--) {
            suma += parseInt(cuerpo.charAt(i), 10) * multiplo;
            multiplo = (multiplo === 7) ? 2 : multiplo + 1;
        }

        var resto = 11 - (suma % 11);
        var dvEsperado = (resto === 11) ? '0' : (resto === 10 ? 'K' : resto.toString());

        return dvEsperado === dv;
    }

    $(function () {
        $('#frmSolicitudServicio').off('submit').on('submit', function (e) {
            e.preventDefault();

            // Si quieres volver a validar el RUT, descomenta esto:
            /*
            var rut = $('#RutSolicitante').val();
            if (!validarRutChile(rut)) {
                alert('El RUT del solicitante no es válido.');
                $('#RutSolicitante').addClass('input-validation-error').focus();
                return;
            }
            */

            var $form = $(this);
            var id = parseInt($('#IdSolicitud').val() || '0', 10);
            var url = id > 0
                ? '@Url.Action("Modificar", "SolicitudServicio")'
                : '@Url.Action("Crear", "SolicitudServicio")';

            $.ajax({
                url: url,
                type: 'POST',
                data: $form.serialize(),
                success: function (resp) {
                    if (resp && resp.ok) {
                        $('#modalSolicitudServicio').modal('hide');
                        if (typeof recargarTabla === 'function') {
                            recargarTabla();
                        }
                    } else {
                        alert(resp && resp.message
                            ? resp.message
                            : 'No se pudo guardar la solicitud.');
                    }
                },
                error: function (xhr) {
                    alert('Error al guardar la solicitud (' + xhr.status + ').');
                }
            });
        });
    });
</script>
