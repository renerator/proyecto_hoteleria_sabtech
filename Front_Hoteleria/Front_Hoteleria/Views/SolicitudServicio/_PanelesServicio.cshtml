@{
    Layout = null;
}
<style>
    .btn-notificar-personal {
        background-color: #55c6e9; /* ajusta el celeste si quieres */
        border-color: #55c6e9;
        color: #fff;
        border-radius: 3px;
        padding: 4px 12px;
    }

        .btn-notificar-personal i {
            margin-right: 4px;
        }
</style>

<div class="row">
    <div class="col-md-12">
        <div class="x_panel">
            <div class="x_title">
                <h2><i class="fa fa-filter"></i> Filtros de búsqueda</h2>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <div class="row">
                    <div class="col-md-3">
                        <label>Fecha inicio</label>
                        <input type="date" id="fechaInicio" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label>Fecha fin</label>
                        <input type="date" id="fechaFin" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label>Estado</label>
                        <select id="filtroEstado"
                                class="form-control"
                                onchange="recargarTabla($('#filtroEstado').val());">
                            <!-- valores típicos: 1=Pendiente, 2=Asignada, 3=Rechazada, 4=Realizada, 0=Todos -->
                            <option value="1" selected>Pendiente</option>
                            <option value="2">Asignada</option>
                            <option value="3">Rechazada</option>
                            <option value="4">Realizada</option>
                            <option value="0">Todos</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label>&nbsp;</label>
                        <button class="btn btn-primary btn-block"
                                onclick="recargarTabla($('#filtroEstado').val());">
                            <i class="fa fa-search"></i> Buscar
                        </button>
                    </div>
                </div>

                <hr />

                <button class="btn btn-success" onclick="nuevoServicio();">
                    <i class="fa fa-plus"></i> Crear Nueva Solicitud
                </button>

                <button class="btn btn-info btn-notificar-personal" onclick="nuevoServicio();">
                    <i class="fa fa-bell"></i> Notificar Personal
                </button>
            </div>
        </div>
    </div>
</div>
