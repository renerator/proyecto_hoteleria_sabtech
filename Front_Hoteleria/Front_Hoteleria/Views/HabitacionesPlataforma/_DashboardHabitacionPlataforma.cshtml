
@Model dynamic
<div class="row tile_count">
    <div class="col-md-2 col-sm-4 col-xs-6 tile_stats_count">
        <span class="count_top"><i class="fa fa-bed"></i> Habitaciones Habilitadas</span>
        <div class="count">@(Model?.HabitacionesHabilitadas ?? 0)</div>
    </div>
    <div class="col-md-2 col-sm-4 col-xs-6 tile_stats_count">
        <span class="count_top"><i class="fa fa-wrench"></i> En Mantención</span>
        <div class="count">@(Model?.HabitacionesMantencion ?? 0)</div>
    </div>
    <div class="col-md-2 col-sm-4 col-xs-6 tile_stats_count">
        <span class="count_top"><i class="fa fa-user"></i> Ocupadas</span>
        <div class="count">@(Model?.HabitacionesOcupadas ?? 0)</div>
    </div>
    <div class="col-md-3 col-sm-4 col-xs-6 tile_stats_count">
        <span class="count_top"><i class="fa fa-bell"></i> Servicios solicitados</span>
        <div class="count">@(Model?.ServiciosSolicitados ?? 0)</div>
        @if (Model?.ServiciosVarPorcentaje != null)
        {
            <span class="count_bottom">
                <i class="green"><i class="fa fa-sort-asc"></i>@Model.ServiciosVarPorcentaje% </i> vs. periodo anterior
            </span>
        }
    </div>
    <div class="col-md-3 col-sm-4 col-xs-6 tile_stats_count">
        <span class="count_top"><i class="fa fa-broom"></i> Aseo en curso</span>
        <div class="count">@(Model?.AseoEnCurso ?? 0)</div>
    </div>
</div>

