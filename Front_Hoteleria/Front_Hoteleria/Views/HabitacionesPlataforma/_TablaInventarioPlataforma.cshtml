@@model IEnumerable<Front_Hoteleria.ViewModels.InventarioFilaVm>

    <table id="tablaInventario" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Habitación</th>
                <th>Material</th>
                <th>Stock mínimo</th>
                <th>Bodega</th>
                <th style="width:120px">Opciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var it in Model)
                {
                    <tr>
                        <td>@it.IdHabitacionInsumo</td>
                        <td>@it.IdHabitacion</td>
                        <td><span class="label label-info">@it.NombreInsumo</span></td>
                        <td>@it.StockMinimo</td>
                        <td>@it.IdBodega</td>
                        <td>
                            <button class="btn btn-primary btn-xs" title="Ver" data-id="@it.IdHabitacionInsumo"><i class="fa fa-eye"></i></button>
                            <button class="btn btn-success btn-xs" title="Editar" data-id="@it.IdHabitacionInsumo"><i class="fa fa-pencil"></i></button>
                            <button class="btn btn-warning btn-xs btn-inv-eliminar" title="Eliminar" data-id="@it.IdHabitacionInsumo"><i class="fa fa-trash"></i></button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
