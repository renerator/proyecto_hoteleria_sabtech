<style>
    .sp-panels-row {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 20px;
    }
    .sp-panel-box {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #e6e9ed;
        padding: 15px 15px 5px 15px;
    }
    .sp-panel-title {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        color: #2f3c4d;
    }
    .sp-panel-title i {
        color: #f5a623;
    }
    .sp-panel-table {
        width: 100%;
        border-collapse: collapse;
    }
    .sp-panel-table th,
    .sp-panel-table td {
        padding: 8px 5px;
        font-size: 13px;
    }
    .sp-panel-table tbody tr {
        border-bottom: 1px solid #f0f0f0;
    }
    .sp-state-pill {
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        color: #fff;
    }
    .sp-state-ok { background: #27ae60; }
    .sp-state-progress { background: #f5a623; }
    .sp-state-assign { background: #95a5a6; }
    .sp-btn-check {
        background: #16a085;
        border: none;
        color: #fff;
        border-radius: 4px;
        width: 30px;
        height: 26px;
        display: grid;
        place-items: center;
    }
    @@media(max-width: 1000px){
        .sp-panels-row{grid-template-columns: 1fr;}
    }
</style>

<div class="sp-panels-row">
    <div class="sp-panel-box">
        <div class="sp-panel-title">
            <i class="fa fa-cogs"></i> Servicios Activos
        </div>
        <table class="sp-panel-table" id="tblServiciosActivos">
            <thead>
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Servicio</th>
                    <th style="width: 120px;">Estado</th>
                    <th>Ubicación</th>
                    <th style="width: 45px;">Acción</th>
                </tr>
            </thead>
            <tbody>
                <!-- estos los podés llenar por ajax -->
                <tr>
                    <td>SRV001</td>
                    <td>Limpieza Habitación</td>
                    <td><span class="sp-state-pill sp-state-ok">Completado</span></td>
                    <td>Habitación 101</td>
                    <td><button class="sp-btn-check"><i class="fa fa-check"></i></button></td>
                </tr>
                <tr>
                    <td>SRV002</td>
                    <td>Reposición Amenities</td>
                    <td><span class="sp-state-pill sp-state-progress">En Progreso</span></td>
                    <td>Habitación 205</td>
                    <td><button class="sp-btn-check"><i class="fa fa-check"></i></button></td>
                </tr>
                <tr>
                    <td>SRV003</td>
                    <td>Reparación Aire Acondicionado</td>
                    <td><span class="sp-state-pill sp-state-assign">Asignado</span></td>
                    <td>Habitación 305</td>
                    <td><button class="sp-btn-check"><i class="fa fa-check"></i></button></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="sp-panel-box">
        <div class="sp-panel-title">
            <i class="fa fa-calendar"></i> Próximas Solicitudes
        </div>
        <table class="sp-panel-table" id="tblProximasSolicitudes">
            <thead>
                <tr>
                    <th style="width:110px;">Fecha</th>
                    <th>Solicitud</th>
                    <th style="width:70px;">Hora</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>2024-01-17</td>
                    <td>Limpieza Profunda</td>
                    <td>09:00</td>
                </tr>
                <tr>
                    <td>2024-01-18</td>
                    <td>Reposición Completa</td>
                    <td>14:00</td>
                </tr>
                <tr>
                    <td>2024-01-19</td>
                    <td>Reparación Urgente</td>
                    <td>08:00</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
