@model IEnumerable<Front_Hoteleria.Dto.ServiciosPersonal.ServiciosPersonalDto>

<style>
    .sp-table-wrapper {
        background: #fff;
        border: 1px solid #e6e9ed;
        border-radius: 0 0 8px 8px;
    }
    .sp-filters {
        display: grid;
        grid-template-columns: 200px 200px 200px 1fr 80px;
        gap: 15px;
        padding: 20px 20px 0 20px;
    }
    .sp-filters label {
        font-weight: 600;
        font-size: 12px;
        margin-bottom: 5px;
        color: #4a5568;
    }
    .sp-input, .sp-select {
        width: 100%;
        padding: 6px 10px;
        border: 1px solid #d7dce3;
        border-radius: 4px;
        font-size: 13px;
    }
    .sp-btn-refresh {
        background: #f5a623;
        border: none;
        color: #fff;
        border-radius: 4px;
        height: 34px;
        width: 100%;
        cursor: pointer;
    }
    .sp-table-title {
        font-weight: 600;
        font-size: 16px;
        padding: 20px 20px 10px 20px;
        color: #2f3c4d;
    }
    table.sp-table {
        width: 100%;
        border-spacing: 0;
        border-collapse: collapse;
        margin-top: 15px;
    }
    .sp-table thead {
        background: #2f3c4d;
        color: #fff;
    }
    .sp-table th, .sp-table td {
        padding: 10px 15px;
        font-size: 13px;
    }
    .sp-table th:first-child,
    .sp-table td:first-child {
        position: relative;
    }
    /* filas por prioridad */
    .sp-row-high {
        background: #fff1f1;
        border-left: 4px solid #e74c3c;
    }
    .sp-row-medium {
        background: #fff8e6;
        border-left: 4px solid #f5a623;
    }
    .sp-row-low {
        background: #edf9f2;
        border-left: 4px solid #26af60;
    }
    .sp-badge-prio {
        display: inline-block;
        background: #757575;
        color: #fff;
        padding: 3px 10px;
        border-radius: 16px;
        font-size: 11px;
        font-weight: 600;
    }
    .sp-status {
        padding: 4px 12px;
        border-radius: 4px;
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        display: inline-block;
    }
    .sp-status-pendiente { background: #f5a623; }
    .sp-status-urgente   { background: #e74c3c; }
    .sp-status-progreso  { background: #3498db; }
    .sp-assign {
        color: #007bff;
        font-weight: 600;
    }
    .sp-btn-action {
        background: #167ac6;
        color: #fff;
        border: none;
        border-radius: 4px;
        padding: 4px 10px;
        font-size: 12px;
        cursor: pointer;
    }
    .sp-btn-start {
        background: #2ecc71;
    }
    @@media(max-width: 1100px){
        .sp-filters{grid-template-columns: 1fr 1fr;}
    }
</style>

<div class="sp-table-wrapper">
    <div class="sp-table-title">Solicitudes Pendientes</div>

    <div class="sp-filters">
        <div>
            <label>Ordenar por:</label>
            <select class="sp-select" id="ordenarPor">
                <option value="fecha-asc">Fecha (Más reciente primero)</option>
                <option value="fecha-desc">Fecha (Más antigua primero)</option>
                <option value="prioridad-desc">Prioridad (Alta a Baja)</option>
                <option value="prioridad-asc">Prioridad (Baja a Alta)</option>
            </select>
        </div>
        <div>
            <label>Filtrar por Prioridad:</label>
            <select class="sp-select" id="filtrarPrioridad">
                <option value="todas">Todas las prioridades</option>
                <option value="alta">Alta</option>
                <option value="media">Media</option>
                <option value="baja">Baja</option>
            </select>
        </div>
        <div>
            <label>Filtrar por Estado:</label>
            <select class="sp-select" id="filtrarEstado">
                <option value="todos">Todos los estados</option>
                <option value="pendiente">Pendiente</option>
                <option value="urgente">Urgente</option>
                <option value="en-progreso">En Progreso</option>
            </select>
        </div>
        <div>
            <label>Buscar ubicación:</label>
            <input type="text" class="sp-input" id="buscarUbicacion" placeholder="Ej: Habitación 205" />
        </div>
        <div style="align-self: flex-end;">
            <button class="sp-btn-refresh" type="button" id="btnRefrescar">
                <i class="fa fa-refresh"></i>
            </button>
        </div>
    </div>

    <div style="padding: 15px 20px 20px 20px;">
        <table class="sp-table" id="tablaSolicitudesPersonal">
            <thead>
                <tr>
                    <th style="width:80px;">ID</th>
                    <th>Tipo de Solicitud</th>
                    <th>Ubicación</th>
                    <th style="width:100px;">Prioridad</th>
                    <th style="width:120px;">Estado</th>
                    <th style="width:120px;">Fecha</th>
                    <th style="width:150px;">Asignado a</th>
                    <th style="width:90px;">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        // mapeo rápido
                        var prio = (item.Prioridad ?? "").ToLower();
                        var cls = prio == "alta" ? "sp-row-high"
                                 : prio == "media" ? "sp-row-medium"
                                 : "sp-row-low";

                        var estado = (item.Estado ?? "").ToLower();
                        var estadoCls = estado == "pendiente" ? "sp-status-pendiente"
                                      : estado == "urgente" ? "sp-status-urgente"
                                      : "sp-status-progreso";

                        var asignado = string.IsNullOrWhiteSpace(item.Descripcion) ? "Sin asignar" : item.Descripcion;
                        // en este dto, uso Descripcion como "asignado a" si no tenés campo; cambia si tu API ya lo manda
                        <tr class="@cls">
                            <td>@item.Id</td>
                            <td>@item.Tipo</td>
                            <td>@item.Ubicacion</td>
                            <td><span class="sp-badge-prio">@(string.IsNullOrEmpty(item.Prioridad) ? "—" : item.Prioridad)</span></td>
                            <td><span class="sp-status @estadoCls">@(string.IsNullOrEmpty(item.Estado) ? "Pendiente" : item.Estado)</span></td>
                            <td>@(item.Fecha.HasValue ? item.Fecha.Value.ToString("yyyy-MM-dd") : "")</td>
                            <td>@asignado</td>
                            <td>
                                @if (asignado == "Sin asignar")
                                {
                                    <button class="sp-btn-action"><i class="fa fa-user-plus"></i> Asignar</button>
                                }
                                else
                                {
                                    <button class="sp-btn-action sp-btn-start"><i class="fa fa-play"></i> Iniciar</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
