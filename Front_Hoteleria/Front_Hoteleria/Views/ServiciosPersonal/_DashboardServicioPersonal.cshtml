@model Front_Hoteleria.Dto.ServiciosPersonal.ServiciosPersonalKpiDto

@{
    // si el controller, por lo que sea, mandó null, acá lo arreglamos
    var kpi = Model ?? new Front_Hoteleria.Dto.ServiciosPersonal.ServiciosPersonalKpiDto();
}

<style>
    .sp-topbar {
        margin-bottom: 20px;
    }

    .sp-title {
        font-size: 26px;
        font-weight: 600;
        color: #304156;
    }

    .sp-subtitle {
        color: #97a0af;
        margin-top: 3px;
    }

    .sp-kpi-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .sp-kpi-card {
        background: #fff;
        border-radius: 8px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        flex: 1 1 220px;
        box-shadow: 0 2px 6px rgba(0,0,0,.04);
        border-left: 4px solid #f39c12;
    }

    .sp-kpi-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #f39c12;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 20px;
        margin-right: 15px;
    }

    .sp-kpi-text small {
        display: block;
        color: #8f9bb3;
        font-size: 13px;
        margin-bottom: 3px;
    }

    .sp-kpi-number {
        font-size: 28px;
        font-weight: 700;
        color: #243b53;
    }
</style>

<div class="sp-topbar">
   
    <div class="sp-subtitle">Visualice rápidamente las solicitudes del día.</div>
</div>

<div class="sp-kpi-row">
    <div class="sp-kpi-card">
        <div class="sp-kpi-icon"><i class="fa fa-exclamation-triangle"></i></div>
        <div class="sp-kpi-text">
            <small>Solicitudes Urgentes</small>
            <div class="sp-kpi-number">@((kpi.SolicitudesUrgentes))</div>
        </div>
    </div>
    <div class="sp-kpi-card">
        <div class="sp-kpi-icon"><i class="fa fa-cogs"></i></div>
        <div class="sp-kpi-text">
            <small>Servicios Activos</small>
            <div class="sp-kpi-number">@((kpi.ServiciosActivos))</div>
        </div>
    </div>
    <div class="sp-kpi-card">
        <div class="sp-kpi-icon"><i class="fa fa-check"></i></div>
        <div class="sp-kpi-text">
            <small>Servicios Completados</small>
            <div class="sp-kpi-number">@((kpi.ServiciosCompletados))</div>
        </div>
    </div>
    <div class="sp-kpi-card">
        <div class="sp-kpi-icon"><i class="fa fa-plus"></i></div>
        <div class="sp-kpi-text">
            <small>Solicitudes Nuevas</small>
            <div class="sp-kpi-number">@((kpi.SolicitudesNuevas))</div>
        </div>
    </div>
</div>
