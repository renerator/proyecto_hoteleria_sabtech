@model Front_Hoteleria.Dto.Servicio.ServicioDto

<div class="modal-header" style="background:#244769;color:#fff;border-top-left-radius:4px;border-top-right-radius:4px;">
    <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color:#fff;opacity:1;">
        <span aria-hidden="true">&times;</span>
    </button>
    <h4 class="modal-title">Detalles del Servicio</h4>
</div>

<div class="modal-body" style="background:#f5f5f5;">
    <div class="row" style="margin-bottom:15px;">
        <div class="col-md-6">
            <h5><i class="fa fa-info-circle"></i> Información Básica</h5>
            <table class="table table-bordered" style="background:#fff;">
                <tr>
                    <th style="width:140px;">ID:</th>
                    <td>@Model.IdServicio</td>
                </tr>
                <tr>
                    <th>Nombre:</th>
                    <td>@Model.NombreServicio</td>
                </tr>
                <tr>
                    <th>Categoría:</th>
                    <td>@Model.NombreCategoria</td>
                </tr>
                <tr>
                    <th>Prioridad:</th>
                    <td>@Model.NombrePrioridad</td>
                </tr>
                <tr>
                    <th>Tiempo Est.:</th>
                    <td>@(Model.TiempoEstimadoMinutos) min</td>
                </tr>
                <tr>
                    <th>Precio:</th>
                    <td>$ @(Model.Precio ?? 0)</td>
                </tr>
            </table>
        </div>

        <div class="col-md-6">
            <h5><i class="fa fa-cog"></i> Información Operacional</h5>
            <table class="table table-bordered" style="background:#fff;">
                <tr>
                    <th style="width:160px;">Estado:</th>
                    <td>
                        @if ((Model.NombreEstadoServicio ?? "").Trim().Equals("Activo", StringComparison.OrdinalIgnoreCase))
                        {
                            <span style="color:#27ae60;font-weight:600;"><i class="fa fa-check"></i> Activo</span>
                        }
                        else
                        {
                            <span style="color:#e67e22;font-weight:600;"><i class="fa fa-wrench"></i> @Model.NombreEstadoServicio</span>
                        }
                    </td>
                </tr>
                <tr>
                    <th>Personal:</th>
                    <!--<td>@Model..PersonalAsignado</td>--> @* si no existe en tu dto, puedes dejar vacío *@
                </tr>
                <tr>
                    <th>Creado:</th>
                    @*<td>@Model..FechaCreacion?.ToString("dd-MM-yyyy")</td>*@
                </tr>
                <tr>
                    <th>Última Modificación:</th>
                    @*<td>@Model.FechaModificacion?.ToString("dd-MM-yyyy")</td>*@
                </tr>
                <tr>
                    <th>Veces Solicitado:</th>
                    @*<td>@Model.CantSolicitado</td>*@
                </tr>
                <tr>
                    <th>Tiempo Promedio:</th>
                    <td>@Model.TiempoEstimadoMinutos</td>
                </tr>
            </table>
        </div>
    </div>

    <h5><i class="fa fa-align-left"></i> Descripción</h5>
    <div class="well" style="background:#fff;">
        @(string.IsNullOrWhiteSpace(Model.NombreServicio) ? "Sin descripción." : Model.NombreServicio)
    </div>

    <h5><i class="fa fa-list-ul"></i> Protocolo de Atención</h5>
    <div class="well" style="background:#fff;">
        @*@(string.IsNullOrWhiteSpace(Model.Protocolo) ? "Sin protocolo definido." : Model.Protocolo)*@
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
    <button type="button" class="btn btn-success" id="btnDetalleEditar" data-id="@Model.IdServicio">
        Editar Servicio
    </button>
    <button type="button" class="btn btn-warning" id="btnDetalleConfig" data-id="@Model.IdServicio">
        Configurar
    </button>
</div>

<script>
    // desde este modal podemos saltar al de edición reutilizando tu endpoint de Modificar
    $('#btnDetalleEditar').on('click', function () {
        var id = $(this).data('id');
        $.get('@Url.Action("Modificar","ServiciosDisponibles")', { id: id }, function (html) {
            $('#modalUpsert .modal-content').html(html);
        });
    });

    // si tienes un modal de config de servicios, puedes abrirlo acá también
    $('#btnDetalleConfig').on('click', function () {
        $.get('@Url.Action("ConfigurarServicios","ServiciosDisponibles")', function (html) {
            $('#modalUpsert .modal-content').html(html);
        });
    });
</script>

