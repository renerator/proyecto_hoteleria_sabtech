@model Front_Hoteleria.Dto.Servicio.ServicioDto

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h4 class="modal-title">@((Model?.IdServicio ?? 0) == 0 ? "Agregar Servicio" : "Editar Servicio")</h4>
</div>
<div class="modal-body">
    @using (Html.BeginForm("UpsertServicio", "ServiciosDisponibles", FormMethod.Post, new { id = "frmUpsertServicio", @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IdServicio)

        <div class="form-group">
            @Html.LabelFor(m => m.NombreServicio, new { @class = "col-sm-3 control-label" })
            <div class="col-sm-9">
                @Html.TextBoxFor(m => m.NombreServicio, new { @class = "form-control", required = "required" })
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">Categoría (id)</label>
            <div class="col-sm-9">
                @Html.TextBoxFor(m => m.IdServiciosCategoria, new { @class = "form-control", type = "number", min = "1" })
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">Prioridad (id)</label>
            <div class="col-sm-9">
                @Html.TextBoxFor(m => m.IdServicioPrioridad, new { @class = "form-control", type = "number", min = "1" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Tiempo Estimado (min)", new { @class = "col-sm-3 control-label" })
            <div class="col-sm-9">
                @Html.TextBoxFor(m => m.TiempoEstimadoMinutos, new { @class = "form-control", type = "number", min = "1", required = "required" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Precio ($)", new { @class = "col-sm-3 control-label" })
            <div class="col-sm-9">
                @Html.TextBoxFor(m => m.Precio, new { @class = "form-control", type = "number", min = "0", step = "1", required = "required" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Estado, new { @class = "col-sm-3 control-label" })
            <div class="col-sm-9">
                @Html.DropDownListFor(m => m.Estado,
                    new SelectList(new[]{
                        new { v=true,  t="Activo" },
                        new { v=false, t="Inactivo"}
                    }, "v", "t", Model?.Estado ?? true),
                    new { @class = "form-control" })
            </div>
        </div>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
    <button type="button" class="btn btn-primary" id="btnGuardarServicio">
        <i class="fa fa-check"></i> Guardar
    </button>
</div>

@section scripts{
    <script>
        $(function () {
            $('#btnGuardarServicio').on('click', function () {
                var $f = $('#frmUpsertServicio');
                $.ajax({
                    url: $f.attr('action'),
                    type: 'POST',
                    data: $f.serialize(),
                    success: function (r) {
                        if (r.ok) {
                            $('#modalUpsert').modal('hide');
                            $('#frmFiltroServicios').submit();
                        } else {
                            alert(r.message || 'No se pudo guardar.');
                        }
                    },
                    error: function () { alert('Error al guardar.'); }
                });
            });
        });
    </script>
}
