@model IEnumerable<Front_Hoteleria.Dto.Servicio.ServicioDto>

<table id="servicesTable" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th class="col-servicio">Servicio</th>
            <th>Categoría</th>
            <th>Prioridad</th>
            <th class="col-tiempo">Tiempo Est. (min)</th>
            <th>Precio</th>
            <th>Estado</th>
            <th style="width:90px;">Opciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in (Model ?? Enumerable.Empty<Front_Hoteleria.Dto.Servicio.ServicioDto>()))
        {
            // ====== resolver clases de categoría ======
            var catClass = "cat-default";
            switch ((s.NombreCategoria ?? "").Trim())
            {
                case "Emergencias": catClass = "cat-emergencias"; break;
                case "Business": catClass = "cat-business"; break;
                case "Spa & Bienestar": catClass = "cat-spa"; break;
                case "Concierge": catClass = "cat-concierge"; break;
                case "Mantenimiento": catClass = "cat-mant"; break;
                case "Limpieza": catClass = "cat-limpieza"; break;
            }

            // ====== resolver clases de prioridad ======
            var prioClass = "prio-media";
            switch ((s.NombrePrioridad ?? "").Trim())
            {
                case "Urgente": prioClass = "prio-urgente"; break;
                case "Alta": prioClass = "prio-alta"; break;
                case "Media": prioClass = "prio-media"; break;
                case "Baja": prioClass = "prio-baja"; break;
            }

            // ====== resolver estado ======
            var esActivo = (s.NombreEstadoServicio ?? "").Trim()
                .Equals("Activo", StringComparison.OrdinalIgnoreCase);

            <tr>
                <td>@s.IdServicio</td>
                <td>@s.NombreServicio</td>
                <td><span class="pill @catClass">@s.NombreCategoria</span></td>
                <td><span class="pill @prioClass">@s.NombrePrioridad</span></td>
                <td>@s.TiempoEstimadoMinutos</td>
                <td>@string.Format("${0:N2}", s.Precio ?? 0)</td>
                <td>
                    @if (esActivo)
                    {
                        <span class="estado-activo"><i class="fa fa-check"></i> Activo</span>
                    }
                    else
                    {
                        <span class="estado-inactivo"><i class="fa fa-times"></i> @s.NombreEstadoServicio</span>
                    }
                </td>
                <td class="text-center options-cell">
                    <button type="button" class="tbl-btn tbl-view" data-id="@s.IdServicio" title="Ver">
                        <i class="fa fa-eye"></i>
                    </button>
                    <button type="button" class="tbl-btn tbl-edit" data-id="@s.IdServicio" title="Editar">
                        <i class="fa fa-pencil"></i>
                    </button>
                    <button type="button" class="tbl-btn tbl-config" data-id="@s.IdServicio" title="Configurar">
                        <i class="fa fa-cogs"></i>
                    </button>
                    <button type="button" class="tbl-btn tbl-del" data-id="@s.IdServicio" title="Eliminar">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>

            </tr>
        }
    </tbody>
</table>
