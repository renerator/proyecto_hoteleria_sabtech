@model IEnumerable<Front_Hoteleria.Dto.Servicio.ServicioDto>

<table id="servicesTable" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Servicio</th>
            <th>Categoría (id)</th>
            <th>Prioridad (id)</th>
            <th>Tiempo Est. (min)</th>
            <th>Precio</th>
            <th>Estado</th>
            <th style="width:90px;">Opciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in (Model ?? Enumerable.Empty<Front_Hoteleria.Dto.Servicio.ServicioDto>()))
        {
            <tr>
                <td>@s.IdServicio</td>
                <td>@s.NombreServicio</td>
                <td>@s.IdServiciosCategoria</td>
                <td>@s.IdServicioPrioridad</td>
                <td>@s.TiempoEstimadoMinutos</td>
                <td>@s.Precio</td>
                <td>@(s.Estado ? "Activo" : "Inactivo")</td>
                <td class="text-center">
                    <button type="button" class="btn btn-success btn-xs btn-edit" data-id="@s.IdServicio" title="Editar">
                        <i class="fa fa-edit"></i>
                    </button>
                    <button type="button" class="btn btn-danger btn-xs btn-del" data-id="@s.IdServicio" title="Eliminar">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
