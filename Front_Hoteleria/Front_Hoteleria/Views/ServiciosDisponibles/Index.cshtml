@{
    ViewBag.Title = "Gestión de Reservas | Sabtech Group";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="right_col" role="main">
    <div class="x_panel">
        <div class="x_title">
            <h2>Gestión de Servicios Disponibles</h2>
            <div class="clearfix"></div>
        </div>

        <div class="x_content">
            <div id="panelesContainer">
                @Html.Action("Paneles", "Servicios")
            </div>

            <hr />

            <form id="frmFiltroServicios" class="form-inline" method="post" action="@Url.Action("Tabla","ServiciosDisponibles")">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="estado">Estado:&nbsp;</label>
                    <select class="form-control" id="estado" name="estado">
                        <option value="">Todos</option>
                        <option value="1">Activos</option>
                        <option value="0">Inactivos</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary"><i class="fa fa-filter"></i> Filtrar</button>
                <button type="button" id="btnNuevo" class="btn btn-success pull-right">
                    <i class="fa fa-plus"></i> Nuevo Servicio
                </button>
            </form>

            <div id="tablaContainer" style="margin-top:15px;">
                @Html.Partial("_TablaServicioDisponibles", new List<Front_Hoteleria.Dto.Servicio.ServicioDto>())
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
$(function(){
    function cargarTabla(){
        var $f = $('#frmFiltroServicios');
        $.ajax({
            url: $f.attr('action'),
            type: 'POST',
            data: $f.serialize(),
            success: function(html){ $('#tablaContainer').html(html); },
            error: function(){ alert('No se pudo cargar la tabla.'); }
        });
    }
    $('#frmFiltroServicios').on('submit', function(e){ e.preventDefault(); cargarTabla(); });
    cargarTabla();

    $('#btnNuevo').on('click', function(){
        $.get('@Url.Action("Upsert","ServiciosDisponibles")', function(html){
            $('#modalUpsert .modal-content').html(html);
            $('#modalUpsert').modal('show');
        });
    });

    $(document).on('click', '.btn-edit', function(){
        var id = $(this).data('id');
        $.get('@Url.Action("Upsert","ServiciosDisponibles")', { id: id }, function(html){
            $('#modalUpsert .modal-content').html(html);
            $('#modalUpsert').modal('show');
        });
    });

    $(document).on('click', '.btn-del', function(){
        if(!confirm('¿Eliminar servicio?')) return;
        var id = $(this).data('id');
        $.post('@Url.Action("Eliminar","ServiciosDisponibles")',
               { idServicio: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
               function(r){
                   if(r.ok){ cargarTabla(); } else { alert(r.message || 'Error'); }
               });
    });
});
    </script>

    <!-- Modal genérico para crear/editar -->
    <div class="modal fade" id="modalUpsert" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content"></div>
        </div>
    </div>
}
